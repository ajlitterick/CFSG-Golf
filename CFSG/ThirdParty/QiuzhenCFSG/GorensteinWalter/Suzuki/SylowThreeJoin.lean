/-!
# The index-seven core of the Suzuki recognition step

Suzuki §8 finishes the first case by constructing a subgroup of index seven
in the simple group `G` of order `2520`; the mechanical tail
(index seven forces `G ≃ A₇`) lives in `Suzuki/IndexSevenToA7.lean`.  This
module owns the missing core:

* the numerical shell around it: the Sylow 3-subgroup normalizer has index
  `70`, and a simple group of order `2520` has no subgroups of index `2` or
  `5`;
* the pinned recognition core `firstCase_exists_indexSeven_subgroup`.

## Route `R5-sylow2-normalizer-join`

In the `A₇` model the index-seven subgroup is the point stabilizer `A₆`; it
is generated by a Sylow 3-subgroup `P` containing `U` together with a Sylow
2-subgroup `S'` of `G` that contains the Sylow 2-subgroup `T₂` of
`N_G(P)`:

```text
P = ⟨(1 2 3), (4 5 6)⟩,  T₂ = Sylow₂(N_A₇(P)) = C₄,
S' = the unique Sylow₂ A₇ with T₂ ≤ S',
⟨P, S'⟩ = A₆,  |⟨P, S'⟩| = 360,  [A₇ : ⟨P, S'⟩] = 7
```

The join contains `N_G(P) = ⟨P, T₂⟩` (order 36), so `[G : H]` divides
`[G : N_G(P)] = 70`.  Since `n₃(H) = [H : N_G(P)] ≡ 1 [MOD 3]`, the order of
`H` is not `72` or `504` (`R5-B`, landed), and the shell below excludes the
index-`2`/`5` cases; the remaining route is to exclude `H = G` (`R5-A`).

## Dead routes (GAP-verified in the model, do not revisit)

* Joining with the *setup* Sylow 2 `S = c.S`: `S ≤ Ĥ = N_G(U)` (in fact
  `S ∩ C_G(U) = O₂(Ĥ)` is the Klein four), and `⟨P, S⟩ = Ĥ` has order 72 —
  not an index-seven subgroup.  This invalidated the earlier `R4` route:
  its gap `|⟨P, S⟩| ≠ 72` is false in the model.
* `⟨N_G(V), N_G(W)⟩ = A₇` for the two `U`-conjugates `V, W ≤ P` (order
  `2520`, not `360`);
* `⟨N_G(P), Q⟩ = G` for any Sylow 3-subgroup `Q ≠ P` sharing a conjugate of
  `U` with `P`;
* `⟨N_G(P), C_G(W)⟩ = G`, `⟨N_G(P), Ĥ⟩ = G`, `⟨N_G(P), S₀⟩ = G` for the
  setup `S₀`, and `⟨N_G(P), z⟩ = N_G(P)` for `z` of order two in the Sylow
  2-subgroup of `N_G(P)`.

The viable construction is the join with a Sylow 2-subgroup containing
`Sylow₂(N_G(P))` (Suzuki's §8 `S'`, characterized there by `S' ∩ C_G(U) = 1`).

Modified for CFSG: `firstCase_exists_indexSeven_subgroup` and its step `join_h_ne_top` are
removed. The step's proof was `sorry` upstream and nothing here uses either.
-/

noncomputable section

namespace CFSG.GorensteinWalter

universe u


private lemma isKleinFour_of_mulEquiv {G H : Type*} [Group G] [Group H]
    [Finite G] [Finite H] (e : G ≃* H) (hH : IsKleinFour H) : IsKleinFour G := by
  refine { card_four := ?_, exponent_two := ?_ }
  · rw [Nat.card_congr e.toEquiv]
    exact hH.card_four
  · rw [Monoid.exponent_eq_of_mulEquiv e]
    exact hH.exponent_two


/-- In the first case, the normalizer of a Sylow 3-subgroup has index `70`
(the number of Sylow 3-subgroups). -/
public theorem firstCase_sylow3_normalizer_index
    {G : Type u} [Group G] [Finite G]
    (hmin : IsMinimalCounterexample G)
    (c : CentralizerSetup G) (hfirst : FirstCase c) (d : FirstCaseCountData c)
    (P : Sylow 3 G) :
    (Subgroup.normalizer (P : Set G)).index = 70 := by
  classical
  let : Fact (Nat.Prime 3) := ⟨Nat.prime_three⟩
  exact P.card_eq_index_normalizer.symm.trans (firstCase_sylow3_count hmin c hfirst d)


/-- The normalizer of a Sylow 3-subgroup has order `36 = [G : N_G(P)]⁻¹ · |G|`. -/
public theorem firstCase_normalizer_sylow3_card
    {G : Type u} [Group G] [Finite G]
    (hmin : IsMinimalCounterexample G)
    (c : CentralizerSetup G) (hfirst : FirstCase c) (d : FirstCaseCountData c)
    (P : Sylow 3 G) :
    Nat.card ↥(Subgroup.normalizer (P : Set G)) = 36 := by
  classical
  have hind := firstCase_sylow3_normalizer_index hmin c hfirst d P
  have hm := (Subgroup.normalizer (P : Set G)).index_mul_card
  rw [hind, (firstCase_index_card_of_countData c d).2] at hm
  norm_num at hm
  have hm' : 70 * Nat.card ↥(Subgroup.normalizer (P : Set G)) = 70 * 36 := by
    rw [hm]
  exact Nat.eq_of_mul_eq_mul_left (by norm_num : 0 < 70) hm'


/-- The Sylow 2-subgroup of `N_G(P)` meets `Ĥ` in a subgroup of order two
(`|N_G(P) ∩ Ĥ| = 18` has a trivial 2-part beyond the involution, and a
trivial intersection would embed `T₂` into the quotient of order two). -/
public theorem firstCase_normalizer_sylow3_sylow2_inter_hhat_card_two
    {G : Type u} [Group G] [Finite G]
    (hmin : IsMinimalCounterexample G)
    (c : CentralizerSetup G) (hfirst : FirstCase c) (d : FirstCaseCountData c)
    (P : Sylow 3 G) (hPU : c.U ≤ (P : Subgroup G)) :
    let NP : Subgroup G := Subgroup.normalizer (P : Set G)
    ∀ T2 : Sylow 2 (↥NP),
      Nat.card ↥(((T2 : Subgroup (↥NP)).map NP.subtype) ⊓ c.Hhat) = 2 := by
  classical
  intro NP T2
  let : Fact (Nat.Prime 2) := ⟨Nat.prime_two⟩
  let Tg : Subgroup G := (T2 : Subgroup (↥NP)).map NP.subtype
  have hTgN : Tg ≤ NP := by
    intro x hx
    rcases Subgroup.mem_map.mp hx with ⟨y, hy, rfl⟩
    exact y.2
  have hTg4 : Nat.card Tg = 4 := by
    have hfac : (36 : ℕ).factorization 2 = 2 := by
      rw [show (36 : ℕ) = 2 ^ 2 * 9 by norm_num]
      rw [Nat.factorization_mul (by norm_num) (by norm_num)]
      rw [Nat.factorization_pow]
      simp [Nat.prime_two.factorization_self]
      exact Nat.factorization_eq_zero_of_not_dvd (by norm_num : ¬ 2 ∣ (9 : ℕ))
    have hT := T2.card_eq_multiplicity
    have hNPcard : Nat.card (↥NP) = 36 := firstCase_normalizer_sylow3_card hmin c hfirst d P
    rw [hNPcard] at hT
    rw [hfac] at hT
    norm_num at hT
    calc
      Nat.card Tg = Nat.card (T2 : Subgroup (↥NP)) := by
        exact (Nat.card_congr
          (Subgroup.equivMapOfInjective (T2 : Subgroup (↥NP)) NP.subtype
            NP.subtype_injective).toEquiv).symm
      _ = 4 := hT
  have hintercard : Nat.card ↥(Tg ⊓ c.Hhat) ∣ 18 := by
    have hle : Tg ⊓ c.Hhat ≤ NP ⊓ c.Hhat := inf_le_inf hTgN le_rfl
    exact (Subgroup.card_dvd_of_le hle).trans
      (by
        have hcard18' : Nat.card ↥(NP ⊓ c.Hhat) = 18 := by
          simpa [NP] using firstCase_normalizer_sylow3_inter_hhat_card hmin c hfirst d P hPU
        exact ⟨1, by rw [hcard18']; norm_num⟩)
  have hne_one : Nat.card ↥(Tg ⊓ c.Hhat) ≠ 1 := by
    intro hone
    have hdisj : Disjoint Tg (NP ⊓ c.Hhat) := by
      rw [disjoint_iff_inf_le]
      intro x hx
      have hx' : x ∈ Tg ⊓ c.Hhat := ⟨hx.1, hx.2.2⟩
      have hx1 : x = 1 := by
        -- subgroup of cardinal 1 is trivial
        have hbot : Tg ⊓ c.Hhat = ⊥ := Subgroup.eq_bot_of_card_eq (Tg ⊓ c.Hhat) hone
        rw [hbot] at hx'
        simpa using hx'
      simp [hx1]
    have hcard18' : Nat.card ↥(NP ⊓ c.Hhat) = 18 := by
      simpa [NP] using firstCase_normalizer_sylow3_inter_hhat_card hmin c hfirst d P hPU
    let f : (↥Tg) × ↥(NP ⊓ c.Hhat) → ↥NP := fun z =>
      ⟨(z.1 : G) * (z.2 : G), NP.mul_mem (hTgN z.1.2) z.2.2.1⟩
    have hf_inj : Function.Injective f := by
      intro a b h
      apply Subgroup.mul_injective_of_disjoint hdisj
      exact congrArg Subtype.val h
    have hle72 : 4 * 18 ≤ Nat.card (↥NP) := by
      have hle := Nat.card_le_card_of_injective f hf_inj
      rw [Nat.card_prod, hTg4, hcard18'] at hle
      norm_num at hle
      exact hle
    have hNP : Nat.card (↥NP) = 36 := firstCase_normalizer_sylow3_card hmin c hfirst d P
    omega
  have hdivides : Nat.card ↥(Tg ⊓ c.Hhat) ∣ 4 := by
    exact (Subgroup.card_dvd_of_le (inf_le_left : Tg ⊓ c.Hhat ≤ Tg)).trans (by
      rw [hTg4])
  have h2 : Nat.card ↥(Tg ⊓ c.Hhat) = 2 := by
    -- divides 18 and 4, not 1 → 2
    rcases hdivides with ⟨m, hm⟩
    have hmle : m ≤ 4 := by
      rw [mul_comm] at hm
      exact Nat.le_of_dvd (by norm_num : 0 < 4) ⟨Nat.card ↥(Tg ⊓ c.Hhat), hm⟩
    interval_cases m
    · norm_num at hm
    · norm_num at hm
      have hbad : 4 ∣ 18 := by simpa [hm.symm] using hintercard
      norm_num at hbad
    · omega
    · omega
    · omega
  simpa [Tg] using h2

/-- The nonidentity element of `T₂ ∩ Ĥ` lies outside the two-core
`V = O₂(Ĥ)`: otherwise `T₂` (abelian of order four) would centralize it, and
the centralizer of every nonidentity element of `V` is contained in `Ĥ`,
forcing `T₂ ≤ Ĥ`, contradicting `|T₂ ∩ Ĥ| = 2`. -/
public theorem firstCase_t2_inter_hhat_not_mem_twoCore
    {G : Type u} [Group G] [Finite G]
    (hmin : IsMinimalCounterexample G)
    (c : CentralizerSetup G) (hfirst : FirstCase c) (d : FirstCaseCountData c)
    (P : Sylow 3 G) (hPU : c.U ≤ (P : Subgroup G)) :
    let NP : Subgroup G := Subgroup.normalizer (P : Set G)
    ∀ T2 : Sylow 2 (↥NP),
      ∀ t' : G, t' ∈ ((T2 : Subgroup (↥NP)).map NP.subtype) ⊓ c.Hhat →
        t' ≠ 1 → t' ∉ twoCoreOf c.Hhat := by
  classical
  intro NP T2 t' ht' ht'ne
  let : Fact (Nat.Prime 2) := ⟨Nat.prime_two⟩
  let Tg : Subgroup G := (T2 : Subgroup (↥NP)).map NP.subtype
  have hklein : IsKleinFour (pCore 2 c.Hhat) := firstCase_twoCore_isKleinFour hmin c hfirst
  have hTg4 : Nat.card Tg = 4 := by
    have hfac : (36 : ℕ).factorization 2 = 2 := by
      rw [show (36 : ℕ) = 2 ^ 2 * 9 by norm_num]
      rw [Nat.factorization_mul (by norm_num) (by norm_num)]
      rw [Nat.factorization_pow]
      simp [Nat.prime_two.factorization_self]
      exact Nat.factorization_eq_zero_of_not_dvd (by norm_num : ¬ 2 ∣ (9 : ℕ))
    have hT := T2.card_eq_multiplicity
    have hNPcard : Nat.card (↥NP) = 36 := firstCase_normalizer_sylow3_card hmin c hfirst d P
    rw [hNPcard] at hT
    rw [hfac] at hT
    norm_num at hT
    calc
      Nat.card Tg = Nat.card (T2 : Subgroup (↥NP)) := by
        exact (Nat.card_congr
          (Subgroup.equivMapOfInjective (T2 : Subgroup (↥NP)) NP.subtype
            NP.subtype_injective).toEquiv).symm
      _ = 4 := hT
  have hTg4sq : Nat.card Tg = 2 ^ 2 := by
    rw [hTg4]
    norm_num
  have : IsMulCommutative Tg :=
    IsPGroup.isMulCommutative_of_card_eq_prime_sq (p := 2) hTg4sq
  intro htV
  have ht'central : ∀ x : G, x ∈ Tg → x * t' = t' * x := by
    intro x hx
    exact congrArg Subtype.val
      (((IsPGroup.isMulCommutative_of_card_eq_prime_sq (p := 2) hTg4sq).is_comm).comm
        ⟨x, hx⟩ ⟨t', ht'.1⟩)
  have hTg_le_C : Tg ≤ Subgroup.centralizer ({t'} : Set G) := by
    intro x hx
    rw [Subgroup.mem_centralizer_singleton_iff]
    exact ht'central x hx
  have hC_le_Hhat : Subgroup.centralizer ({t'} : Set G) ≤ c.Hhat :=
    firstCase_klein_centralizer_twoCore_le_Hhat hmin c hklein t' htV ht'ne
  have hTg_le_Hhat : Tg ≤ c.Hhat := hTg_le_C.trans hC_le_Hhat
  have hcard2 : Nat.card ↥(Tg ⊓ c.Hhat) = 2 := by
    simpa [NP, Tg] using firstCase_normalizer_sylow3_sylow2_inter_hhat_card_two
      hmin c hfirst d P hPU T2
  have hcard4 : Nat.card ↥(Tg ⊓ c.Hhat) = 4 := by
    have hEq : Tg ⊓ c.Hhat = Tg := by
      apply le_antisymm
      · exact inf_le_left
      · intro x hx
        exact ⟨hx, hTg_le_Hhat hx⟩
    rw [hEq]
    exact hTg4
  omega

/-- In the Klein-four branch, every involution of `Ĥ` outside `V=O₂(Ĥ)`
inverts every element of `U`.  This is the uniform-Hall part of
`firstCase_klein_data_complete`, specialized from `t'` to an arbitrary
involution. -/
private lemma firstCase_hhat_involution_not_twoCore_inverts_U
    {G : Type u} [Group G] [Finite G]
    (hmin : IsMinimalCounterexample G)
    (c : CentralizerSetup G) (hfirst : FirstCase c) (d : FirstCaseCountData c)
    {s : G} (hsH : s ∈ c.Hhat) (hsInv : IsInvolution s)
    (hsV : s ∉ twoCoreOf c.Hhat) :
    ∀ u : G, u ∈ c.U → s * u * s⁻¹ = u⁻¹ := by
  classical
  have hklein : IsKleinFour (pCore 2 c.Hhat) := firstCase_twoCore_isKleinFour hmin c hfirst
  obtain ⟨d0, K, hKHall, hKne, hKall⟩ :=
    firstCase_klein_data_complete hmin c hfirst hklein
  have hKleU : K ≤ c.U := hKHall.1.trans (fittingSubgroupOf_le c.U)
  have hU3 : Nat.card c.U = 3 := firstCase_U_card_three hmin c hfirst d
  have hKne1 : Nat.card ↥K ≠ 1 := by
    intro h1
    apply hKne
    exact Subgroup.eq_bot_of_card_eq K h1
  have hK3 : Nat.card ↥K = 3 := by
    have hKdvd : Nat.card ↥K ∣ Nat.card c.U := Subgroup.card_dvd_of_le hKleU
    rw [hU3] at hKdvd
    rcases hKdvd with ⟨m, hm⟩
    have hm3 : 3 = Nat.card ↥K * m := by simpa [hU3] using hm
    have hmle : m ≤ 3 := by
      rw [mul_comm] at hm3
      exact Nat.le_of_dvd (by norm_num : 0 < 3) ⟨Nat.card ↥K, hm3⟩
    interval_cases m
    · norm_num at hm3
    · norm_num at hm3
      exact hm3.symm
    · omega
    · omega
  have hKeq : K = c.U := by
    apply Subgroup.eq_of_le_of_card_ge (H := K) (K := c.U) hKleU
    rw [hU3, hK3]
  have hKinv := (hKall s hsH hsInv hsV).1
  intro u hu
  have huK : u ∈ (K : Set G) := by
    rw [hKeq]
    exact hu
  have huinv : u ∈ invertedElements c.U s := by
    simpa [hKinv] using huK
  exact huinv.2

/-- The nonidentity element `t'` of `T₂ ∩ Ĥ` inverts every element of `U`:
by the preceding lemma `t' ∉ V = O₂(Ĥ)`, and the Klein-branch package
`firstCase_klein_data_complete` gives a uniform nonidentity Hall subgroup
`K` of `F(U)` inverted by every involution of `Ĥ ∖ V`; since `|U| = 3` and
`K ≤ F(U) ≤ U`, we have `K = U`. -/
public theorem firstCase_t2_inter_hhat_inverts_U
    {G : Type u} [Group G] [Finite G]
    (hmin : IsMinimalCounterexample G)
    (c : CentralizerSetup G) (hfirst : FirstCase c) (d : FirstCaseCountData c)
    (P : Sylow 3 G) (hPU : c.U ≤ (P : Subgroup G)) :
    let NP : Subgroup G := Subgroup.normalizer (P : Set G)
    ∀ T2 : Sylow 2 (↥NP),
      ∀ t' : G, t' ∈ ((T2 : Subgroup (↥NP)).map NP.subtype) ⊓ c.Hhat →
        t' ≠ 1 → ∀ u : G, u ∈ c.U → t' * u * t'⁻¹ = u⁻¹ := by
  classical
  intro NP T2 t' ht' ht'ne u hu
  let Tg : Subgroup G := (T2 : Subgroup (↥NP)).map NP.subtype
  have hklein : IsKleinFour (pCore 2 c.Hhat) := firstCase_twoCore_isKleinFour hmin c hfirst
  have ht'V : t' ∉ twoCoreOf c.Hhat :=
    firstCase_t2_inter_hhat_not_mem_twoCore hmin c hfirst d P hPU T2 t' ht' ht'ne
  have ht'Inv : IsInvolution t' := by
    refine ⟨ht'ne, ?_⟩
    have hord : orderOf t' = 2 := by
      have hzle : Subgroup.zpowers t' ≤ Tg ⊓ c.Hhat := by
        intro x hx
        rcases Subgroup.mem_zpowers_iff.mp hx with ⟨n, rfl⟩
        exact ⟨Tg.zpow_mem ht'.1 n, c.Hhat.zpow_mem ht'.2 n⟩
      have hzcard : Nat.card ↥(Subgroup.zpowers t') ≤ 2 := by
        have hdvd := Subgroup.card_dvd_of_le hzle
        have hc2 : Nat.card ↥(Tg ⊓ c.Hhat) = 2 := by
          simpa [NP, Tg] using firstCase_normalizer_sylow3_sylow2_inter_hhat_card_two
            hmin c hfirst d P hPU T2
        rw [hc2] at hdvd
        exact Nat.le_of_dvd (by norm_num : 0 < 2) hdvd
      rw [Nat.card_zpowers] at hzcard
      have hne1 : orderOf t' ≠ 1 := by
        intro h1
        apply ht'ne
        rwa [← orderOf_eq_one_iff]
      have hpos : 0 < orderOf t' := orderOf_pos t'
      omega
    rw [← hord]
    exact pow_orderOf_eq_one t'
  exact firstCase_hhat_involution_not_twoCore_inverts_U hmin c hfirst d
    ht'.2 ht'Inv ht'V u hu

/-- The nonidentity element `t'` of `T₂ ∩ Ĥ` inverts every element of `P`:
it inverts `U` (the preceding lemma), and since `T₂` is abelian it also
inverts the second line `W` (conjugate `W = a U a⁻¹` with `a ∈ T₂`
commuting with `t'`); `P = U ⊔ W` is abelian, so every `p = u w` is
inverted.  Consequently `t' · p` is an involution for every `p ∈ P`. -/
public theorem firstCase_t2_inter_hhat_inverts_P
    {G : Type u} [Group G] [Finite G]
    (hmin : IsMinimalCounterexample G)
    (c : CentralizerSetup G) (hfirst : FirstCase c) (d : FirstCaseCountData c)
    (P : Sylow 3 G) (hPU : c.U ≤ (P : Subgroup G)) :
    let NP : Subgroup G := Subgroup.normalizer (P : Set G)
    ∀ T2 : Sylow 2 (↥NP),
      ∀ t' : G, t' ∈ ((T2 : Subgroup (↥NP)).map NP.subtype) ⊓ c.Hhat →
        t' ≠ 1 → ∀ p : G, p ∈ (P : Subgroup G) → t' * p * t'⁻¹ = p⁻¹ := by
  classical
  intro NP T2 t' ht' ht'ne p hp
  let Tg : Subgroup G := (T2 : Subgroup (↥NP)).map NP.subtype
  have hTg4 : Nat.card Tg = 4 := by
    have hfac : (36 : ℕ).factorization 2 = 2 := by
      rw [show (36 : ℕ) = 2 ^ 2 * 9 by norm_num]
      rw [Nat.factorization_mul (by norm_num) (by norm_num)]
      rw [Nat.factorization_pow]
      simp [Nat.prime_two.factorization_self]
      exact Nat.factorization_eq_zero_of_not_dvd (by norm_num : ¬ 2 ∣ (9 : ℕ))
    have hT := T2.card_eq_multiplicity
    have hNPcard : Nat.card (↥NP) = 36 :=
      firstCase_normalizer_sylow3_card hmin c hfirst d P
    rw [hNPcard] at hT
    rw [hfac] at hT
    norm_num at hT
    calc
      Nat.card Tg = Nat.card (T2 : Subgroup (↥NP)) := by
        exact (Nat.card_congr
          (Subgroup.equivMapOfInjective (T2 : Subgroup (↥NP)) NP.subtype
            NP.subtype_injective).toEquiv).symm
      _ = 4 := hT
  have hTg4sq : Nat.card Tg = 2 ^ 2 := by
    rw [hTg4]
    norm_num
  have : IsMulCommutative Tg :=
    IsPGroup.isMulCommutative_of_card_eq_prime_sq (p := 2) hTg4sq
  have hcommTg : ∀ a b : G, a ∈ Tg → b ∈ Tg → a * b = b * a := by
    intro a b ha hb
    exact congrArg Subtype.val
      (((IsPGroup.isMulCommutative_of_card_eq_prime_sq (p := 2) hTg4sq).is_comm).comm
        ⟨a, ha⟩ ⟨b, hb⟩)
  have hU3 : Nat.card c.U = 3 := firstCase_U_card_three hmin c hfirst d
  obtain ⟨U1, U2, _hUne, hU1le, hU2le, hU1conj, hU2conj, honly⟩ :=
    firstCase_sylow3_UConjugates_inside_eq hmin c hfirst d P
  have hU1eq : U1 = c.U ∨ U2 = c.U := by
    have hUconj : ∃ g : G, c.U = conjugateSubgroup c.U g := by
      refine ⟨1, ?_⟩
      rw [conjugateSubgroup]
      have h1 : (MulAut.conj (1 : G)).toMonoidHom = MonoidHom.id G := by
        ext x
        simp
      rw [h1]
      exact (Subgroup.map_id c.U).symm
    exact honly c.U hUconj hPU |>.elim (fun h => Or.inl h.symm) (fun h => Or.inr h.symm)
  -- name the line equal to `c.U` as `U` and the other as `W`
  let U : Subgroup G := if hU1eq' : U1 = c.U then U1 else U2
  let W : Subgroup G := if hU1eq' : U1 = c.U then U2 else U1
  have hUeq : U = c.U := by
    by_cases h : U1 = c.U
    · simpa [U, h]
    · rcases hU1eq with h1 | h2
      · exact False.elim (h h1)
      · simpa [U, h]
  have hUle : U ≤ (P : Subgroup G) := by
    by_cases h : U1 = c.U
    · simpa [U, h]
    · simpa [U, h]
  have hWle : W ≤ (P : Subgroup G) := by
    by_cases h : U1 = c.U
    · simpa [W, h]
    · simpa [W, h]
  have hUconj : ∃ g : G, U = conjugateSubgroup c.U g := by
    by_cases h : U1 = c.U
    · simpa [U, h] using hU1conj
    · simpa [U, h] using hU2conj
  have hWconj : ∃ g : G, W = conjugateSubgroup c.U g := by
    by_cases h : U1 = c.U
    · simpa [W, h] using hU2conj
    · simpa [W, h] using hU1conj
  have hUneW : U ≠ W := by
    by_cases h : U1 = c.U
    · rw [show U = U1 by simp [U, h], show W = U2 by simp [W, h]]
      exact _hUne
    · rw [show U = U2 by simp [U, h], show W = U1 by simp [W, h]]
      exact _hUne.symm
  have hinvU : ∀ u : G, u ∈ U → t' * u * t'⁻¹ = u⁻¹ := by
    intro u hu
    rw [hUeq] at hu
    exact firstCase_t2_inter_hhat_inverts_U hmin c hfirst d P hPU T2 t' ht' ht'ne u hu
  -- an element of `T₂ ∖ Ĥ` swaps `U` and `W`
  have hTg2 : Nat.card ↥(Tg ⊓ c.Hhat) = 2 := by
    simpa [NP, Tg] using firstCase_normalizer_sylow3_sylow2_inter_hhat_card_two
      hmin c hfirst d P hPU T2
  have haEx : ∃ a : G, a ∈ Tg ∧ a ∉ (c.Hhat : Set G) := by
    classical
    let : Fintype G := Fintype.ofFinite G
    let F : Finset G := {x : G | x ∈ Tg}.toFinset
    let E : Finset G := {x : G | x ∈ Tg ∧ x ∈ c.Hhat}.toFinset
    have hFcard : F.card = 4 := by
      have hset : ({x : G | x ∈ Tg} : Set G).ncard = 4 := by
        rw [← Nat.card_coe_set_eq]
        exact hTg4
      rw [← Set.ncard_eq_toFinset_card' ({x : G | x ∈ Tg} : Set G)]
      simpa [F] using hset
    have hEcard : E.card = 2 := by
      have hset : ({x : G | x ∈ Tg ∧ x ∈ c.Hhat} : Set G).ncard = 2 := by
        rw [← Nat.card_coe_set_eq]
        exact hTg2
      rw [← Set.ncard_eq_toFinset_card' ({x : G | x ∈ Tg ∧ x ∈ c.Hhat} : Set G)]
      simpa [E] using hset
    have hlt : E.card < F.card := by omega
    rcases Finset.exists_mem_notMem_of_card_lt_card hlt with ⟨a, haF, haE⟩
    refine ⟨a, ?_, ?_⟩
    · simpa [F] using haF
    · intro h
      apply haE
      have haTg : a ∈ Tg := by simpa [F] using haF
      simpa [E] using ⟨haTg, h⟩
  rcases haEx with ⟨a, haTg, haHhat⟩
  have hTgNP : Tg ≤ NP := by
    intro y hy
    rcases Subgroup.mem_map.mp hy with ⟨z, hz, rfl⟩
    exact z.2
  have hO2 : twoCoreOf c.Hhat ≠ ⊥ := by
    have hklein : IsKleinFour (pCore 2 c.Hhat) :=
      firstCase_twoCore_isKleinFour hmin c hfirst
    intro hbot
    have hc : Nat.card (twoCoreOf c.Hhat) = 1 := by rw [hbot]; simp
    have h4 : Nat.card (twoCoreOf c.Hhat) = 4 :=
      (firstCase_klein_V_klein c hklein).card_four
    omega
  have haU : conjugateSubgroup U a = W := by
    have hconj : ∃ g : G, conjugateSubgroup U a = conjugateSubgroup c.U g := by
      rcases hUconj with ⟨g, hg⟩
      rw [hg]
      refine ⟨a * g, ?_⟩
      unfold conjugateSubgroup
      rw [Subgroup.map_map]
      congr 1
      ext x
      simp [MulAut.conj_apply]
    have hle : conjugateSubgroup U a ≤ (P : Subgroup G) := by
      have hN : a ∈ NP := hTgNP haTg
      have hmap : (U.map (MulAut.conj a) : Subgroup G) ≤ P := by
        intro x hx
        rcases Subgroup.mem_map.mp hx with ⟨u, hu, rfl⟩
        change a * u * a⁻¹ ∈ (P : Subgroup G)
        exact (Subgroup.mem_normalizer_iff.mp hN u).mp (hUle hu)
      simpa [conjugateSubgroup] using hmap
    have hne : conjugateSubgroup U a ≠ U := by
      rw [hUeq]
      intro hEq
      apply haHhat
      rw [← theorem26_normalizer_U_eq_Hhat hmin c hO2 (lemma_2_2 hmin c).2]
      change a ∈ Subgroup.normalizer (c.U : Set G)
      rw [Subgroup.mem_normalizer_iff_map_conj_eq]
      change c.U.map (MulAut.conj a) = c.U
      simpa [conjugateSubgroup] using hEq
    have hV : conjugateSubgroup U a = U ∨ conjugateSubgroup U a = W := by
      rcases honly (conjugateSubgroup U a) hconj hle with h | h
      · by_cases hc : U1 = c.U
        · left
          simpa [U, hc] using h
        · right
          simpa [W, hc] using h
      · by_cases hc : U1 = c.U
        · right
          simpa [W, hc] using h
        · left
          simpa [U, hc] using h
    rcases hV with h | h
    · exact False.elim (hne h)
    · exact h
  have hcomm_t_a : t' * a = a * t' := hcommTg t' a ht'.1 haTg
  have hcomm_ainv_tinv : a⁻¹ * t'⁻¹ = t'⁻¹ * a⁻¹ :=
    hcommTg a⁻¹ t'⁻¹ (Tg.inv_mem haTg) (Tg.inv_mem ht'.1)
  have hinvW : ∀ w : G, w ∈ W → t' * w * t'⁻¹ = w⁻¹ := by
    intro w hw
    have hwW : w ∈ conjugateSubgroup U a := by
      rwa [haU]
    rcases Subgroup.mem_map.mp hwW with ⟨u, hu, hw'⟩
    change MulAut.conj a u = w at hw'
    simp [MulAut.conj_apply] at hw'
    have huInv : t' * u * t'⁻¹ = u⁻¹ := hinvU u hu
    calc
      t' * w * t'⁻¹ = t' * (a * u * a⁻¹) * t'⁻¹ := by rw [hw']
      _ = a * (t' * u * t'⁻¹) * a⁻¹ := by
        calc
          t' * (a * u * a⁻¹) * t'⁻¹ = t' * a * u * a⁻¹ * t'⁻¹ := by group
          _ = a * t' * u * a⁻¹ * t'⁻¹ := by rw [hcomm_t_a]
          _ = a * t' * u * t'⁻¹ * a⁻¹ := by
            rw [mul_assoc (a * t' * u) a⁻¹ t'⁻¹]
            rw [hcomm_ainv_tinv]
            rw [← mul_assoc (a * t' * u) t'⁻¹ a⁻¹]
          _ = a * (t' * u * t'⁻¹) * a⁻¹ := by group
      _ = a * u⁻¹ * a⁻¹ := by rw [huInv]
      _ = (a * u * a⁻¹)⁻¹ := by group
      _ = w⁻¹ := by rw [hw']
  have hP9 : Nat.card (P : Subgroup G) = 9 := firstCase_sylow3_card_nine c d P
  have hU_3 : Nat.card U = 3 := by
    rcases hUconj with ⟨g, hg⟩
    rw [hg, conjugateSubgroup]
    have hc := Nat.card_congr (Subgroup.equivMapOfInjective c.U (MulAut.conj g).toMonoidHom
      (MulAut.conj g).injective).toEquiv
    simpa using hc.symm.trans hU3
  have hW_3 : Nat.card W = 3 := by
    rcases hWconj with ⟨g, hg⟩
    rw [hg, conjugateSubgroup]
    have hc := Nat.card_congr (Subgroup.equivMapOfInjective c.U (MulAut.conj g).toMonoidHom
      (MulAut.conj g).injective).toEquiv
    simpa using hc.symm.trans hU3
  have hcommP : ∀ a b : G, a ∈ (P : Subgroup G) → b ∈ (P : Subgroup G) →
      a * b = b * a := by
    intro a b ha hb
    have hP9' : Nat.card (P : Subgroup G) = 3 ^ 2 := by simpa using hP9
    exact congrArg Subtype.val
      (((IsPGroup.isMulCommutative_of_card_eq_prime_sq (p := 3) hP9').is_comm).comm
        ⟨a, ha⟩ ⟨b, hb⟩)
  have hdecomp : ∃ u w : G, u ∈ U ∧ w ∈ W ∧ p = u * w := by
    have hdisj : Disjoint U W := by
      rw [disjoint_iff_inf_le]
      intro x hx
      by_contra hxne
      have hUz : U = Subgroup.zpowers x := by
        have hordx : orderOf x = 3 := by
          have hdvd : orderOf x ∣ 3 := by
            have hd := Subgroup.orderOf_dvd_natCard U hx.1
            rwa [hU_3] at hd
          have hne1 : orderOf x ≠ 1 := by
            intro h1
            exact hxne (orderOf_eq_one_iff.mp h1)
          rcases (Nat.dvd_prime Nat.prime_three).mp hdvd with h1 | h3
          · exact False.elim (hne1 h1)
          · exact h3
        have hzle : Subgroup.zpowers x ≤ U := by
          intro y hy
          rcases Subgroup.mem_zpowers_iff.mp hy with ⟨n, rfl⟩
          exact U.zpow_mem hx.1 n
        have hzcard : Nat.card (Subgroup.zpowers x : Subgroup G) = 3 := by
          rw [Nat.card_zpowers, hordx]
        apply (Subgroup.eq_of_le_of_card_ge (H := Subgroup.zpowers x) (K := U)
          hzle (by rw [hU_3]; exact hzcard.ge)).symm
      have hWz : W = Subgroup.zpowers x := by
        have hordx : orderOf x = 3 := by
          have hdvd : orderOf x ∣ 3 := by
            have hd := Subgroup.orderOf_dvd_natCard W hx.2
            rwa [hW_3] at hd
          have hne1 : orderOf x ≠ 1 := by
            intro h1
            exact hxne (orderOf_eq_one_iff.mp h1)
          rcases (Nat.dvd_prime Nat.prime_three).mp hdvd with h1 | h3
          · exact False.elim (hne1 h1)
          · exact h3
        have hzle : Subgroup.zpowers x ≤ W := by
          intro y hy
          rcases Subgroup.mem_zpowers_iff.mp hy with ⟨n, rfl⟩
          exact W.zpow_mem hx.2 n
        have hzcard : Nat.card (Subgroup.zpowers x : Subgroup G) = 3 := by
          rw [Nat.card_zpowers, hordx]
        apply (Subgroup.eq_of_le_of_card_ge (H := Subgroup.zpowers x) (K := W)
          hzle (by rw [hW_3]; exact hzcard.ge)).symm
      exact hUneW (hUz.trans hWz.symm)
    have hnorm : W ≤ Subgroup.normalizer (U : Set G) := by
      intro w hw
      rw [Subgroup.mem_normalizer_iff]
      intro u
      constructor
      · intro hu
        have hcomm : u * w = w * u := hcommP u w (hUle hu) (hWle hw)
        have hcalc : w * u * w⁻¹ = u := by
          calc
            w * u * w⁻¹ = u * w * w⁻¹ := by rw [hcomm]
            _ = u := by group
        rwa [hcalc]
      · intro huW
        have hcomm : w⁻¹ * (w * u * w⁻¹) = (w * u * w⁻¹) * w⁻¹ :=
          hcommP w⁻¹ (w * u * w⁻¹) (hWle (W.inv_mem hw)) (hUle huW)
        have hu : u = w⁻¹ * (w * u * w⁻¹) * w := by group
        have hcalc : w⁻¹ * (w * u * w⁻¹) * w = w * u * w⁻¹ := by
          calc
            w⁻¹ * (w * u * w⁻¹) * w = (w * u * w⁻¹) * w⁻¹ * w := by rw [hcomm]
            _ = w * u * w⁻¹ := by group
        rwa [hu, hcalc]
    have hcard : Nat.card (U ⊔ W : Subgroup G) = 9 := by
      rw [card_sup_eq_mul_of_disjoint_of_le_normalizer U W hnorm hdisj]
      rw [hU_3, hW_3]
    have hEq : U ⊔ W = (P : Subgroup G) := by
      apply Subgroup.eq_of_le_of_card_ge (H := U ⊔ W) (K := (P : Subgroup G))
        (sup_le hUle hWle)
      rw [hP9]
      exact hcard.ge
    have hpSup : p ∈ (U ⊔ W : Subgroup G) := by
      change p ∈ (((U ⊔ W : Subgroup G) : Set G))
      rw [hEq]
      exact hp
    have hset : (((U ⊔ W : Subgroup G) : Set G)) = (U : Set G) * (W : Set G) := by
      simpa using (Subgroup.coe_mul_of_right_le_normalizer_left U W hnorm)
    have hmem : p ∈ (U : Set G) * (W : Set G) := by
      change p ∈ (((U ⊔ W : Subgroup G) : Set G)) at hpSup
      rwa [hset] at hpSup
    rcases Set.mem_mul.mp hmem with ⟨u, hu⟩
    rcases hu with ⟨huU, hmem'⟩
    rcases hmem' with ⟨w, hw⟩
    rcases hw with ⟨hwW, hp'⟩
    exact ⟨u, ⟨w, ⟨huU, ⟨hwW, hp'.symm⟩⟩⟩⟩
  rcases hdecomp with ⟨u, hu⟩
  rcases hu with ⟨w, hw⟩
  rcases hw with ⟨huU, hw'⟩
  rcases hw' with ⟨hwW, hp'⟩
  calc
    t' * p * t'⁻¹ = t' * (u * w) * t'⁻¹ := by rw [hp']
    _ = (t' * u * t'⁻¹) * (t' * w * t'⁻¹) := by group
    _ = u⁻¹ * w⁻¹ := by rw [hinvU u huU, hinvW w hwW]
    _ = (u * w)⁻¹ := by
      rw [mul_inv_rev]
      simpa [mul_inv_rev] using
        congrArg (fun x : G => x⁻¹) (hcommP w u (hWle hwW) (hUle huU))
    _ = p⁻¹ := by rw [hp']


private lemma conjugateSubgroup_mul {G : Type u} [Group G] (H : Subgroup G) (g h : G) :
    conjugateSubgroup (conjugateSubgroup H h) g = conjugateSubgroup H (g * h) := by
  unfold conjugateSubgroup
  rw [Subgroup.map_map]
  congr 1
  ext x
  simp [MulAut.conj_apply]

