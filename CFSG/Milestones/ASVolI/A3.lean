@[expose] def HasPinnedSylowFieldAction {S M : Type} [Group S] [Group M]
    (identification : S ≃* M) (U : Subgroup S) (F : Subgroup (MulAut S))
    (entrywiseAction : MulAut M → Prop) : Prop :=
  ∃ (modelSylow : Subgroup M) (modelGenerator : MulAut M),
    U.map identification.toMonoidHom = modelSylow ∧
    CFSG.Quasithin.A315.IsSylowOf 2 modelSylow ⊤ ∧
    F.map (MulAut.congr identification).toMonoidHom = Subgroup.zpowers modelGenerator ∧
    entrywiseAction modelGenerator ∧
    ∀ automorphism ∈ Subgroup.zpowers modelGenerator,
      modelSylow.map automorphism.toMonoidHom = modelSylow

@[expose] def A315PinnedFieldGroup (n : ℕ) (S : Type) [Group S]
    (U : Subgroup S) (F : Subgroup (MulAut S)) : Prop :=
  (∃ (K : Type) (_ : Field K) (_ : Finite K) (identification : S ≃* StatedProj (StatedSL 2 K))
      (fieldGenerator : RingAut K), Nat.card K = 2 ^ n ∧
      HasPinnedSylowFieldAction identification U F (fun modelGenerator => IsProjFieldAut (StatedSL 2 K) fieldGenerator modelGenerator)) ∨
  (∃ (K : Type) (_ : Field K) (_ : Finite K) (identification : S ≃* StatedProj (StatedSL 3 K))
      (fieldGenerator : RingAut K), Nat.card K = 2 ^ n ∧
      HasPinnedSylowFieldAction identification U F (fun modelGenerator => IsProjFieldAut (StatedSL 3 K) fieldGenerator modelGenerator)) ∨
  (∃ (K : Type) (_ : Field K) (_ : Finite K)
      (identification : S ≃* StatedProj (StatedSU 3 (2 ^ n) K)) (fieldGenerator : RingAut K), Nat.card K = (2 ^ n) ^ 2 ∧
      HasPinnedSylowFieldAction identification U F (fun modelGenerator =>
        Nat.Coprime (orderOf fieldGenerator) 2 ∧ IsProjFieldAut (StatedSU 3 (2 ^ n) K) fieldGenerator modelGenerator)) ∨
  (∃ (K : Type) (_ : Field K) (_ : Finite K) (identification : S ≃* StatedProj (StatedSp 2 K))
      (fieldGenerator : RingAut K), Nat.card K = 2 ^ n ∧
      HasPinnedSylowFieldAction identification U F (fun modelGenerator => IsProjFieldAut (StatedSp 2 K) fieldGenerator modelGenerator)) ∨
  (∃ (a : ℕ) (K : Type) (_ : Field K) (_ : Finite K) (identification : S ≃* ↥(suzukiGroup a K))
      (fieldGenerator : RingAut K), n = 2 * a + 1 ∧ Nat.card K = 2 ^ n ∧
      HasPinnedSylowFieldAction identification U F (fun modelGenerator =>
        ∀ g : ↥(suzukiGroup a K), ∃ g' : ↥(suzukiGroup a K),
          (g' : GL (Fin 4) K) = glMapAut fieldGenerator (g : GL (Fin 4) K) ∧ modelGenerator g = g')) ∨
  (∃ (K : Type) (_ : Field K) (_ : Finite K) (identification : S ≃* AdjointQuotient Tag.G2 K)
      (fieldGenerator : RingAut K), Nat.card K = 2 ^ n ∧
      HasPinnedSylowFieldAction identification U F (fun modelGenerator =>
        ∀ g : ↥(adjointGroup Tag.G2 K), ∃ g' : ↥(adjointGroup Tag.G2 K),
          (g' : ModGL Tag.G2 K) = Units.map (entrywiseHom (fieldGenerator : K →+* K)) (g : ModGL Tag.G2 K) ∧
          modelGenerator (QuotientGroup.mk g) = QuotientGroup.mk g')) ∨
  (∃ (K : Type) (_ : Field K) (_ : Finite K) (σq : K →+* K)
      (identification : S ≃* DerivedCentralQuotient (twistedFixedGroup TwistTag.D4 K σq)) (fieldGenerator : RingAut K),
      Nat.card K = (2 ^ n) ^ 3 ∧
      HasPinnedSylowFieldAction identification U F (fun modelGenerator => (∀ c, σq c = c ^ 2 ^ n) ∧ Nat.Coprime (orderOf fieldGenerator) 3 ∧
        ∀ g : ↥⁅twistedFixedGroup TwistTag.D4 K σq, twistedFixedGroup TwistTag.D4 K σq⁆,
          ∃ g' : ↥⁅twistedFixedGroup TwistTag.D4 K σq, twistedFixedGroup TwistTag.D4 K σq⁆,
            (g' : ModGL TwistTag.D4.tag K) =
              Units.map (entrywiseHom (fieldGenerator : K →+* K)) (g : ModGL TwistTag.D4.tag K) ∧
            modelGenerator (QuotientGroup.mk g) = QuotientGroup.mk g')) ∨
  (∃ (a : ℕ) (K : Type) (_ : Field K) (_ : Finite K)
      (identification : S ≃* DerivedCentralQuotient
        (reeFixedGroup Tag.F4 K reeF4Perm fun i => if i ∈ reeF4Long then 2 ^ a else 2 ^ (a + 1)))
      (fieldGenerator : RingAut K), n = 2 * a + 1 ∧ Nat.card K = 2 ^ n ∧
      HasPinnedSylowFieldAction identification U F (fun modelGenerator =>
        ∀ g : ↥⁅reeFixedGroup Tag.F4 K reeF4Perm
            (fun i => if i ∈ reeF4Long then 2 ^ a else 2 ^ (a + 1)),
            reeFixedGroup Tag.F4 K reeF4Perm
            (fun i => if i ∈ reeF4Long then 2 ^ a else 2 ^ (a + 1))⁆,
          ∃ g' : ↥⁅reeFixedGroup Tag.F4 K reeF4Perm
            (fun i => if i ∈ reeF4Long then 2 ^ a else 2 ^ (a + 1)),
            reeFixedGroup Tag.F4 K reeF4Perm
            (fun i => if i ∈ reeF4Long then 2 ^ a else 2 ^ (a + 1))⁆,
            (g' : ModGL Tag.F4 K) =
              Units.map (entrywiseHom (fieldGenerator : K →+* K)) (g : ModGL Tag.F4 K) ∧
            modelGenerator (QuotientGroup.mk g) = QuotientGroup.mk g'))

@[expose] def A315Case5Concrete {G : Type} [Group G] (L T B : Subgroup G) : Prop :=
  ∃ (_ : L.Normal) (n : ℕ), 2 ≤ n ∧ CFSG.Quasithin.A315.IsLieChar2 n ↥L ∧
    ∃ F H : Subgroup (MulAut ↥L),
      IsCyclic ↥F ∧ Nat.card ↥F ∣ n ∧
      A315PinnedFieldGroup n ↥L ((T ⊓ L).subgroupOf L) F ∧
      F ≤ Subgroup.normalizer
        (CFSG.Quasithin.A315.autImage L (T ⊓ L) : Set (MulAut ↥L)) ∧
      F ≤ Subgroup.normalizer (H : Set (MulAut ↥L)) ∧
      CFSG.Quasithin.A315.IsCartan 2 (CFSG.Quasithin.A315.autImage L (T ⊓ L))
        ((F ⊔ CFSG.Quasithin.A315.autImage L B ⊔ CFSG.Quasithin.A315.autImage L L) ⊓
          innDiagSubgroup ↥L) H ∧
      F ⊔ CFSG.Quasithin.A315.autImage L B ⊔ CFSG.Quasithin.A315.autImage L L =
        H ⊔ CFSG.Quasithin.A315.autImage L B ⊔ CFSG.Quasithin.A315.autImage L L ∧
      CFSG.Quasithin.A315.autImage L B ≤ F ⊔ H

end ChA

@[expose] def A_3_3 : Prop :=
  ∀ (G : Type) [Group G] [Finite G],
    (∀ L ∈ CFSG.Quasithin.cComp (⊤ : Subgroup G),
      (Maximal (fun K : Subgroup G => CFSG.Open.IsSubnormal K L ∧ K ≠ L)
          (CFSG.Quasithin.solvRad L) ∧
        ∀ M : Subgroup G, Maximal (fun K : Subgroup G => CFSG.Open.IsSubnormal K L ∧ K ≠ L) M →
          M = CFSG.Quasithin.solvRad L) ∧
      (IsSimpleGroup (↥L ⧸ (CFSG.Quasithin.solvRad L).subgroupOf L) ∧
        ∃ a b : ↥L ⧸ (CFSG.Quasithin.solvRad L).subgroupOf L, a * b ≠ b * a) ∧
      CFSG.Quasithin.cComp L = {L}) ∧
    (∀ H : Subgroup G,
      (CFSG.Quasithin.cCompInter (⊤ : Subgroup G) H ⊆ CFSG.Quasithin.cComp H) ∧
      (CFSG.Open.IsSubnormal H ⊤ →
        CFSG.Quasithin.cCompInter (⊤ : Subgroup G) H = CFSG.Quasithin.cComp H)) ∧
    (∀ L ∈ CFSG.Quasithin.cComp (⊤ : Subgroup G), ∀ N : Subgroup G, Group.IsSolvable N →
      L ≤ ChA.normalizerOf N →
      ⁅L, N⁆ ≤ L ∧ CFSG.Quasithin.perfectCore (L ⊔ N) = L) ∧
    (∀ (N : Subgroup G) [N.Normal], Group.IsSolvable N →
      Set.BijOn (fun L : Subgroup G => L.map (QuotientGroup.mk' N))
        (CFSG.Quasithin.cComp (⊤ : Subgroup G))
        (CFSG.Quasithin.cComp (⊤ : Subgroup (G ⧸ N)))) ∧
    (CFSG.Quasithin.cComp (⊤ : Subgroup (G ⧸ CFSG.solvableRadical G)) =
        {K | CFSG.IsComponent K} ∧
