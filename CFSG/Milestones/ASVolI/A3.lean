@[expose] def A314Conclusion (T B L : Subgroup G) : Prop :=
  (CFSG.generalizedFitting ↥B = pCore 2 ↥B ∧ pCore 2 ↥B = CFSG.solvableRadical ↥B ∧
    (CFSG.Quasithin.IsPSL 3 2 2 ↥L ∨ CFSG.Quasithin.IsSL3 4 ↥L ∨ CFSG.Quasithin.IsPSp4 2 2 ↥L ∨
      CFSG.Quasithin.IsG2 2 2 ↥L ∨ CFSG.Quasithin.Is3D4 2 2 ↥L) ∧
    ∃ P, CFSG.Quasithin.IsMaxParabolic2 L P ∧ B = CFSG.Quasithin.perfectCore P) ∨
  (CFSG.Quasithin.IsAlt 5 ↥B ∧
    (CFSG.Quasithin.IsAlt 7 ↥L ∨ CFSG.Quasithin.IsHat ↥L (alternatingGroup (Fin 7))) ∧
    CFSG.Quasithin.StabilizesFivePoints B L) ∨
  (CFSG.Quasithin.IsAlt 5 ↥B ∧ (CFSG.Quasithin.IsPSL 2 5 2 ↥L ∨
    ∃ p : ℕ, p.Prime ∧ p ^ 2 % 5 = 1 ∧ (p % 8 = 3 ∨ p % 8 = 5) ∧ CFSG.Quasithin.IsPSL 2 p 1 ↥L)) ∨
  (CFSG.Quasithin.IsSL2 5 ↥B ∧
    (∃ s : Bool, CFSG.Quasithin.IsPSLEps3 s 5 1 ↥L ∨ CFSG.Quasithin.IsSLEps3 s 5 ↥L) ∧
    B = CFSG.Quasithin.perfectCore (L ⊓ Subgroup.centralizer (pCoreOf 2 B : Set G))) ∨
  (CFSG.Quasithin.IsExt ↥B (fun V _ => CFSG.Quasithin.IsElemAbelianOfRank 5 2 V)
      (fun Y _ => CFSG.Quasithin.IsSL2 5 Y) ∧
    (CFSG.Quasithin.IsPSL 3 5 1 ↥L ∨ CFSG.Quasithin.IsSL3 5 ↥L) ∧
    ∃ P, CFSG.Quasithin.IsMaxParabolicOf 5 L P ∧ B = CFSG.Quasithin.perfectCore P) ∨
  (CFSG.Quasithin.IsExt ↥B (fun V _ => CFSG.Quasithin.IsE2 4 V)
      (fun Y _ => CFSG.Quasithin.IsAlt 5 Y) ∧
    CFSG.QuasithinUnique.IsBlock2 B B ∧ CFSG.QuasithinUnique.IsLin2Type B 2 ∧
    (CFSG.Quasithin.IsSporadic .M22 ↥L ∨
      CFSG.Quasithin.IsHat ↥L (CFSG.Blueprint.NativeSporadic.Carrier .M22))) ∨
  (CFSG.Quasithin.IsExt ↥B (fun V _ => CFSG.Quasithin.IsE2 4 V)
      (fun Y _ => CFSG.Quasithin.IsAlt 5 Y) ∧
    CFSG.QuasithinUnique.IsBlock2 B B ∧ CFSG.QuasithinUnique.IsLin2Type B 2 ∧
    CFSG.Quasithin.IsSporadic .M23 ↥L) ∨
  (CFSG.Quasithin.IsAlt 5 ↥B ∧ CFSG.Quasithin.IsSporadic .J1 ↥L ∧
    ∃ z : G, z ∈ L ∧ orderOf z = 2 ∧
      B = CFSG.Quasithin.perfectCore (L ⊓ Subgroup.centralizer ({z} : Set G))) ∨
  (CFSG.Quasithin.IsExt ↥B (fun V _ => IsQ8D8 V) (fun Y _ => CFSG.Quasithin.IsAlt 5 Y) ∧
    CFSG.Quasithin.IsSporadic .J2 ↥L ∧
    ∃ z : G, CFSG.Quasithin.IsTwoCentralInvolution L z ∧
      B = L ⊓ Subgroup.centralizer ({z} : Set G)) ∨
  (CFSG.Quasithin.IsAlt 5 (CFSG.Quasithin.ModO2 B) ∧
    CFSG.generalizedFitting ↥B = pCore 2 ↥B ∧ CFSG.Quasithin.IsSporadic .J4 ↥L) ∨
  (CFSG.Quasithin.IsExt ↥B (fun V _ => IsZ4StarQ8D8 V)
      (fun Y _ => CFSG.Quasithin.IsAlt 5 Y) ∧
    CFSG.Quasithin.IsSporadic .HS ↥L ∧
    ∃ z : G, CFSG.Quasithin.IsTwoCentralInvolution L z ∧
      B = CFSG.Quasithin.perfectCore (L ⊓ Subgroup.centralizer ({z} : Set G))) ∨
  (CFSG.Quasithin.IsAlt 5 (CFSG.Quasithin.ModO2 B) ∧ Nat.card (pCore 2 ↥B) = 2 ^ 11 ∧
    CFSG.Quasithin.IsSporadic .Ru ↥L ∧
    ∃ z : G, CFSG.Quasithin.IsTwoCentralInvolution L z ∧
      B = CFSG.Quasithin.perfectCore (L ⊓ Subgroup.centralizer ({z} : Set G))) ∨
  (CFSG.Quasithin.IsSL2 5 (↥B ⧸ CFSG.oddCore ↥B) ∧
    L = B ⊔ (CFSG.oddCore ↥L).map L.subtype) ∨
  (CFSG.Quasithin.IsSL2 5 (↥B ⧸ CFSG.oddCore ↥B) ∧ ∃ p : ℕ, p.Prime ∧ p ^ 2 % 5 = 1 ∧
    (p % 8 = 3 ∨ p % 8 = 5) ∧ CFSG.Quasithin.IsSL2 p (↥L ⧸ CFSG.oddCore ↥L))

end A314

