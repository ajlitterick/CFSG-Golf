@[expose] def burnsideA134_Fixes {Y : Type*} [Group Y] (φ : MulAut Y) (T : Subgroup Y) : Prop :=
  ∀ t : Y, t ∈ T ↔ φ t ∈ T

@[expose] def burnsideA134_zT {Y : Type*} [Group Y] (T : Subgroup Y) : Subgroup Y :=
  (Subgroup.center ↥T).map T.subtype

private theorem burnsideA134_mem_zT {Y : Type*} [Group Y] {T : Subgroup Y} {x : Y} :
    x ∈ burnsideA134_zT T ↔ x ∈ T ∧ ∀ t ∈ T, t * x = x * t := by
  constructor
  · rintro ⟨⟨x', hx'⟩, hxc, rfl⟩
    refine ⟨hx', fun t ht => ?_⟩
    have := Subgroup.mem_center_iff.mp hxc ⟨t, ht⟩
    exact congrArg Subtype.val this
  · rintro ⟨hx, hc⟩
    exact ⟨⟨x, hx⟩, Subgroup.mem_center_iff.mpr fun t => Subtype.ext (hc t t.2), rfl⟩

private theorem burnsideA134_Fixes.zT {Y : Type*} [Group Y] {φ : MulAut Y} {T : Subgroup Y}
    (h : burnsideA134_Fixes φ T) {v : Y} (hv : v ∈ burnsideA134_zT T) :
    φ v ∈ burnsideA134_zT T := by
  rw [burnsideA134_mem_zT] at hv ⊢
  refine ⟨(h v).mp hv.1, fun t ht => ?_⟩
  obtain ⟨t', ht', rfl⟩ : ∃ t', t' ∈ T ∧ φ t' = t := by
    refine ⟨φ.symm t, ?_, by simp⟩
    rw [h]
    simpa using ht
  rw [← map_mul, ← map_mul, hv.2 t' ht']


