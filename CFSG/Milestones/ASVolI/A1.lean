section Vocabulary

variable {G : Type} [Group G]

@[expose] def conjSub (X : Subgroup G) (g : G) : Subgroup G :=
  X.map (MulAut.conj g⁻¹).toMonoidHom

@[expose] def conjugatesOf (X : Subgroup G) : Set (Subgroup G) :=
  {Y | ∃ g : G, Y = conjSub X g}

@[expose] def normalizerOf (X : Subgroup G) : Subgroup G :=
  Subgroup.normalizer (X : Set G)

@[expose] def centralizerOf (X : Subgroup G) : Subgroup G :=
  Subgroup.centralizer (X : Set G)

@[expose] def centerOf (X : Subgroup G) : Subgroup G :=
  X ⊓ centralizerOf X

@[expose] def frattiniOf (X : Subgroup G) : Subgroup G :=
  (frattini X).map X.subtype

@[expose] def IsSylowIn (p : ℕ) (P H : Subgroup G) : Prop :=
  P ≤ H ∧ IsPGroup p P ∧ ¬ p ∣ (P.subgroupOf H).index

@[expose] def IsPiGroup (π : Set ℕ) (H : Type*) [Group H] : Prop :=
  ∀ q : ℕ, q.Prime → q ∣ Nat.card H → q ∈ π

@[expose] def oResidual (π : Set ℕ) (X : Subgroup G) : Subgroup G :=
  ⨅ (N : Subgroup G) (_ : N ≤ X ∧ (N.subgroupOf X).Normal ∧
      ∀ x ∈ X, ∃ m : ℕ, 0 < m ∧ (∀ q : ℕ, q.Prime → q ∣ m → q ∈ π) ∧ x ^ m ∈ N), N

@[expose] def IsTISetIn (X M : Subgroup G) : Prop :=
  X ≤ M ∧ ∀ g ∈ M, g ∉ ChA.normalizerOf X → X ⊓ conjSub X g = ⊥

@[expose] def IsWeaklyClosedIn (A B : Subgroup G) : Prop :=
  ∀ g : G, conjSub A g ≤ B → conjSub A g = A

@[expose] def IsIndecomposableGroup (H : Type*) [Group H] : Prop :=
  Nontrivial H ∧ ∀ A B : Subgroup H, A.Normal → B.Normal → A ⊓ B = ⊥ → A ⊔ B = ⊤ →
    A = ⊥ ∨ B = ⊥

@[expose] def IsTwoReduced (M V : Subgroup G) : Prop :=
  V ≤ M ∧ (V.subgroupOf M).Normal ∧ IsElemAbelian 2 V ∧
    ∀ N : Subgroup G, M ⊓ centralizerOf V ≤ N → N ≤ M → (N.subgroupOf M).Normal →
      (∀ x ∈ N, ∃ k : ℕ, x ^ 2 ^ k ∈ M ⊓ centralizerOf V) → N ≤ M ⊓ centralizerOf V

@[expose] def twoReducedProduct (M : Subgroup G) : Subgroup G :=
  sSup {V | IsTwoReduced M V}

@[expose] def cyclicQuotientCentralizerFamily (A N : Subgroup G) : Set (Subgroup G) :=
  {B | B ≤ A ∧ (∃ a ∈ A, A ≤ B ⊔ Subgroup.zpowers a) ∧ N ⊓ centralizerOf B ≠ ⊥}


@[expose] def omegaOne (p : ℕ) (P : Subgroup G) : Subgroup G :=
  Subgroup.closure {x | x ∈ P ∧ x ^ p = 1}

@[expose] def ClassLeTwo (X : Subgroup G) : Prop :=
  ⁅⁅X, X⁆, X⁆ = ⊥

@[expose] def IsSupercritical (p : ℕ) (P X : Subgroup G) : Prop :=
  X ≤ P ∧ (X.subgroupOf P).Characteristic ∧ frattiniOf X ≤ centerOf X ∧
    ⁅X, P⁆ ≤ centerOf X ∧ (∀ x ∈ X, x ^ p = 1) ∧
    ∀ x ∈ P ⊓ centralizerOf X, orderOf x = p → x ∈ X

@[expose] def IsPOnePlusTwo (p : ℕ) (H : Type*) [Group H] : Prop :=
  CFSG.IsExtraspecial p H ∧ Nat.card H = p ^ 3 ∧ ∀ h : H, h ^ p = 1

@[expose] def IsElemAbelianOfOrder (p n : ℕ) (H : Type*) [Group H] : Prop :=
  (∀ x y : H, x * y = y * x) ∧ (∀ x : H, x ^ p = 1) ∧ Nat.card H = p ^ n

@[expose] def IsQuotientOfSQTK (X : Type) [Group X] : Prop :=
  ∃ (Y : Type) (_ : Group Y) (_ : Finite Y), CFSG.SectionRank.IsSQTKCat Y ∧
    ∃ f : Y →* X, Function.Surjective f

@[expose] def IsSUn (n q : ℕ) (X : Type*) [Group X] : Prop :=
  ∃ (K : Type) (_ : Field K) (_ : Finite K), Nat.card K = q ^ 2 ∧
    Nonempty (X ≃* CFSG.Open.StatedSU n q K)

@[expose] def conjSet (X : Set G) (g : G) : Set G :=
  (fun x => g⁻¹ * x * g) '' X

end Vocabulary

end ChA

open CFSG.ASVolI.ChA

@[expose] def A_1_1 : Prop :=
  ∀ (G : Type) [Group G] (X Y Z : Subgroup G),
    ⁅⁅X, Y⁆, Z⁆ = ⊥ → ⁅⁅Y, Z⁆, X⁆ = ⊥ → ⁅⁅Z, X⁆, Y⁆ = ⊥


@[expose] def A_1_2 : Prop :=
  ∀ (G : Type) [Group G] [Finite G] (p : ℕ), p.Prime → ∀ X : Subgroup G, IsPGroup p X →
    (X ≤ pCore p G ∨ ∃ g : G, ¬ IsPGroup p ↥(X ⊔ conjSub X g)) ∧
    (Nat.card X = 2 → X ≤ pCore 2 G ∨
      ∃ y : G, y ≠ 1 ∧ Odd (orderOf y) ∧ ∀ x ∈ X, x ≠ 1 → x * y * x⁻¹ = y⁻¹)


@[expose] def A_1_3 : Prop :=
  ∀ (p f : ℕ) [Fact p.Prime], 1 ≤ f → ∀ (H : Subgroup PSL(2, GaloisField p f)),
    (IsElemAbelian p H ∧ ∃ m : ℕ, m ≤ f ∧ Nat.card H = p ^ m) ∨
    (IsCyclic H ∧ (Nat.card H ∣ (p ^ f + 1) / Nat.gcd 2 (p ^ f - 1) ∨
      Nat.card H ∣ (p ^ f - 1) / Nat.gcd 2 (p ^ f - 1))) ∨
    (∃ z : ℕ, (z ∣ (p ^ f + 1) / Nat.gcd 2 (p ^ f - 1) ∨
      z ∣ (p ^ f - 1) / Nat.gcd 2 (p ^ f - 1)) ∧ Nonempty (H ≃* DihedralGroup z)) ∨
    ((p ≠ 2 ∨ Even f) ∧ Nonempty (H ≃* alternatingGroup (Fin 4))) ∨
    (16 ∣ p ^ (2 * f) - 1 ∧ Nonempty (H ≃* Equiv.Perm (Fin 4))) ∨
    ((p = 5 ∨ 5 ∣ p ^ (2 * f) - 1) ∧ Nonempty (H ≃* alternatingGroup (Fin 5))) ∨
    (∃ (m t : ℕ) (P : Subgroup H) (_ : P.Normal), IsElemAbelian p P ∧
      Nat.card P = p ^ m ∧ IsCyclic (H ⧸ P) ∧ Nat.card (H ⧸ P) = t ∧ t ∣ p ^ m - 1 ∧
      t ∣ (p ^ f - 1) / Nat.gcd 2 (p ^ f - 1)) ∨
    (∃ m : ℕ, m ∣ f ∧ Nonempty (H ≃* PSL(2, GaloisField p m))) ∨
    (∃ m : ℕ, 2 * m ∣ f ∧ Nonempty (H ≃* PGL(2, GaloisField p m)))

section BurnsideA1b8

section Cert43

private local instance : DecidableEq (Equiv.Perm (Fin 3)) := Fintype.decidableEqEquivFintype

private theorem burnside_certificate43 :
      ∀ s t : Equiv.Perm (Fin 3),
        (s ≠ 1 ∧ s ^ 2 = 1) → (t ≠ 1 ∧ t ^ 2 = 1) → s ≠ t →
          (s * t) ^ 3 = 1 ∧ s * t ≠ 1 := by
  decide +kernel

end Cert43


end BurnsideA1b8

theorem as_A_1_3 : A_1_3 := by
  haveI := burnside_certificate43
  exact CFSG.Quasithin.F6.dicksonPSL2_holds

@[expose] def A_1_4 : Prop :=
  ∀ (K : Type) [Group K] [Finite K], Group.IsSolvable K →
    (∀ p : ℕ, p.Prime → p ∣ Nat.card (CFSG.fittingSubgroup K) →
      oResidual {p} (⊤ : Subgroup K) ≤ centralizerOf (pCore p K)) →
    ChA.IsPiGroup {p : ℕ | p.Prime ∧ p ∣ Nat.card (CFSG.fittingSubgroup K)} K ∧
      CFSG.fittingSubgroup K = ⊤ ∧ Group.IsNilpotent K


@[expose] def A_1_5 : Prop :=
  ∀ (Γ : Type) [Group Γ] [Finite Γ] (X A : Subgroup Γ) (n : ℕ),
    Odd (Nat.card X) → A ≤ ChA.normalizerOf X → IsElemAbelian 2 A → Nat.card A = 2 ^ n →
    A ⊓ centralizerOf X = ⊥ →
    ∃ (Y : Fin n → Subgroup Γ) (p : Fin n → ℕ),
      A ≤ ⨆ i, Y i ∧ (⨆ i, Y i) ≤ A ⊔ X ∧
      (∀ i, (p i).Prime ∧ p i ≠ 2 ∧ Nonempty (↥(Y i) ≃* DihedralGroup (p i))) ∧
      (∀ i j, i ≠ j → ∀ a ∈ Y i, ∀ b ∈ Y j, a * b = b * a) ∧ iSupIndep Y


@[expose] def A_1_6 : Prop :=
  ∀ (G : Type) [Group G] [Finite G] (T H : Subgroup G),
    T ≤ H → IsSylowIn 2 T ⊤ →
    pCore 2 G ≤ pCoreOf 2 H ∧
    (quasithinGenFitting (⊤ : Subgroup G) = pCore 2 G →
      quasithinGenFitting H = pCoreOf 2 H)


@[expose] def A_1_7 : Prop :=
  ∀ (G : Type) [Group G] [Finite G] (X : Subgroup G) (x : G), x ∈ X →
    (({y : G | ∃ g : G, y = g⁻¹ * x * g} ∩ (X : Set G) =
        {y : G | ∃ n ∈ ChA.normalizerOf X, y = n⁻¹ * x * n}) ↔
      (∀ Y Z : Subgroup G, Y ∈ conjugatesOf X → Z ∈ conjugatesOf X → x ∈ Y → x ∈ Z →
        ∃ c ∈ Subgroup.centralizer {x}, conjSub Y c = Z)) ∧
    (({y : G | ∃ g : G, y = g⁻¹ * x * g} ∩ (X : Set G) =
        {y : G | ∃ n ∈ ChA.normalizerOf X, y = n⁻¹ * x * n}) →
      Subgroup.centralizer {x} ≤ ChA.normalizerOf X →
      ∃! Y : Subgroup G, Y ∈ conjugatesOf X ∧ x ∈ Y) ∧
    (∀ M : Subgroup G, IsTISetIn X M → x ≠ 1 →
      ({y : G | ∃ g : G, y = g⁻¹ * x * g} ∩ (X : Set G) =
        {y : G | ∃ n ∈ ChA.normalizerOf X, y = n⁻¹ * x * n}) →
      Subgroup.centralizer {x} ≤ M →
      ∃! Y : Subgroup G, Y ∈ conjugatesOf X ∧ x ∈ Y)


@[expose] def A_1_8 : Prop :=
  ∀ (G : Type) [Group G] [Finite G] (p : ℕ), p.Prime → ∀ (X : Subgroup G) [X.Normal],
    X ≤ Subgroup.center G →
    quasithinGenFitting (⊤ : Subgroup G) = pCore p G →
    quasithinGenFitting (⊤ : Subgroup (G ⧸ X)) = pCore p (G ⧸ X)


@[expose] def A_1_9 : Prop :=
  ∀ (G : Type) [Group G] [Finite G] (p : ℕ), p.Prime → ∀ (P Y : Subgroup G),
    IsPGroup p P → P ≤ ChA.normalizerOf Y → pCoreOf p Y = ⊥ →
    quasithinGenFitting Y ≤ centralizerOf P → Y ≤ centralizerOf P


@[expose] def A_1_10 : Prop :=
  ∀ (G : Type) [Group G] [Finite G] (L M : Subgroup G), L.Normal → L ⊔ M = ⊤ →
    quasithinGenFitting L = pCoreOf 2 L → quasithinGenFitting M = pCoreOf 2 M →
    (∃ T : Subgroup G, IsSylowIn 2 T ⊤ ∧ T ≤ M) →
    (∃ Q : Subgroup G, Q ≤ pCoreOf 2 M ∧ ChA.normalizerOf Q ≤ M) →
    quasithinGenFitting (⊤ : Subgroup G) = pCore 2 G


