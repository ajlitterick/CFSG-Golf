theorem as_A_1_21 : A_1_21 := by
  intro G _ _ p hp hp2 P hP
  haveI : Fact p.Prime := ⟨hp⟩
  obtain ⟨hex, hall⟩ := as_A_1_21_selectedWitness G p hp hp2 P hP
