theorem as_A_1_21_selectedWitness : A_1_21_selectedWitness := by
  intro G _ _ p hp hp2 P hP
  haveI : Fact p.Prime := ⟨hp⟩
  refine ⟨?_, fun X hX => ⟨?_, fun hrk => ?_⟩⟩
  ·
    obtain ⟨X', hX', hfaith⟩ := CFSG.Quasithin.exists_isSupercritical_faithful (P := ↥P) hp2 hP
    refine ⟨X'.map P.subtype, (a121_isSupercritical_iff P X').2 hX', fun α hα hfix => ?_⟩
    refine hfaith α hα fun x hx => ?_
    have h1 := hfix x (Subgroup.mem_map_of_mem _ hx)
    rw [a121_frattiniOf_map] at h1
    obtain ⟨w, hw, hwx⟩ := h1
    have hw' : w = α x * x⁻¹ := Subtype.ext hwx
    have h2 := a121_frattiniIn_conj_mem (x := x) (X' := X') hx
      (hw' ▸ hw : α x * x⁻¹ ∈ CFSG.Quasithin.frattiniIn X')
    simpa [mul_assoc] using h2
  ·
    obtain ⟨hXP, -, -, hcomm, -, -⟩ := hX
    have h1 : ⁅X, X⁆ ≤ Subgroup.centralizer (X : Set G) :=
      ((Subgroup.commutator_mono le_rfl hXP).trans hcomm).trans inf_le_right
    exact Subgroup.commutator_eq_bot_iff_le_centralizer.2 h1
  ·
    obtain ⟨X', rfl⟩ : ∃ X' : Subgroup ↥P, X = X'.map P.subtype :=
      ⟨X.subgroupOf P, (Subgroup.map_subgroupOf_eq_of_le hX.1).symm⟩
    have hX' := (a121_isSupercritical_iff P X').1 hX
    have h1 : 1 < CFSG.Open.pRank p (⊤ : Subgroup ↥P) := by
      rw [CFSG.Quasithin.pRank_top_subtype, ← CFSG.SectionRank.pRank_coe_eq_openPRank]
      exact hrk
    rw [CFSG.SectionRank.pRank_coe_eq_openPRank]
    exact lt_of_lt_of_le (hX'.one_lt_pRank hP h1)
      (CFSG.SectionRank.pRank_le_map hp.one_lt P.subtype P.subtype_injective X')

