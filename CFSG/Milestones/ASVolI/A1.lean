private theorem burnsideA121_faithful_aux {P : Type*} [Group P] [Finite P] {p : ℕ} [Fact p.Prime]
    (hp2 : p ≠ 2) (hP : IsPGroup p P) {X : Subgroup P}
    (hX : CFSG.Quasithin.IsSupercritical p X) (α : MulAut P) (hα : (orderOf α).Coprime p)
    (hfix : ∀ x ∈ X, x⁻¹ * α x ∈ CFSG.Quasithin.frattiniIn X) : α = 1 := by
  haveI : X.Characteristic := hX.characteristic
  have hX1 : ∀ x ∈ X, α x = x := by
    set β : MulAut ↥X := MulAut.characteristic X α with hβdef
    have hβ : β ∈ (CFSG.SectionRank.Ccomm.autQuotient (frattini ↥X)).ker := by
      rw [CFSG.SectionRank.Ccomm.mem_ker_autQuotient]
      intro x
      obtain ⟨w, hw, hwx⟩ := hfix x x.2
      have hw' : w = x⁻¹ * β x := Subtype.ext (by simpa [hβdef] using hwx)
      exact hw' ▸ hw
    have hβ1 : β = 1 := by
      obtain ⟨k, hk⟩ := CFSG.SectionRank.Ccomm.isPGroup_ker_autQuotient_frattini
        (hP.to_subgroup X) ⟨β, hβ⟩
      have h1 : β ^ p ^ k = 1 := by simpa using congrArg Subtype.val hk
      have h2 : orderOf β ∣ p ^ k := orderOf_dvd_of_pow_eq_one h1
      have h3 : (orderOf β).Coprime p :=
        Nat.Coprime.coprime_dvd_left (orderOf_map_dvd _ α) hα
      exact orderOf_eq_one_iff.1 (Nat.Coprime.eq_one_of_dvd (h3.pow_right k) h2)
    intro x hx
    have := congrArg (fun γ : MulAut ↥X => ((γ ⟨x, hx⟩ : ↥X) : P)) hβ1
    simpa [hβdef] using this
  haveI : (Subgroup.centralizer (X : Set P)).Characteristic :=
    Subgroup.characteristic_centralizer
  have hC1 : ∀ c ∈ Subgroup.centralizer (X : Set P), α c = c := by
    set γ : MulAut ↥(Subgroup.centralizer (X : Set P)) :=
      MulAut.characteristic (Subgroup.centralizer (X : Set P)) α with hγdef
    have hγ : γ = 1 := by
      refine CFSG.HardMathSupport.Timmesfeld.ComponentBalance.mulAut_eq_one_of_coprime_of_fix_omega
        hp2 (hP.to_subgroup _) (Nat.Coprime.coprime_dvd_left (orderOf_map_dvd _ α) hα)
        fun c hc => ?_
      by_cases hc1 : c = 1
      · rw [hc1, map_one]
      · have hco : orderOf (c : P) = p := by
          rw [Subgroup.orderOf_coe]
          exact orderOf_eq_prime hc hc1
        have hcX : (c : P) ∈ X := hX.mem_of_orderOf_eq _ c.2 hco
        exact Subtype.ext (hX1 _ hcX)
    intro c hc
    have := congrArg
      (fun δ : MulAut ↥(Subgroup.centralizer (X : Set P)) => ((δ ⟨c, hc⟩ : _) : P)) hγ
    simpa [hγdef] using this
  let S : Subgroup P := α.toMonoidHom.eqLocus (MonoidHom.id P)
  have hSfix : ∀ s ∈ S, α s = s := fun s hs => hs
  have hXS : (X : Set P) ⊆ (S : Set P) := fun x hx => hX1 x hx
  have hself : Subgroup.centralizer (S : Set P) ≤ S := fun y hy =>
    hC1 y (Subgroup.centralizer_le hXS hy)
  obtain ⟨n, hn⟩ := hP.exists_card_eq
  have hcop : (orderOf α).Coprime (Nat.card P) := by
    rw [hn]
    exact Nat.Coprime.pow_right n hα
  exact CFSG.ComponentClassification.CoprimeAutomorphisms.eq_one_of_self_centralizing p hP S
    hself α (orderOf α) (pow_orderOf_eq_one α) hcop hSfix

private theorem burnsideA121_faithful {G : Type} [Group G] [Finite G] {p : ℕ} [Fact p.Prime]
    (hp2 : p ≠ 2) {P : Subgroup G} (hP : IsPGroup p P) {X : Subgroup G}
    (hX : ChA.IsSupercritical p P X) :
    ∀ α : MulAut ↥P, (orderOf α).Coprime p →
      (∀ x : ↥P, (x : G) ∈ X → ((α x : ↥P) : G) * (x : G)⁻¹ ∈ ChA.frattiniOf X) → α = 1 := by
  obtain ⟨X', rfl⟩ : ∃ X' : Subgroup ↥P, X = X'.map P.subtype :=
    ⟨X.subgroupOf P, (Subgroup.map_subgroupOf_eq_of_le hX.1).symm⟩
  have hX' := (a121_isSupercritical_iff P X').1 hX
  intro α hα hfix
  refine burnsideA121_faithful_aux hp2 hP hX' α hα fun x hx => ?_
  have h1 := hfix x (Subgroup.mem_map_of_mem _ hx)
  rw [a121_frattiniOf_map] at h1
  obtain ⟨w, hw, hwx⟩ := h1
  have hw' : w = α x * x⁻¹ := Subtype.ext hwx
  have h2 := a121_frattiniIn_conj_mem (x := x) (X' := X') hx
    (hw' ▸ hw : α x * x⁻¹ ∈ CFSG.Quasithin.frattiniIn X')
  simpa [mul_assoc] using h2

