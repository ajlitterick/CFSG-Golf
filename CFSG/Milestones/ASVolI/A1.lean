private theorem a121_map_frattini_mulEquiv {H K : Type*} [Group H] [Group K] (e : H ≃* K) :
    (frattini H).map e.toMonoidHom = frattini K := by
  apply le_antisymm
  · rw [Subgroup.map_le_iff_le_comap]
    exact frattini_le_comap_frattini_of_surjective e.surjective
  · have h := frattini_le_comap_frattini_of_surjective (φ := e.symm.toMonoidHom) e.symm.surjective
    intro y hy
    exact ⟨e.symm y, h hy, by simp⟩

private theorem a121_frattiniOf_map {G : Type} [Group G] (P : Subgroup G) (X' : Subgroup ↥P) :
    ChA.frattiniOf (X'.map P.subtype) = (CFSG.Quasithin.frattiniIn X').map P.subtype := by
  let e : ↥X' ≃* ↥(X'.map P.subtype) :=
    Subgroup.equivMapOfInjective X' P.subtype P.subtype_injective
  have h1 := a121_map_frattini_mulEquiv e
  unfold ChA.frattiniOf CFSG.Quasithin.frattiniIn
  rw [← h1, Subgroup.map_map, Subgroup.map_map]
  congr 1

private theorem a121_mem_centerOf_iff {G : Type} [Group G] (P : Subgroup G) (X' : Subgroup ↥P)
    (y : ↥P) : y ∈ CFSG.Quasithin.centerOf X' ↔ (y : G) ∈ ChA.centerOf (X'.map P.subtype) := by
  constructor
  · rintro ⟨hy, hyc⟩
    refine ⟨Subgroup.mem_map_of_mem _ hy, Subgroup.mem_centralizer_iff.2 ?_⟩
    rintro _ ⟨z, hz, rfl⟩
    exact congrArg Subtype.val (Subgroup.mem_centralizer_iff.1 hyc z hz)
  · rintro ⟨hy, hyc⟩
    obtain ⟨y', hy', hyy'⟩ := hy
    have : y' = y := Subtype.ext hyy'
    subst this
    refine ⟨hy', Subgroup.mem_centralizer_iff.2 fun z hz => Subtype.ext ?_⟩
    exact Subgroup.mem_centralizer_iff.1 hyc (z : G) (Subgroup.mem_map_of_mem _ hz)

private theorem a121_isSupercritical_iff {G : Type} [Group G] (P : Subgroup G) {p : ℕ}
    (X' : Subgroup ↥P) :
    ChA.IsSupercritical p P (X'.map P.subtype) ↔ CFSG.Quasithin.IsSupercritical p X' := by
  have hsub : (X'.map P.subtype).subgroupOf P = X' :=
    Subgroup.comap_map_eq_self_of_injective P.subtype_injective X'
  have hcomm : (⁅X', (⊤ : Subgroup ↥P)⁆).map P.subtype = ⁅X'.map P.subtype, P⁆ := by
    rw [Subgroup.map_commutator, ← MonoidHom.range_eq_map, Subgroup.range_subtype]
  constructor
  · rintro ⟨-, hchar, hfr, hcom, hpow, hord⟩
    rw [hsub] at hchar
    refine ⟨hchar, fun y hy => ?_, fun y hy => ?_, fun x hx => ?_, fun x hx hxp => ?_⟩
    · have hy' : (y : G) ∈ ChA.frattiniOf (X'.map P.subtype) := by
        rw [a121_frattiniOf_map]
        exact Subgroup.mem_map_of_mem _ hy
      exact (a121_mem_centerOf_iff P X' y).2 (hfr hy')
    · have hy' : (y : G) ∈ ⁅X'.map P.subtype, P⁆ := by
        rw [← hcomm]
        exact Subgroup.mem_map_of_mem _ hy
      exact (a121_mem_centerOf_iff P X' y).2 (hcom hy')
    · exact Subtype.ext (hpow x (Subgroup.mem_map_of_mem _ hx))
    · have hx' : (x : G) ∈ P ⊓ ChA.centralizerOf (X'.map P.subtype) := by
        refine ⟨x.2, Subgroup.mem_centralizer_iff.2 ?_⟩
        rintro _ ⟨z, hz, rfl⟩
        exact congrArg Subtype.val (Subgroup.mem_centralizer_iff.1 hx z hz)
      have hxp' : orderOf (x : G) = p := by rwa [Subgroup.orderOf_coe]
      obtain ⟨z, hz, hzx⟩ := hord (x : G) hx' hxp'
      have : z = x := Subtype.ext hzx
      exact this ▸ hz
  · intro hX'
    refine ⟨Subgroup.map_subtype_le X', ?_, ?_, ?_, ?_, ?_⟩
    · rw [hsub]
      exact hX'.characteristic
    · rw [a121_frattiniOf_map]
      rintro _ ⟨y, hy, rfl⟩
      exact (a121_mem_centerOf_iff P X' y).1 (hX'.frattini_le hy)
    · intro z hz
      rw [← hcomm] at hz
      obtain ⟨y, hy, rfl⟩ := hz
      exact (a121_mem_centerOf_iff P X' y).1 (hX'.commutator_le hy)
    · rintro _ ⟨y, hy, rfl⟩
      exact congrArg Subtype.val (hX'.pow_eq_one y hy)
    · rintro x ⟨hxP, hxc⟩ hxp
      have hx'c : (⟨x, hxP⟩ : ↥P) ∈ Subgroup.centralizer (X' : Set ↥P) := by
        refine Subgroup.mem_centralizer_iff.2 fun z hz => Subtype.ext ?_
        exact Subgroup.mem_centralizer_iff.1 hxc (z : G) (Subgroup.mem_map_of_mem _ hz)
      have hxp' : orderOf (⟨x, hxP⟩ : ↥P) = p := by
        rw [← Subgroup.orderOf_coe]
        exact hxp
      exact Subgroup.mem_map_of_mem P.subtype (hX'.mem_of_orderOf_eq _ hx'c hxp')

private theorem a121_frattiniIn_conj_mem {P : Type*} [Group P] {X' : Subgroup P} {x w : P} (hx
    : x ∈ X')
    (hw : w ∈ CFSG.Quasithin.frattiniIn X') : x⁻¹ * w * x ∈ CFSG.Quasithin.frattiniIn X' := by
  obtain ⟨f, hf, rfl⟩ := hw
  have hf' : (⟨x, hx⟩ : ↥X')⁻¹ * f * ⟨x, hx⟩ ∈ frattini ↥X' :=
    (inferInstance : (frattini ↥X').Normal).conj_mem' f hf ⟨x, hx⟩
  exact ⟨_, hf', rfl⟩


