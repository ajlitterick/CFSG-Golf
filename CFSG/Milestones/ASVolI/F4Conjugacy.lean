section MapDatum

open CFSG.ASVolI.ChF

variable {G E : Type} [Group G] [Group E] (Φ : G ≃* E)

theorem burnsideF4gF4Inv_ctr_pCoreOf_map (M₁ M₂ : Subgroup G) :
    ctr (pCoreOf 2 (M₁.map Φ.toMonoidHom ⊓ M₂.map Φ.toMonoidHom)) =
      (ctr (pCoreOf 2 (M₁ ⊓ M₂))).map Φ.toMonoidHom := by
  rw [← Subgroup.map_inf _ _ _ Φ.injective,
    CFSG.LieType.BorelTits.pCoreOf_map_mulEquiv 2 Φ, burnsideF4gF4Inv_ctr_map]

theorem burnsideF4gF4Inv_Datum.map {M₁ M₂ L S : Subgroup G} {z t : G}
    (D : burnsideF4gF4Inv_Datum M₁ M₂ L S z t) :
    burnsideF4gF4Inv_Datum (M₁.map Φ.toMonoidHom) (M₂.map Φ.toMonoidHom) (L.map Φ.toMonoidHom)
      (S.map Φ.toMonoidHom) (Φ z) (Φ t) where
  z_ne h := D.z_ne (Φ.injective (by simpa using h))
  z_sq := by rw [← map_mul, D.z_sq, map_one]
  t_ne h := D.t_ne (Φ.injective (by simpa using h))
  t_sq := by rw [← map_mul, D.t_sq, map_one]
  cls := by
    intro x hx1 hx2
    obtain ⟨y, rfl⟩ := Φ.surjective x
    have hy1 : y ≠ 1 := fun h => hx1 (by rw [h, map_one])
    have hy2 : y * y = 1 := Φ.injective (by rw [map_mul, hx2, map_one])
    rcases D.cls y hy1 hy2 with h | h
    · exact Or.inl ((burnsideF4gF4Inv_isConj_map Φ).2 h)
    · exact Or.inr ((burnsideF4gF4Inv_isConj_map Φ).2 h)
  not_conj h := D.not_conj ((burnsideF4gF4Inv_isConj_map Φ).1 h)
  z_ctr := by
    rw [burnsideF4gF4Inv_ctr_pCoreOf_map]
    exact Subgroup.mem_map_of_mem _ D.z_ctr
  ctr_conj := by
    intro w hw hw1
    rw [burnsideF4gF4Inv_ctr_pCoreOf_map] at hw
    obtain ⟨w', hw', rfl⟩ := hw
    have : w' ≠ 1 := fun h => hw1 (by rw [h]; exact map_one _)
    exact (burnsideF4gF4Inv_isConj_map Φ).2 (D.ctr_conj w' hw' this)
  L_le := by
    rw [burnsideF4gF4Inv_ctr_pCoreOf_map]
    exact Subgroup.map_mono D.L_le
  z_L := Subgroup.mem_map_of_mem _ D.z_L
  t_S := Subgroup.mem_map_of_mem _ D.t_S
  S_conj := by
    intro y hy hy1
    obtain ⟨y', hy', rfl⟩ := hy
    have : y' ≠ 1 := fun h => hy1 (by rw [h]; exact map_one _)
    exact (burnsideF4gF4Inv_isConj_map Φ).2 (D.S_conj y' hy' this)
  oP := by
    rw [burnsideF4gF4Inv_oPPrime_map Φ, burnsideF4gF4Inv_centralizer_map Φ, D.oP]
  cz_le := by
    rw [burnsideF4gF4Inv_centralizer_map Φ]
    exact Subgroup.map_mono D.cz_le
  oP_ctr := by
    intro x hx hx1
    rw [burnsideF4gF4Inv_oPPrime_map Φ, burnsideF4gF4Inv_ctr_map] at hx
    obtain ⟨x', hx', rfl⟩ := hx
    have : x' ≠ 1 := fun h => hx1 (by rw [h]; exact map_one _)
    obtain ⟨h, hh, hhx⟩ := D.oP_ctr x' hx' this
    refine ⟨Φ h, Subgroup.mem_map_of_mem _ hh, ?_⟩
    show Φ h * Φ z * (Φ h)⁻¹ = Φ x'
    rw [← map_inv, ← map_mul, ← map_mul, hhx]
  t_core := by
    rw [CFSG.LieType.BorelTits.pCoreOf_map_mulEquiv 2 Φ]
    exact Subgroup.mem_map_of_mem _ D.t_core
  ct_le := by
    rw [burnsideF4gF4Inv_centralizer_map Φ]
    exact Subgroup.map_mono D.ct_le

end MapDatum

