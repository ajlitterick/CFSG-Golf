open CFSG.ASVolI.ChF

variable {G G' : Type} [Group G] [Group G']

theorem burnsideF4gD4Inv_map_centralizer_singleton (φ : G ≃* G') (x : G) :
    (Subgroup.centralizer ({x} : Set G)).map φ.toMonoidHom =
      Subgroup.centralizer ({φ x} : Set G') := by
  ext y
  rw [Subgroup.mem_map_equiv, Subgroup.mem_centralizer_singleton_iff,
    Subgroup.mem_centralizer_singleton_iff]
  constructor
  · intro h
    have := congrArg φ h
    simpa using this
  · intro h
    apply φ.injective
    simpa using h

theorem burnsideF4gD4Inv_map_ctr (φ : G ≃* G') (K : Subgroup G) :
    ctr (K.map φ.toMonoidHom) = (ctr K).map φ.toMonoidHom := by
  ext y
  constructor
  · rintro ⟨⟨x, hxK, rfl⟩, hy⟩
    refine ⟨x, ⟨hxK, Subgroup.mem_centralizer_iff.2 fun k hk => ?_⟩, rfl⟩
    have h := Subgroup.mem_centralizer_iff.1 hy (φ k) ⟨k, hk, rfl⟩
    apply φ.injective
