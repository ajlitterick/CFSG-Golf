section Abstract

open CFSG.ASVolI.ChF

variable {E : Type} [Group E]


structure burnsideF4gF4Inv_Datum (M₁ M₂ L S : Subgroup E) (z t : E) : Prop where
  z_ne : z ≠ 1
  z_sq : z * z = 1
  t_ne : t ≠ 1
  t_sq : t * t = 1
  cls : ∀ x : E, x ≠ 1 → x * x = 1 → IsConj z x ∨ IsConj t x
  not_conj : ¬ IsConj z t
  z_ctr : z ∈ ctr (pCoreOf 2 (M₁ ⊓ M₂))
  ctr_conj : ∀ w ∈ ctr (pCoreOf 2 (M₁ ⊓ M₂)), w ≠ 1 → IsConj z w
  L_le : L ≤ ctr (pCoreOf 2 (M₁ ⊓ M₂))
  z_L : z ∈ L
  t_S : t ∈ S
  S_conj : ∀ y ∈ S, y ≠ 1 → IsConj t y
  oP : oPPrime 2 M₁ = Subgroup.centralizer ({z} : Set E)
  cz_le : Subgroup.centralizer ({z} : Set E) ≤ M₁
  oP_ctr : ∀ x ∈ ctr (oPPrime 2 M₁), x ≠ 1 → ∃ h ∈ M₁, h * z * h⁻¹ = x
  t_core : t ∈ pCoreOf 2 M₂
  ct_le : Subgroup.centralizer ({t} : Set E) ≤ M₂


theorem burnsideF4gF4Inv_oPPrime_map {A B : Type} [Group A] [Group B] (e : A ≃* B) (p : ℕ)
    (X : Subgroup A) : oPPrime p (X.map e.toMonoidHom) = (oPPrime p X).map e.toMonoidHom := by
  unfold oPPrime
  rw [MonoidHom.map_closure]
  congr 1
  ext y
  constructor
  · rintro ⟨⟨x, hx, rfl⟩, k, hk⟩
    exact ⟨x, ⟨hx, k, by rwa [orderOf_injective e.toMonoidHom e.injective x] at hk⟩, rfl⟩
  · rintro ⟨x, ⟨hx, k, hk⟩, rfl⟩
    exact ⟨⟨x, hx, rfl⟩, k, by rw [orderOf_injective e.toMonoidHom e.injective x]; exact hk⟩

theorem burnsideF4gF4Inv_ctr_map {A B : Type} [Group A] [Group B] (e : A ≃* B) (X : Subgroup A) :
    ctr (X.map e.toMonoidHom) = (ctr X).map e.toMonoidHom := by
  ext y
  obtain ⟨x, rfl⟩ := e.surjective y
  simp only [ctr, Subgroup.mem_inf, Subgroup.mem_map, Subgroup.mem_centralizer_iff]
  constructor
  · rintro ⟨⟨x', hx', hx'e⟩, hc⟩
    have hx : x' = x := e.injective hx'e
    subst hx
    refine ⟨x', ⟨hx', fun g hg => ?_⟩, rfl⟩
    have := hc (e g) ⟨g, hg, rfl⟩
    exact e.injective (by simpa using this)
  · rintro ⟨x', ⟨hx', hc⟩, hx'e⟩
    have hx : x' = x := e.injective hx'e
    subst hx
    refine ⟨⟨x', hx', rfl⟩, ?_⟩
    rintro _ ⟨g, hg, rfl⟩
    have := hc g hg
    simpa using congrArg e this

theorem burnsideF4gF4Inv_centralizer_map {A B : Type} [Group A] [Group B] (e : A ≃* B) (a : A) :
    Subgroup.centralizer ({e a} : Set B) = (Subgroup.centralizer ({a} : Set A)).map e.toMonoidHom := by
  ext y
  obtain ⟨x, rfl⟩ := e.surjective y
  simp only [Subgroup.mem_centralizer_iff, Set.mem_singleton_iff, forall_eq, Subgroup.mem_map]
  constructor
  · intro h
    refine ⟨x, ?_, rfl⟩
    have : e a * e x = e x * e a := h
    exact e.injective (by simpa using this)
  · rintro ⟨x', hx', hx'e⟩
    have hx : x' = x := e.injective hx'e
    subst hx
    have : a * x' = x' * a := hx'
    simpa using congrArg e this

theorem burnsideF4gF4Inv_isConj_map {A B : Type} [Group A] [Group B] (e : A ≃* B) {a b : A} :
    IsConj (e a) (e b) ↔ IsConj a b :=
  ⟨fun h => by simpa using e.symm.toMonoidHom.map_isConj h,
    fun h => e.toMonoidHom.map_isConj h⟩

end Abstract

