theorem _root_.CFSG.Milestones.cfsg_classification
    (G : Type) [Group G] [Finite G] [IsSimpleGroup G] :
    ∃ i : TauCeti.CFSGIndex, Nonempty (G ≃* i.Group) :=
  _root_.CFSG.classification_finite_simple_groups G

