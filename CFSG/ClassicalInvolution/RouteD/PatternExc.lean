theorem patternLemma_E7 : PatternLemma ((CartanMatrix.E 7).transpose) := by
  intro v hv
  have hvec : v = ![v 0, v 1, v 2, v 3, v 4, v 5, v 6] := by
    funext i; fin_cases i <;> rfl
  have hnz : ¬ (v 0 = 0 ∧ v 1 = 0 ∧ v 2 = 0 ∧ v 3 = 0 ∧ v 4 = 0 ∧ v 5 = 0 ∧ v 6 = 0) := by
    rintro ⟨h0, h1, h2, h3, h4, h5, h6⟩
    apply hv
    funext i
    fin_cases i <;> simp [h0, h1, h2, h3, h4, h5, h6]
  obtain ⟨j, hj⟩ := check_E7 (v 0) (v 1) (v 2) (v 3) (v 4) (v 5) (v 6) hnz
  have hreach := charReach_reflW ((CartanMatrix.E 7).transpose) ((tableE7).getD (1 * (v 0).val + 2 * (v 1).val + 4 * (v 2).val + 8 * (v 3).val + 16 * (v 4).val + 32 * (v 5).val + 64 * (v 6).val - 1) []) v
  rw [entZ_E7] at hreach
  exact ⟨_, hreach, j, (congrArg (reflW aE7 ((tableE7).getD (1 * (v 0).val + 2 * (v 1).val + 4 * (v 2).val + 8 * (v 3).val + 16 * (v 4).val + 32 * (v 5).val + 64 * (v 6).val - 1) [])) hvec).trans hj⟩

