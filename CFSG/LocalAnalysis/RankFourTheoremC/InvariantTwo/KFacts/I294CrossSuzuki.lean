open CFSG.Open Subgroup

section Suzuki


theorem crossSylowAbelianAt_suzuki {m : ℕ} (hv : (TauCeti.LieTypeIndex.suzuki m).Valid) :
    CrossSylowAbelianAt ⟨.suzuki m, hv⟩ := by
  intro p hp hp5 hdp L _ _ hs ⟨e⟩ P
  haveI : Fact p.Prime := ⟨hp⟩
  obtain ⟨-, a, ha, K, _, _, hf, hcard, ⟨e'⟩⟩ :=
    CFSG.HardMathSupport.Cooperstein.Coordinator.suzukiModel_of_lie hv e
  have hcard' : Nat.card K = 2 ^ (2 * a + 1) := by rw [hcard, hf]
  let eS : L ≃* Sz a := e'.trans
    ((MulEquiv.subgroupCongr (CFSG.LieType.BorelTits.suzukiGroup_eq_glaSzGroup a K)).trans
      (CFSG.ShultStronglyClosedTI.glaSzEquivNative a ha hcard'))
  exact isMulCommutative_sylow_of_mulEquiv_isCyclic eS
    (fun R => CFSG.SignalizerFunctorTheorem.McBride.SzModel.sz_oddSylow_isCyclic
      (by omega) R) P

theorem crossAt_suzuki {m : ℕ} (hv : (TauCeti.LieTypeIndex.suzuki m).Valid) :
    CrossAt ⟨.suzuki m, hv⟩ :=
  crossAt_of_sylowAbelian (crossSylowAbelianAt_suzuki hv)

end Suzuki

end CFSG.LocalAnalysis.RankFourTheoremC
