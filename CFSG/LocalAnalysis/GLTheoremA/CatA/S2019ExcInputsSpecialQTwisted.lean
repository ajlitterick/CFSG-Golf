theorem hasS2019SpecialQ_derivedCentralQuotient_of_sl3 {M : Type} [Group M] (H : Subgroup M)
    {k : Type} [Field k] [Finite k] {q : ℕ} (hq : q.Prime) (hq2 : q ≠ 2) [CharP k q]
    (ρ : Matrix.SpecialLinearGroup (Fin 3) k →* M) (hρ : Function.Injective ρ)
    (hH : ∀ g, ρ g ∈ H) : HasS2019SpecialQ q (Nat.card k) (DerivedCentralQuotient H) := by
  haveI : Group.IsPerfect (Matrix.SpecialLinearGroup (Fin 3) k) :=
    CFSG.ClassicalModels.specialLinear_isPerfect_of_three_le le_rfl
  have hmem : ∀ g, ρ g ∈ ⁅H, H⁆ := fun g => by
    have hg : g ∈ commutator (Matrix.SpecialLinearGroup (Fin 3) k) :=
      Group.IsPerfect.mem_commutator
    have hle : (commutator (Matrix.SpecialLinearGroup (Fin 3) k)).map ρ ≤ ⁅H, H⁆ := by
      rw [_root_.commutator_def, Subgroup.map_commutator]
      apply Subgroup.commutator_mono <;>
      · rintro _ ⟨y, -, rfl⟩
        exact hH y
    exact hle ⟨g, hg, rfl⟩
  exact hasS2019SpecialQ_quotient_center_of_sl3 hq hq2 (ρ.codRestrict _ hmem)
    fun a b h => hρ (congrArg Subtype.val h)

private theorem card_eqLocusField_twist (t : TwistTag) {p f : ℕ} (hp : p.Prime) (hf : 1 ≤ f)
    {K : Type} [Field K] (hK : Nat.card K = (p ^ f) ^ t.order) {σ : K →+* K}
    (hσ : ∀ c, σ c = c ^ (p ^ f)) : Nat.card (RingHom.eqLocusField σ (RingHom.id K)) = p ^ f := by
  obtain ⟨-, -, -, -, -, k, hk, hkcard, -⟩ := finite_graph_field_parameter_fields t hp hf K hK
  have e : RingHom.eqLocusField σ (RingHom.id K) = k := by
    ext c
    rw [RingHom.mem_eqLocusField, RingHom.id_apply, hσ, ← SetLike.mem_coe, hk]
    rfl
  rw [e, hkcard]


variable {K : Type} [Field K] [Finite K]

theorem hasS2019SpecialQ_twistedE6 {p f : ℕ} (hp : p.Prime) (hp2 : p ≠ 2) (hf : 1 ≤ f)
    (hK : Nat.card K = (p ^ f) ^ TwistTag.E6.order) (σ : K →+* K)
    (hσ : ∀ c, σ c = c ^ (p ^ f)) :
    HasS2019SpecialQ p (p ^ f) (DerivedCentralQuotient (twistedFixedGroup .E6 K σ)) := by
  set k : Subfield K := RingHom.eqLocusField σ (RingHom.id K) with hkdef
  have hk : Nat.card k = p ^ f := card_eqLocusField_twist .E6 hp hf hK hσ
  haveI : CharP k p :=
    CFSG.LocalAnalysis.ComponentInitial.finite_field_prime_power_characteristic hp hf hk
  have hfix : ∀ c : k, σ (algebraMap k K c) = algebraMap k K c := fun c => c.2
  obtain ⟨ρ₁, hρ₁, -⟩ := CFSG.ClassicalInvolution.ModelFacts.Levi.exists_sl3_simple_F4 k
  let ρ : Matrix.SpecialLinearGroup (Fin 3) k →* ModGL TwistTag.E6.tag K :=
    (baseChangeGL (algebraMap k K)).comp
      ((twistedFixedGroup TwistTag.E6 k (RingHom.id k)).subtype.comp
        ((CFSG.HardMathSupport.Lang.AnisoE6.e6FixedF4EquivAll k).symm.toMonoidHom.comp ρ₁))
  have hρ : Function.Injective ρ := by
    intro a b hab
    simp only [ρ, MonoidHom.comp_apply, Subgroup.coe_subtype, MulEquiv.coe_toMonoidHom] at hab
    exact hρ₁ ((MulEquiv.injective _) (Subtype.val_injective (baseChangeGL_injective _ hab)))
  have hH : ∀ g, ρ g ∈ twistedFixedGroup TwistTag.E6 K σ := fun g =>
    graphFixedRootGroup_le _ _ _ (map_baseChangeGL_le_graphFixedRootGroup hfix
      ⟨_, ((CFSG.HardMathSupport.Lang.AnisoE6.e6FixedF4EquivAll k).symm (ρ₁ g)).2, rfl⟩)
  rw [← hk]
  exact hasS2019SpecialQ_derivedCentralQuotient_of_sl3 _ hp hp2 ρ hρ hH

theorem hasS2019SpecialQ_trialityD4 {p f : ℕ} (hp : p.Prime) (hp2 : p ≠ 2) (hf : 1 ≤ f)
    (hK : Nat.card K = (p ^ f) ^ TwistTag.D4.order) (σ : K →+* K)
    (hσ : ∀ c, σ c = c ^ (p ^ f)) :
    HasS2019SpecialQ p (p ^ f) (DerivedCentralQuotient (twistedFixedGroup .D4 K σ)) := by
  set σ' : K ≃+* K :=
    RingEquiv.ofBijective σ ⟨σ.injective, Finite.surjective_of_injective σ.injective⟩ with hσ'def
  have hσσ : σ'.toRingHom = σ := RingHom.ext fun _ => rfl
  have hk : Nat.card (fixSubfield σ') = p ^ f :=
    card_eqLocusField_twist .D4 hp hf hK (σ := σ'.toRingHom) hσ
  haveI : CharP (fixSubfield σ') p :=
    CFSG.LocalAnalysis.ComponentInitial.finite_field_prime_power_characteristic hp hf hk
  have h3 : (3 : ℕ∞) ≤ ENat.card (fixSubfield σ') := by
    rw [ENat.card_eq_coe_natCard, hk]
    have : 3 ≤ p ^ f := le_trans (Nat.Prime.two_le hp |>.lt_of_ne (Ne.symm hp2))
      (Nat.le_self_pow (by omega) p)
    exact_mod_cast this
  obtain ⟨ρ₁, hρ₁, -⟩ :=
    CFSG.GH74.GLS.Stage2.Bender.Thm1.exists_a2Hom_injective (K := fixSubfield σ')
  let ρ : Matrix.SpecialLinearGroup (Fin 3) (fixSubfield σ') →* ModGL TwistTag.D4.tag K :=
    (graphFixedRootGroup TwistTag.D4 K σ'.toRingHom).subtype.comp
      ((CFSG.RankThree.PartTwo.KFacts.trialityFixIncl σ').comp
        ((CFSG.HardMathSupport.Seitz.TrialityOdd.Inner.d4FixedG2EquivAll (fixSubfield σ')
          h3).symm.toMonoidHom.comp ρ₁))
  have hρ : Function.Injective ρ := by
    intro a b hab
    simp only [ρ, MonoidHom.comp_apply, Subgroup.coe_subtype, MulEquiv.coe_toMonoidHom] at hab
    exact hρ₁ ((MulEquiv.injective _)
      (CFSG.RankThree.PartTwo.KFacts.trialityFixIncl_injective σ' (Subtype.val_injective hab)))
  have hH : ∀ g, ρ g ∈ twistedFixedGroup TwistTag.D4 K σ := fun g => by
    rw [← hσσ]
    exact graphFixedRootGroup_le _ _ _ (Subtype.mem _)
  rw [← hk]
  exact hasS2019SpecialQ_derivedCentralQuotient_of_sl3 _ hp hp2 ρ hρ hH

