open CFSG.Blueprint CFSG.Blueprint.Chevalley

variable {K : Type} [Field K] [Finite K]


theorem hasS2019SpecialQ_adjointQuotient {τ : Tag}
    (hτ : τ = .G2 ∨ τ = .F4 ∨ τ = .E6 ∨ τ = .E7 ∨ τ = .E8) {q : ℕ} (hq : q.Prime) (hq2 : q ≠ 2)
    [CharP K q] : HasS2019SpecialQ q (Nat.card K) (AdjointQuotient τ K) := by
  rcases hτ with rfl | rfl | rfl | rfl | rfl
  · obtain ⟨ρ, hρ, -⟩ := CFSG.GH74.GLS.Stage2.Bender.Thm1.exists_a2Hom_injective (K := K)
    exact hasS2019SpecialQ_quotient_center_of_sl3 hq hq2 ρ hρ
  · obtain ⟨ρ, hρ, -⟩ := CFSG.ClassicalInvolution.ModelFacts.Levi.exists_sl3_simple_F4 K
    exact hasS2019SpecialQ_quotient_center_of_sl3 hq hq2 ρ hρ
  · obtain ⟨ρ, hρ, -⟩ := CFSG.ClassicalInvolution.ModelFacts.Levi.exists_sl3_simple_E6 K
    exact hasS2019SpecialQ_quotient_center_of_sl3 hq hq2 ρ hρ
  · obtain ⟨ρ, hρ, -⟩ := CFSG.ClassicalInvolution.ModelFacts.Levi.exists_sl3_simple_E7 K
    exact hasS2019SpecialQ_quotient_center_of_sl3 hq hq2 ρ hρ
  · obtain ⟨ρ, hρ, -⟩ := CFSG.ClassicalInvolution.ModelFacts.Levi.exists_sl3_simple_E8 K
    exact hasS2019SpecialQ_quotient_center_of_sl3 hq hq2 ρ hρ

end CFSG.LocalAnalysis.GLTheoremA.S2019
