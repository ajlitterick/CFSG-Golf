theorem exists_componentWeylGroup_smul_eq_of_mem
    {τ : Tag} (hτ : SimplyLacedTag τ) {Ψ : Set (Fin τ.rank → ℤ)}
    (hΨ : IsRootComponent Ψ) {α β : Fin τ.rank → ℤ} (hα : α ∈ Ψ) (hβ : β ∈ Ψ) :
    ∃ w ∈ Subgroup.closure {s : WeylGroup τ | ∃ γ ∈ Ψ, s = rootReflection γ}, w • α = β := by
  classical
  set T : Subgroup (WeylGroup τ) :=
    Subgroup.closure {s : WeylGroup τ | ∃ γ ∈ Ψ, s = rootReflection γ} with hT
  have hsub : componentWeylGroup Ψ ≤ T := by
    rw [componentWeylGroup, hT]
    exact Subgroup.closure_mono fun s hs => by
      obtain ⟨γ, hγ, rfl⟩ := hs
      exact ⟨γ, simpleRoots_subset hγ, rfl⟩
  obtain ⟨w₁, hw₁, δ₁, hδ₁, e₁⟩ := exists_smul_simpleRoot hΨ hα
  obtain ⟨w₂, hw₂, δ₂, hδ₂, e₂⟩ := exists_smul_simpleRoot hΨ hβ
  have hchain : ∀ {γ δ : Fin τ.rank → ℤ}, Relation.ReflTransGen (SimpleAdj Ψ) γ δ →
      ∃ u ∈ T, u • γ = δ := by
    intro γ δ h
    induction h with
    | refl => exact ⟨1, one_mem T, one_smul _ γ⟩
    | tail _ hstep ih =>
      obtain ⟨u, hu, huγ⟩ := ih
      obtain ⟨ha, hb, hab⟩ := hstep
      obtain ⟨v, hv, hva⟩ :=
        exists_weyl_smul_eq_of_iform_ne_zero hτ (simpleRoots_subset ha) (simpleRoots_subset hb)
          (simpleRoots_isRoot ha) (simpleRoots_isRoot hb) hab
      exact ⟨v * u, mul_mem hv hu, by rw [mul_smul, huγ, hva]⟩
  obtain ⟨u, hu, hu₁⟩ := hchain (simpleRoots_connected hΨ hδ₁ hδ₂)
  refine ⟨w₂ * u * w₁⁻¹, mul_mem (mul_mem (hsub hw₂) hu) (inv_mem (hsub hw₁)), ?_⟩
  rw [mul_smul, mul_smul, e₁, inv_smul_smul, hu₁, e₂]

end CFSG.StandardType.LangRat

