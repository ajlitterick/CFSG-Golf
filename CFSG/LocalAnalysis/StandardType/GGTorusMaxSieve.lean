theorem tmSieve_E7 (hLie : TmLieOutAll) (hSpor : TmSporadicOutInput) (hLieOrd : LieOrderBridge)
    (hSporOrd : SporadicOrdersTable) (J : Type) [Group J] [Finite J] (hJ : InCatalog J)
    (hnonab : ∃ a b : J, a * b ≠ b * a) (hdvd : Nat.card J ∣ orderE7 2)
    (hlt : Nat.card J < orderE7 2) (hM : 3 ^ 7 * 2903040 ∣ Nat.card (MulAut J)) :
    ∃ (d : TauCeti.ValidLieTypeIndex) (q : TauCeti.PrimePower), d.1 = .twistedA 8 q ∧
      q.card = 2 ∧ Nonempty (J ≃* (TauCeti.CFSGIndex.lie d).Group) := by
  obtain ⟨i, ⟨e⟩⟩ := hJ
  have h311 : 3 ^ 11 ∣ Nat.card (MulAut J) :=
    dvd_trans (by norm_num : 3 ^ 11 ∣ 3 ^ 7 * 2903040) hM
  cases i with
  | cyclic p hp =>
      obtain ⟨a, b, hab⟩ := hnonab
      exact absurd (e.injective (by rw [map_mul, map_mul, mul_comm])) hab
  | alternating c hc =>
      exact (tmSieve_alt_contra hc e (by norm_num [orderE7]) hdvd (by norm_num) h311).elim
  | sporadic s =>
      exact (tmSieve_spor_contra7 s e hSpor hSporOrd hdvd h311).elim
  | lie d => exact tmSieve_lie_E7 d J e hLie hLieOrd hdvd hlt hM

theorem tmSieve_E8 (hLie : TmLieOutAll) (hSpor : TmSporadicOutInput) (hLieOrd : LieOrderBridge)
    (hSporOrd : SporadicOrdersTable) (J : Type) [Group J] [Finite J] (hJ : InCatalog J)
    (hnonab : ∃ a b : J, a * b ≠ b * a) (hdvd : Nat.card J ∣ orderE8 2)
    (hlt : Nat.card J < orderE8 2) (hM : 3 ^ 8 * 696729600 ∣ Nat.card (MulAut J)) :
    (∃ (d : TauCeti.ValidLieTypeIndex) (q : TauCeti.PrimePower), d.1 = .twistedA 9 q ∧
        q.card = 2 ∧ Nonempty (J ≃* (TauCeti.CFSGIndex.lie d).Group)) ∨
      (∃ (d : TauCeti.ValidLieTypeIndex) (q : TauCeti.PrimePower), d.1 = .D 4 q ∧
        q.card = 3 ∧ Nonempty (J ≃* (TauCeti.CFSGIndex.lie d).Group)) := by
  obtain ⟨i, ⟨e⟩⟩ := hJ
  have h313 : 3 ^ 13 ∣ Nat.card (MulAut J) :=
    dvd_trans (by norm_num : 3 ^ 13 ∣ 3 ^ 8 * 696729600) hM
  cases i with
  | cyclic p hp =>
      obtain ⟨a, b, hab⟩ := hnonab
      exact absurd (e.injective (by rw [map_mul, map_mul, mul_comm])) hab
  | alternating c hc =>
      exact (tmSieve_alt_contra hc e (by norm_num [orderE8]) hdvd (by norm_num) h313).elim
  | sporadic s =>
      exact (tmSieve_spor_contra8 s e hSpor hSporOrd hdvd h313).elim
  | lie d => exact tmSieve_lie_E8 d J e hLie hLieOrd hdvd hlt hM

