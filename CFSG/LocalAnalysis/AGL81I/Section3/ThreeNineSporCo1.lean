    refine mem_inner_of_lieModel hJlie (by simp) hr hr2 (by simp) (by simp) hr.not_dvd_one ?_ hα
    rw [lieOrderDivisor_psp_two_five]
    exact fun h => hr2 ((Nat.prime_dvd_prime_iff_eq hr Nat.prime_two).1 h)
  exact false_of_psp h hJY hJn hJC hJcard e hEab.2 hEcard h13 hinner

