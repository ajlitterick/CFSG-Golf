private theorem five_pow_four_dvd_card {L : Type} [Group L] [Finite L]
    {d : ℕ} {Y J : Subgroup L} (h : SporOvergroupData L 5 d Y) (hJY : J ≤ Y)
    (hJn : (J.subgroupOf Y).Normal) (hJC : Subgroup.centralizer (J : Set L) ⊓ Y = ⊥)
    (hinn5 : ∀ α : MulAut ↥J, α ^ 5 = 1 →
      α ∈ CFSG.ComponentClassification.OuterAutomorphisms.inner ↥J)
    {g₁ g₂ : L} (hg₁ : g₁ ^ 5 = 1) (hg₂ : g₂ ^ 5 = 1)
    (hFcard : Nat.card (Subgroup.closure ({g₁, g₂} : Set L)) = 5 ^ 4) :
    5 ^ 4 ∣ Nat.card ↥J := by
  have hFp : IsPGroup 5 (Subgroup.closure ({g₁, g₂} : Set L)) :=
    IsPGroup.of_card (n := 4) hFcard
  obtain ⟨Q, hQY⟩ := exists_sylow_le_of_data h
  obtain ⟨F', hF'Y, hF'card, h₁', h₂', h₁'5, h₂'5, hF'gen⟩ :=
    exists_conj_generators_of_sylow hQY hFp hg₁ hg₂ rfl
  have hF'J : F' ≤ J := by
    have h₁'J : h₁' ∈ J :=
      mem_of_pow_eq_one_of_inner hJY hJn hJC hinn5 (hF'Y (by
        rw [hF'gen]
        exact Subgroup.subset_closure (Set.mem_insert _ _))) h₁'5
    have h₂'J : h₂' ∈ J :=
      mem_of_pow_eq_one_of_inner hJY hJn hJC hinn5 (hF'Y (by
        rw [hF'gen]
        exact Subgroup.subset_closure (Set.mem_insert_of_mem _ rfl))) h₂'5
    rw [hF'gen, Subgroup.closure_le]
    intro x hx
    rw [Set.mem_insert_iff, Set.mem_singleton_iff] at hx
    rcases hx with rfl | rfl
    · exact h₁'J
    · exact h₂'J
  rw [← hFcard, ← hF'card]
  exact Subgroup.card_dvd_of_le hF'J

end Co1Aux

