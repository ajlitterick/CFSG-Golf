private theorem exists_conj_generators_of_sylow {L : Type} [Group L] [Finite L] {p : ℕ}
    [Fact p.Prime] {Y : Subgroup L} {Q : Sylow p L} (hQY : (Q : Subgroup L) ≤ Y)
    {F : Subgroup L} (hF : IsPGroup p F) {g₁ g₂ : L} (h₁ : g₁ ^ p = 1) (h₂ : g₂ ^ p = 1)
    (hgen : F = Subgroup.closure ({g₁, g₂} : Set L)) :
    ∃ F' : Subgroup L, F' ≤ Y ∧ Nat.card F' = Nat.card F ∧
      ∃ h₁' h₂' : L, h₁' ^ p = 1 ∧ h₂' ^ p = 1 ∧
        F' = Subgroup.closure ({h₁', h₂'} : Set L) := by
  obtain ⟨Q', hFQ'⟩ := hF.exists_le_sylow
  obtain ⟨g, hg⟩ := MulAction.exists_smul_eq L Q' Q
  have hmap : (Q : Subgroup L) = (Q' : Subgroup L).map (MulAut.conj g).toMonoidHom := by
    rw [← hg, Sylow.coe_subgroup_smul, Subgroup.pointwise_smul_def]
    rfl
  refine ⟨F.map (MulAut.conj g).toMonoidHom, (Subgroup.map_mono hFQ').trans (hmap ▸ hQY),
    Subgroup.card_map_of_injective (MulAut.conj g).injective, ?_⟩
  refine ⟨(MulAut.conj g).toMonoidHom g₁, (MulAut.conj g).toMonoidHom g₂, ?_, ?_, ?_⟩
  · rw [← map_pow, h₁, map_one]
  · rw [← map_pow, h₂, map_one]
  · rw [hgen, MonoidHom.map_closure, Set.image_pair]

private theorem mem_of_pow_eq_one_of_inner {L : Type} [Group L] [Finite L] {Y J : Subgroup L}
    (hJY : J ≤ Y) (hJn : (J.subgroupOf Y).Normal)
    (hC : Subgroup.centralizer (J : Set L) ⊓ Y = ⊥) {r : ℕ}
    (hinn : ∀ α : MulAut ↥J, α ^ r = 1 →
      α ∈ CFSG.ComponentClassification.OuterAutomorphisms.inner ↥J)
    {x : L} (hxY : x ∈ Y) (hx : x ^ r = 1) : x ∈ J := by
  have hsub : Subgroup.closure ({x} : Set L) ≤ J :=
    closure_le_of_pow_eq_one hJY hJn hC hinn (S := {x}) (by simpa using hxY)
      (by intro y hy; rw [Set.mem_singleton_iff] at hy; subst hy; exact hx)
  exact hsub (Subgroup.subset_closure (Set.mem_singleton x))

private theorem le_of_pow_eq_one_of_inner {L : Type} [Group L] [Finite L] {Y J E : Subgroup L}
    (hEY : E ≤ Y) (hJY : J ≤ Y) (hJn : (J.subgroupOf Y).Normal)
    (hC : Subgroup.centralizer (J : Set L) ⊓ Y = ⊥) {r : ℕ}
    (hinn : ∀ α : MulAut ↥J, α ^ r = 1 →
      α ∈ CFSG.ComponentClassification.OuterAutomorphisms.inner ↥J)
    (hE : ∀ x ∈ E, x ^ r = 1) : E ≤ J := by
  rw [← Subgroup.closure_eq E]
  exact closure_le_of_pow_eq_one hJY hJn hC hinn hEY hE

private theorem false_of_count_thirteen {n m : ℕ} (hndvd : n ∣ 1872) (h39 : 39 ∣ n)
    (hmul : n * m = 4680000) (hm : m % 13 = 1) : False := by
  obtain ⟨k, rfl⟩ := h39
  have hk48 : k ∣ 48 := by
    have h2 : 39 * k ∣ 39 * 48 := by
      simpa [show (39 : ℕ) * 48 = 1872 from by norm_num] using hndvd
    exact (Nat.mul_dvd_mul_iff_left (by norm_num : 0 < 39)).1 h2
  have hkpos : 0 < k := Nat.pos_of_dvd_of_pos hk48 (by norm_num)
  have hkmul : k * m = 120000 := by
    have h2 : 39 * (k * m) = 39 * 120000 := by
      rw [show (39 : ℕ) * 120000 = 4680000 from by norm_num, ← hmul]
      ring
    exact Nat.mul_left_cancel (by norm_num : 0 < 39) h2
  have hmk : m = 120000 / k := Nat.eq_div_of_mul_eq_right hkpos.ne' hkmul
  have hkle : k ≤ 48 := Nat.le_of_dvd (by norm_num) hk48
  interval_cases k <;> (rw [hmk] at hm; norm_num at hm; try norm_num at hk48)

private theorem false_of_d_eq_three {L : Type} [Group L] [Finite L] (e : L ≃* Carrier .Co1)
    {E : Subgroup CFSG.Blueprint.NativeSporadic.Co1} (hEexp : ∀ x ∈ E, x ^ 3 = 1)
    (hEcard : Nat.card E = 3 ^ 4)
    {Y J D : Subgroup L} (hJY : J ≤ Y) (hJn : (J.subgroupOf Y).Normal)
    (hC : Subgroup.centralizer (J : Set L) ⊓ Y = ⊥)
    (hinn : ∀ α : MulAut ↥J, α ^ 3 = 1 →
      α ∈ CFSG.ComponentClassification.OuterAutomorphisms.inner ↥J)
    (hDsyl : CFSG.ABGLocalTools.IsSylowOf 3 D ⊤) (hDY : D ≤ Y)
    (hJcard : Nat.card ↥J = 4680000) : False := by
  have : Fact (Nat.Prime 3) := ⟨by norm_num⟩
  have hE'card : Nat.card (Subgroup.map (e.symm).toMonoidHom E) = 3 ^ 4 := by
    rw [show Nat.card (Subgroup.map (e.symm).toMonoidHom E) = Nat.card E from
      Subgroup.card_map_of_injective (e.symm).injective]
    exact hEcard
  have hE'pg : IsPGroup 3 (Subgroup.map (e.symm).toMonoidHom E) :=
    IsPGroup.of_card (n := 4) hE'card
  obtain ⟨c, -, hcE⟩ := CFSG.GH72.exists_mem_map_conj_le_of_isSylowOf hDsyl le_top hE'pg
  have hE''Y : Subgroup.map (MulAut.conj c).toMonoidHom
      (Subgroup.map (e.symm).toMonoidHom E) ≤ Y := hcE.trans hDY
  have hE''exp : ∀ x ∈ Subgroup.map (MulAut.conj c).toMonoidHom
      (Subgroup.map (e.symm).toMonoidHom E), x ^ 3 = 1 := by
    intro x hx
    obtain ⟨y, hy, rfl⟩ := Subgroup.mem_map.mp hx
    obtain ⟨z, hz, rfl⟩ := Subgroup.mem_map.mp hy
    have hz3 : z ^ 3 = 1 := hEexp z hz
    show ((MulAut.conj c).toMonoidHom ((e.symm).toMonoidHom z)) ^ 3 = 1
    rw [← MonoidHom.map_pow, ← MonoidHom.map_pow, hz3, MonoidHom.map_one,
      MonoidHom.map_one]
  have hE''J : Subgroup.map (MulAut.conj c).toMonoidHom
      (Subgroup.map (e.symm).toMonoidHom E) ≤ J :=
    le_of_pow_eq_one_of_inner hE''Y hJY hJn hC hinn hE''exp
  have hE''card : Nat.card (Subgroup.map (MulAut.conj c).toMonoidHom
      (Subgroup.map (e.symm).toMonoidHom E)) = 3 ^ 4 := by
    rw [show Nat.card (Subgroup.map (MulAut.conj c).toMonoidHom
        (Subgroup.map (e.symm).toMonoidHom E))
        = Nat.card (Subgroup.map (e.symm).toMonoidHom E) from
      Subgroup.card_map_of_injective (MulAut.conj c).injective]
    exact hE'card
  have h3dvd : 3 ^ 4 ∣ Nat.card ↥J := by
    rw [← hE''card]
    exact Subgroup.card_dvd_of_le hE''J
  rw [hJcard] at h3dvd
  norm_num at h3dvd

private theorem card_centralizer_zpowers_dvd {L : Type} [Group L] [Finite L] {J : Subgroup L}
    {x : L} (hxJ : x ∈ J) :
    Nat.card (Subgroup.centralizer (Subgroup.zpowers (⟨x, hxJ⟩ : ↥J) : Set ↥J)) ∣
      Nat.card (Subgroup.centralizer ({x} : Set L)) := by
  have hmap : (Subgroup.centralizer
      (Subgroup.zpowers (⟨x, hxJ⟩ : ↥J) : Set ↥J)).map J.subtype ≤
      Subgroup.centralizer ({x} : Set L) := by
    rintro - ⟨c, hc, rfl⟩
    rw [Subgroup.mem_centralizer_singleton_iff]
    have hmem : (⟨x, hxJ⟩ : ↥J) ∈ Subgroup.zpowers (⟨x, hxJ⟩ : ↥J) :=
      Subgroup.mem_zpowers _
    have hcx := Subgroup.mem_centralizer_iff.mp hc (⟨x, hxJ⟩ : ↥J) hmem
    simpa using (congrArg Subtype.val hcx).symm
  rw [← Subgroup.card_map_of_injective (f := J.subtype) J.subtype_injective]
  exact Subgroup.card_dvd_of_le hmap

private theorem card_normalizer_dvd_1872 {L : Type} [Group L] [Finite L] {J : Subgroup L} {x : L}
    (hxJ : x ∈ J) (hx13 : orderOf x = 13)
    (hCLcard : Nat.card (Subgroup.centralizer ({x} : Set L)) = 156) :
    Nat.card (Subgroup.normalizer
      (Subgroup.zpowers (⟨x, hxJ⟩ : ↥J) : Set ↥J)) ∣ 1872 := by
  have hxord : orderOf (⟨x, hxJ⟩ : ↥J) = 13 := by
    rw [← Subgroup.orderOf_coe (⟨x, hxJ⟩ : ↥J)]
    exact hx13
  have : IsCyclic (Subgroup.zpowers (⟨x, hxJ⟩ : ↥J)) :=
    Subgroup.isCyclic_zpowers (⟨x, hxJ⟩ : ↥J)
  obtain ⟨r, hrdvd, hcardN⟩ :=
    CFSG.Quasithin.RuType.exists_card_normalizer (G := ↥J)
      (Subgroup.zpowers (⟨x, hxJ⟩ : ↥J))
  have hCdvd : Nat.card (Subgroup.centralizer
      (Subgroup.zpowers (⟨x, hxJ⟩ : ↥J) : Set ↥J)) ∣ 156 := by
    rw [← hCLcard]
    exact card_centralizer_zpowers_dvd hxJ
  have hrdvd12 : r ∣ 12 := by
    have h := hrdvd
    rw [IsCyclic.card_mulAut, Nat.card_zpowers, hxord,
      Nat.totient_prime (by norm_num : Nat.Prime 13)] at h
    norm_num at h
    exact h
  rw [hcardN]
  have h := Nat.mul_dvd_mul hCdvd hrdvd12
  rwa [show (156 : ℕ) * 12 = 1872 from by norm_num] at h

private theorem exists_three_commuting_of_thirteen {L : Type} [Group L] [Finite L]
    {Y J D : Subgroup L} (hJY : J ≤ Y)
    (hJn : (J.subgroupOf Y).Normal) (hC : Subgroup.centralizer (J : Set L) ⊓ Y = ⊥)
    (hinn : ∀ α : MulAut ↥J, α ^ 3 = 1 →
      α ∈ CFSG.ComponentClassification.OuterAutomorphisms.inner ↥J)
    (hND : ∀ F : Subgroup L, F ≤ D → F ≠ ⊥ → Subgroup.normalizer (F : Set L) ≤ Y)
    {x : L} (hxD : x ∈ D) (hx13 : orderOf x = 13)
    (hCcard : Nat.card (Subgroup.centralizer ({x} : Set L)) = 156) :
    ∃ y : L, orderOf y = 3 ∧ y * x = x * y ∧ y ∈ J := by
  have : Fact (Nat.Prime 3) := ⟨by norm_num⟩
  let C : Subgroup L := Subgroup.centralizer ({x} : Set L)
  have hCcard : Nat.card ↥C = 156 := hCcard
  obtain ⟨y, hyord⟩ := exists_prime_orderOf_dvd_card' (G := ↥C) 3
    (by rw [hCcard]; norm_num)
  have hy3 : (y : L) ^ 3 = 1 := by
    have h := pow_orderOf_eq_one y
    rw [hyord] at h
    simpa using congrArg Subtype.val h
  have hycomm : (y : L) * x = x * (y : L) :=
    Subgroup.mem_centralizer_singleton_iff.mp y.2
  have hyY : (y : L) ∈ Y := by
    have hzxD : Subgroup.zpowers x ≤ D := Subgroup.zpowers_le.mpr hxD
    have hzxne : Subgroup.zpowers x ≠ ⊥ := by
      intro hbot
      have h1 : Nat.card (Subgroup.zpowers x) = 1 := by rw [hbot, Subgroup.card_bot]
      rw [Nat.card_zpowers, hx13] at h1
      norm_num at h1
    refine hND (Subgroup.zpowers x) hzxD hzxne
      ((Subgroup.centralizer_le_normalizer (Subgroup.zpowers x : Set L)) ?_)
    rw [Subgroup.zpowers_eq_closure, Subgroup.centralizer_closure]
    exact Subgroup.mem_centralizer_singleton_iff.mpr hycomm
  have hyJ : (y : L) ∈ J :=
    mem_of_pow_eq_one_of_inner hJY hJn hC hinn hyY hy3
  exact ⟨(y : L), (Subgroup.orderOf_coe y).trans hyord, hycomm, hyJ⟩

private theorem index_normalizer_zpowers_thirteen {J : Type} [Group J] [Finite J] {x : J}
    (hx13 : orderOf x = 13) (hJcard : Nat.card J = 4680000) :
    (Subgroup.normalizer (Subgroup.zpowers x : Set J)).index ≡ 1 [MOD 13] ∧
      Nat.card (Subgroup.normalizer (Subgroup.zpowers x : Set J)) *
        (Subgroup.normalizer (Subgroup.zpowers x : Set J)).index = 4680000 := by
  have : Fact (Nat.Prime 13) := ⟨by norm_num⟩
  have hPcard : Nat.card (Subgroup.zpowers x) = 13 := by rw [Nat.card_zpowers, hx13]
  have hfac13 : (4680000 : ℕ).factorization 13 = 1 := by
    rw [show (4680000 : ℕ) = 13 * 360000 from by norm_num,
      Nat.factorization_mul (by norm_num) (by norm_num), Finsupp.add_apply,
      Nat.Prime.factorization_self (by norm_num : Nat.Prime 13),
      Nat.factorization_eq_zero_of_not_dvd (by norm_num : ¬ 13 ∣ 360000), add_zero]
  have hPsyl : Nat.card (Subgroup.zpowers x) = 13 ^ (Nat.card J).factorization 13 := by
    rw [hPcard, hJcard, hfac13]
    norm_num
  let P₀ : Sylow 13 J := Sylow.ofCard (Subgroup.zpowers x) hPsyl
  have hm : (Subgroup.normalizer (Subgroup.zpowers x : Set J)).index ≡ 1 [MOD 13] := by
    have h1 : Nat.card (Sylow 13 J) =
        (Subgroup.normalizer (Subgroup.zpowers x : Set J)).index :=
      Sylow.card_eq_index_normalizer P₀
    rw [← h1]
    exact card_sylow_modEq_one 13 J
  exact ⟨hm, by rw [Subgroup.card_mul_index, hJcard]⟩

private theorem false_of_normalizer_zpowers_thirteen {J : Type} [Group J] [Finite J]
    {x y : J} (hx13 : orderOf x = 13) (hy3 : orderOf y = 3) (hcomm : y * x = x * y)
    (hJcard : Nat.card J = 4680000)
    (hNdvd : Nat.card (Subgroup.normalizer (Subgroup.zpowers x : Set J)) ∣ 1872) : False := by
  obtain ⟨hm, hmul⟩ := index_normalizer_zpowers_thirteen hx13 hJcard
  have h13dvd : 13 ∣ Nat.card (Subgroup.normalizer (Subgroup.zpowers x : Set J)) := by
    have h := Subgroup.card_dvd_of_le (Subgroup.le_normalizer (H := Subgroup.zpowers x))
    rwa [Nat.card_zpowers, hx13] at h
  have hycent : y ∈ Subgroup.centralizer (Subgroup.zpowers x : Set J) := by
    rw [Subgroup.zpowers_eq_closure, Subgroup.centralizer_closure]
    exact Subgroup.mem_centralizer_singleton_iff.mpr hcomm
  have h3dvd : 3 ∣ Nat.card (Subgroup.normalizer (Subgroup.zpowers x : Set J)) := by
    have hle : Subgroup.zpowers y ≤ Subgroup.normalizer (Subgroup.zpowers x : Set J) :=
      Subgroup.zpowers_le.mpr
        ((Subgroup.centralizer_le_normalizer (Subgroup.zpowers x : Set J)) hycent)
    have h := Subgroup.card_dvd_of_le hle
    rwa [Nat.card_zpowers, hy3] at h
  have h39 : 39 ∣ Nat.card (Subgroup.normalizer (Subgroup.zpowers x : Set J)) := by
    have h := Nat.lcm_dvd h13dvd h3dvd
    rwa [show Nat.lcm 13 3 = 39 from by norm_num] at h
  have hm' : (Subgroup.normalizer (Subgroup.zpowers x : Set J)).index % 13 = 1 := by
    have h := hm
    simp only [Nat.ModEq] at h
    norm_num at h
    exact h
  exact false_of_count_thirteen hNdvd h39 hmul hm'

private theorem false_of_d_eq_thirteen {L : Type} [Group L] [Finite L]
    {Y J D : Subgroup L} (hJY : J ≤ Y) (hJn : (J.subgroupOf Y).Normal)
    (hC : Subgroup.centralizer (J : Set L) ⊓ Y = ⊥)
    (hinn : ∀ α : MulAut ↥J, α ^ 3 = 1 →
      α ∈ CFSG.ComponentClassification.OuterAutomorphisms.inner ↥J)
    (hND : ∀ F : Subgroup L, F ≤ D → F ≠ ⊥ → Subgroup.normalizer (F : Set L) ≤ Y)
    (hJcard : Nat.card ↥J = 4680000)
    {x : L} (hxD : x ∈ D) (hx13 : orderOf x = 13) (hxJ : x ∈ J)
    (hCcard : Nat.card (Subgroup.centralizer ({x} : Set L)) = 156) : False := by
  obtain ⟨y, hy3, hcomm, hyJ⟩ :=
    exists_three_commuting_of_thirteen hJY hJn hC hinn hND hxD hx13 hCcard
  have hx'13 : orderOf (⟨x, hxJ⟩ : ↥J) = 13 := by
    rw [← Subgroup.orderOf_coe (⟨x, hxJ⟩ : ↥J)]
    exact hx13
  have hy'3 : orderOf (⟨y, hyJ⟩ : ↥J) = 3 := by
    rw [← Subgroup.orderOf_coe (⟨y, hyJ⟩ : ↥J)]
    exact hy3
  have hcomm' : (⟨y, hyJ⟩ : ↥J) * ⟨x, hxJ⟩ = ⟨x, hxJ⟩ * ⟨y, hyJ⟩ := Subtype.ext hcomm
  exact false_of_normalizer_zpowers_thirteen hx'13 hy'3 hcomm' hJcard
    (card_normalizer_dvd_1872 hxJ hx13 hCcard)

private theorem false_of_psp {L : Type} [Group L] [Finite L]
    {d : ℕ} {Y : Subgroup L} (h : SporOvergroupData L 5 d Y) {J : Subgroup L}
    (hJY : J ≤ Y) (hJn : (J.subgroupOf Y).Normal)
    (hJC : Subgroup.centralizer (J : Set L) ⊓ Y = ⊥)
    (hJcard : Nat.card ↥J = 4680000) (e : L ≃* Carrier .Co1)
    {E : Subgroup CFSG.Blueprint.NativeSporadic.Co1}
    (hEexp : ∀ x ∈ E, x ^ 3 = 1) (hEcard : Nat.card E = 3 ^ 4)
    (h13 : ∀ x : L, orderOf x = 13 → Nat.card (Subgroup.centralizer ({x} : Set L)) = 156)
    (hinner : ∀ r : ℕ, r.Prime → r ≠ 2 → ∀ α : MulAut ↥J, α ^ r = 1 →
      α ∈ CFSG.ComponentClassification.OuterAutomorphisms.inner ↥J) : False := by
  have : Fact (Nat.Prime 5) := ⟨h.prime⟩
  have : Fact (Nat.Prime d) := ⟨h.d_prime⟩
  obtain ⟨D, hDsyl, hDne, hND⟩ := h.sylowD
  have hDY : D ≤ Y := Subgroup.le_normalizer.trans (hND D le_rfl hDne)
  have hdD : d ∣ Nat.card D := by
    obtain ⟨k, hk⟩ := IsPGroup.iff_card.mp hDsyl.isPGroup
    have hk0 : k ≠ 0 := by
      rintro rfl
      exact hDne (Subgroup.eq_bot_of_card_eq D (by rw [hk, pow_zero]))
    rw [hk]
    exact dvd_pow_self d hk0
  obtain ⟨x, hxord⟩ := exists_prime_orderOf_dvd_card' (G := ↥D) d hdD
  have hxL : orderOf ((x : D) : L) = d := (Subgroup.orderOf_coe x).trans hxord
  have hxW : ((x : D) : L) ∈ Y := hDY x.2
  have hxd : ((x : D) : L) ^ d = 1 := by
    have h := pow_orderOf_eq_one x
    rw [hxord] at h
    simpa using congrArg Subtype.val h
  have hxJ : ((x : D) : L) ∈ J :=
    mem_of_pow_eq_one_of_inner hJY hJn hJC
      (hinner d h.d_prime h.d_ne_two) hxW hxd
  have hdvdJ : d ∣ Nat.card ↥J := by
    have hle : Subgroup.zpowers ((x : D) : L) ≤ J := Subgroup.zpowers_le.mpr hxJ
    have h := Subgroup.card_dvd_of_le hle
    rwa [Nat.card_zpowers, hxL] at h
  have hprod : (List.map (fun x => x.1 ^ x.2) [(2, 6), (3, 2), (5, 4), (13, 1)]).prod
      = Nat.card ↥J := by
    have h : (List.map (fun x => x.1 ^ x.2) [(2, 6), (3, 2), (5, 4), (13, 1)]).prod
        = 4680000 := by decide
    rw [h, hJcard]
  have hmem := mem_of_prime_dvd h.d_prime (qs := [(2, 6), (3, 2), (5, 4), (13, 1)])
    (by norm_num) (by rw [hprod]; exact hdvdJ)
  simp only [List.map_cons, List.map_nil, List.mem_cons, List.not_mem_nil, or_false] at hmem
  rcases hmem with rfl | rfl | rfl | rfl
  · exact h.d_ne_two rfl
  · exact false_of_d_eq_three e hEexp hEcard hJY hJn hJC (hinner 3 (by norm_num) (by norm_num))
      hDsyl hDY hJcard
  · exact h.d_ne rfl
  · exact false_of_d_eq_thirteen hJY hJn hJC (hinner 3 (by norm_num) (by norm_num)) hND hJcard
      x.2 hxL hxJ (h13 _ hxL)

private theorem lieOrderDivisor_psp_two_five :
    CFSG.ComponentClassification.CatLeaf.lieOrderDivisor .PSp 2 (5 ^ 1) = 2 := by
