theorem false_Co1_of_data_of_op_eq_bot {L : Type} [Group L] [Finite L] (e : L ≃* Carrier .Co1)
    {d : ℕ} {Y : Subgroup L} (h : SporOvergroupData L 5 d Y)
    (hOp : ∀ R : Subgroup L, IsPGroup 5 R → R ≤ Y → (R.subgroupOf Y).Normal → R = ⊥) :
    False := by
  have : Fact (Nat.Prime 5) := ⟨h.prime⟩
  have e0 : L ≃* CFSG.Blueprint.NativeSporadic.Co1 := e
  have hL : Nat.card L = 4157776806543360000 :=
    (Nat.card_congr e0.toEquiv).trans CFSG.Sporadic.Co1.card_Co1
  have : IsSimpleGroup (Carrier .Co1) := CFSG.Sporadic.Co1.isSimpleGroup_Co1
  have : IsSimpleGroup L := MulEquiv.isSimpleGroup e
  have hO : CFSG.HardMathSupport.Timmesfeld.SporadicBalance.OPrimeCoreTrivialAt 5 L :=
    CFSG.HardMathSupport.Timmesfeld.SporadicBalance.sporadicOPrimeHolds_Co1_five L ⟨e⟩
  have hO5 := gLAPPrimeCoreOf_eq_bot_of_data h hO
  obtain ⟨J, hJY, hJn, hJs, hJna, hJC⟩ :=
    exists_simple_normal_of_data h le_rfl hO5 hOp (card_center_sylow_Co1 e)
  have : IsSimpleGroup ↥J := hJs
  have hcat : CFSG.Blueprint.Catalog ↥J :=
    CFSG.SectionRank.catalog_of_isKGroupCat_of_surjective h.kgroup J (MonoidHom.id ↥J)
      Function.surjective_id
  have hord : Nat.card ↥J ∣ 4157776806543360000 := by
    rw [← hL]
    exact Subgroup.card_subgroup_dvd_card J
  obtain ⟨hinn5, h54⟩ := co1_sieve hcat hJna hord
  obtain ⟨g₁, g₂, hg₁, hg₂, hFcard⟩ := exists_sylow_generators_Co1 e
  rcases h54 (five_pow_four_dvd_card h hJY hJn hJC hinn5 hg₁ hg₂ hFcard) with
    hbig | ⟨hJcard, hJlie⟩
  · have hJtop : J = ⊤ := Subgroup.eq_top_of_card_eq J (hbig.trans hL.symm)
    rw [hJtop] at hJY
    exact h.ne_top (top_le_iff.mp hJY)
  obtain ⟨E, hEab, hEcard⟩ := CFSG.SectionRank.Co1_elementary_three_rank_four
  have h13 : ∀ x : L, orderOf x = 13 → Nat.card (Subgroup.centralizer ({x} : Set L)) = 156 :=
    fun x hx => card_centralizer_Co1_thirteen e hx
  have hinner : ∀ r : ℕ, r.Prime → r ≠ 2 → ∀ α : MulAut ↥J, α ^ r = 1 →
      α ∈ CFSG.ComponentClassification.OuterAutomorphisms.inner ↥J := by
