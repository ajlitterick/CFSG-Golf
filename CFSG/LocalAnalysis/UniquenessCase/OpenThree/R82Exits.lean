open CFSG.Open Subgroup
open CFSG.LocalAnalysis.UniquenessCase.PartOne.Theorem82
open CFSG.LocalAnalysis.UniquenessCase.PartOne.Section7
open CFSG.LocalAnalysis.UniquenessCase.UC22 (Data)

theorem scExcludedSetup_holds : SCExcludedSetup := by
  intro G _ _ hS hUC hC S hMS c h812 p hSC
  classical
  let X : Ctx82E3.C4Data G (PartTwo.Three.dataOfSetup hS S).M :=
    ⟨S.notCatalog, S.V, S.le, S.le_normalizer, S.elemAbelian, S.not_isTI⟩
  obtain ⟨P, hP⟩ := CFSG.ABGLocalTools.exists_isSylowOf 3 (PartTwo.Three.dataOfSetup hS S).M
  obtain ⟨d, hdM, hdL, hdS, hinj, hcomp, hperm⟩ := c.exists_sylowThreeData_of_not_quasisimple X h812 hP
  by_cases hPn : ∀ i, P ≤ normalizer (d.Lf i : Set G)
  · let hSE := Section7.SEFive.stronglyEmbeddedFive_holds
    let hAlt := stronglyEmbeddedSolvableAltTen_of_kFacts
        CFSG.LocalAnalysis.UniquenessCase.UCK.kFactSmallIdent_holds
        CFSG.LocalAnalysis.UniquenessCase.UCK.kFactOneLieTorus_holds
        CFSG.LocalAnalysis.UniquenessCase.UCK.stronglyEmbeddedCyclicOuter_holds
        CFSG.AGLEmbedding.kFactCatalogSchreier_holds
        CFSG.AGLEmbeddingD2.Wilson.Coordinator.d2HeisLocalAt_J4
    let hKSM := CFSG.LocalAnalysis.RankThreeUC.S15.KSMAlt_holds
    have hRank := c.pRank_Lf_eq_one_of_isSCPrime X hSC d hdM hdL hP hdS hPn
    have hAxis := c.normalizer_axis_le_of_isSCPrime_of_inputs hSE hAlt hKSM X hSC
      d hdM hdL hP hdS hinj hcomp hPn
    have hNA : normalizer (d.AA : Set G) ≤ (PartTwo.Three.dataOfSetup hS S).M := by
      have hh := SCFixedAxes.normalizer_AA_le_of_axes d
        ((PartTwo.Three.dataOfSetup hS S).sig_prime p hSC.1).1
        ((PartTwo.Three.dataOfSetup hS S).sig_prime p hSC.1).2
        (hdM.symm ▸ c.isStronglyPEmbedded_of_mem_sigma hSC.1)
        (fun i => by rw [hRank i]) (fun i => hdM.symm ▸ hAxis i)
      rwa [hdM] at hh
    have hPL := c.le_L_of_normalizes_factors outerThreeSplit_holds X d hdM hdL hcomp hP hdS hPn
    obtain ⟨hNP, hPG⟩ := SCFixedAxes.normalizer_and_sylow_of_fixed_factors outerThreeSplit_holds
      hSE hAlt hKSM c X hSC d hdM hdL hP hdS hinj hcomp hPn
    obtain ⟨a, ha, ha1, hEscape⟩ := SCFixedAxes.exists_centralizer_not_le_of_fixed_factors
      outerThreeSplit_holds hSE hAlt hKSM c X hSC d hdM hdL hP hdS hinj hcomp hPn
    exact sc_fixed_centralizer_escape_false hS hUC hC S hMS c h812 hSC d hdM hdL
      hP hdS hinj hcomp hperm hPn hRank hAxis hNA hPL hNP hPG a ha ha1 hEscape
  · exact sc_transitive_factors_false hS hUC hC S hMS c h812 hSC d hdM hdL hP hdS
      hinj hcomp hperm hPn

end CFSG.LocalAnalysis.UniquenessCase.PartOne.Theorem82E3
