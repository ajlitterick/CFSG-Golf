  · obtain ⟨q, hq, hq7, hqr, A, _, _, hAp, hAc, κ, hκ, ι, hι, hσι⟩ :=
      r3lf_exists_fpf_orthogonalMinus hY.admissible.2.1 hK hr hr5 σ SS.hσ b c hirrK
