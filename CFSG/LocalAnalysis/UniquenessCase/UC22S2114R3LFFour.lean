    (by rw [Nat.card_units, hK]; exact hqd)
  have hprim : IsPrimitiveRoot ζ q := hζ ▸ IsPrimitiveRoot.orderOf ζ
  have hcard : Nat.card (rootsOfUnity q K) = q := hprim.card_rootsOfUnity'
  let A := rootsOfUnity q K × rootsOfUnity q K
