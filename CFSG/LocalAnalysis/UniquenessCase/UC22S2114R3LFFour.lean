  have hirrK := rootFree_of_odd_degree (semilinearFixedSubfield σ) hr (by omega) hdeg b c hirr
  have hε : ∀ x, θ (e.symm x) = e.symm (fieldAutT _ σ SS.hQσ x) := by
    intro x
