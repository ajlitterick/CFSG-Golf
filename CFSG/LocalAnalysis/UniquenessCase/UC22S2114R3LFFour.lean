  have hK : Nat.card K = 2 ^ f := by
    rw [CFSG.StandardType.OrdPFieldNs.card_eq_card_fixed_pow SS.hσ, ← hkFixed, hk,
      ← pow_mul, Nat.div_mul_cancel hrf]
  clear hkFixed
