theorem gap17_45_phaseReduction_of_kFacts (hK1a : K45CharTwoNormal)
    (hK1b : K45CharTwoBorelGen) (hK2 : K45WeylFive) (hK3 : K45FiveRankTwo)
    (hK4 : K45UnitaryThirtyOneGen) : Gap17_45_PhaseReduction := by
  intro X _ _ L A₁ A₂ B T ML hLn hLs hLnab hLK hCL hA1 hA2 hA12 hA12c hB5 hBA1 hBA2 hcomm
    hlines hT hAT hBT hTL hML hMLne hTML hC5 hC6
  have hc : PhaseConfig45 L A₁ A₂ B T ML := ⟨hLn, hLs, hLnab, hLK, hCL, hA1, hA2, hA12, hA12c,
    hB5, hBA1, hBA2, hcomm, hlines, hT, hAT, hBT, hTL, hML, hMLne, hTML, hC5, hC6⟩
  have hnab : ∃ a b : L, a * b ≠ b * a := by
    by_contra h
    push Not at h
    exact hLnab ⟨⟨h⟩⟩
  haveI : IsSimpleGroup L := hLs
  have hcat : IsCatalogGroup L := hLK.isCatalogGroup_of_surjective ⊤ hnab
    (Subgroup.topEquiv : (⊤ : Subgroup L) ≃* L).toMonoidHom (MulEquiv.surjective _)
  rcases CFSG.LocalAnalysis.RankFourTheoremC.PEmpty.P64Asm.catalog_trichotomy hcat hnab with
    ⟨m, hm, ⟨e⟩⟩ | ⟨-, d, ⟨e⟩, -⟩ | ⟨s, ⟨e⟩⟩
  · exact (phase45_false_of_alternating hLn hLs hLnab hCL e hA1 hA2 hA12 hA12c hT hAT
      hTL).elim
  · by_cases h2 : d.1.characteristic = 2
    · by_cases htits : d.1 = .tits
      · exact (phase45_false_of_tits hLn hLs hLnab hCL htits e hA1).elim
      · exact (phase45_false_of_charTwo hK1a hK1b hc e h2 htits).elim
    · exact phase45_conclusion_of_lie_odd hK2 hK3 hK4 hc
        (phase45_pRank_five_le_one UCK.kFactSmallIdent_holds UCK.kFactOneLieIdent_holds
          UCK.stronglyEmbeddedCyclicOuter_holds hK1a hK1b hK2 hc) e h2
  · exact (phase45_false_of_sporadic hLn hCL e hA1 hA2 hA12 hA12c).elim

end Assembly

end CFSG.LocalAnalysis.UniquenessCase.PartTwo.S17.SzFive
