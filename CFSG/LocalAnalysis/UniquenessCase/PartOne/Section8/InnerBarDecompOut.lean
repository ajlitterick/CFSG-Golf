variable {G : Type} [Group G] [Finite G]

theorem le_sup_centralizerBar_of_out
    {P L Q : Subgroup G}
    (hOut : ¬ 3 ∣ Nat.card
      (CFSG.ComponentClassification.OuterAutomorphisms.Outer (Bar2 L)))
    (hP3 : IsPGroup 3 P) (hPNL : P ≤ Subgroup.normalizer (L : Set G))
    (hQP : Q ≤ P) (hQL : Q ≤ L) (hQeq : Q = P ⊓ L)
    (hQnormP : (Q.subgroupOf P).Normal)
    (hQ : CFSG.ABGLocalTools.IsSylowOf 3 Q L) :
    P ≤ Q ⊔ centralizerBar P L :=
  le_sup_centralizerBar_of_inner hQP hQL hQeq hQnormP hQ hP3 hPNL le_rfl
    (inner_action_of_not_three_dvd_outer hOut hP3 hPNL)

end CFSG.LocalAnalysis.UniquenessCase.PartOne.Section8
