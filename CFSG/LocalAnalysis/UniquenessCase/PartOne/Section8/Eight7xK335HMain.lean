theorem k335_of_oddZStar
    (hZ : K335OddZStar) (hM24 : K335SporNormAt .M24) (hHe : K335SporNormAt .He)
    (hRu : K335SporNormAt .Ru) (hJ4 : K335SporNormAt .J4) : K335 := by
  suffices H : ∀ n : ℕ, ∀ (G : Type) [Group G] [Finite G], Nat.card G = n →
      ∀ L P : Subgroup G, K335Hyp G L P → Subgroup.normalizer (L : Set G) = ⊤ by
    intro G _ _ hK hr L P hL hP hΓ hcl
    exact H _ G rfl L P ⟨hK, hr, hL, hP, hΓ, hcl⟩
  intro n
  induction n using Nat.strong_induction_on with
  | _ n ih =>
    intro G _ _ hn L P hyp
    by_contra hne
    have h : K335MinCex G L P :=
      ⟨hyp, hne, fun H _ _ hH L' P' hyp' => ih _ (hH.trans_eq hn) H rfl L' P' hyp'⟩
    obtain ⟨S, hq⟩ := h.exists_quasi hZ
    have h2 := k335_two_le_pRank hq.elem hq.card
    have h3 := hq.rank
    rcases (by omega : CFSG.Open.pRank 3 (⊤ : Subgroup G) = 2 ∨
        CFSG.Open.pRank 3 (⊤ : Subgroup G) = 3) with hr | hr
    · exact k335_rank_two_false CFSG.LocalAnalysis.UniquenessCase.UCK.K332Route.k33_holds
        CFSG.LocalAnalysis.UniquenessCase.UCK.K35Ω_holds
        CFSG.ComponentClassification.CatLeafProof.lieOrderFormulasInput k335SporadicOrders_holds
        (k335SporadicNormalizer_of_at hM24 k335SporNormAt_J2 hHe hRu hJ4)
        k335G2Local_holds k335ReeLocal_holds hq hr
    · exact k335_rank_three_false
        CFSG.LocalAnalysis.UniquenessCase.PartOne.Theorem82.k34odd_holds
        CFSG.LocalAnalysis.UniquenessCase.PartOne.Theorem82E3.ONan.K3_holds'
        CFSG.ComponentClassification.CatLeafProof.lieOrderFormulasInput k335SporadicOrders_holds hq hr

end CFSG.LocalAnalysis.UniquenessCase.PartOne.Section8
