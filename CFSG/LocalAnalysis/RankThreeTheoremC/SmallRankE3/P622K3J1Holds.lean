theorem j1_overgroup_eq_top
    (Z : Subgroup ↥CFSG.Sporadic.J1.J) (hSZ : CFSG.Quasithin.E2P.SporB.j1S ≤ Z)
    (h5 : 5 ∣ Nat.card Z) (h3 : Z.index ≡ 1 [MOD 3]) : Z = ⊤ := by
  obtain ⟨j, hj, hZ⟩ := j1_all Z hSZ
  have hcard : Nat.card ↥CFSG.Sporadic.J1.J = 175560 := CFSG.Sporadic.J1.card_J
  have hidx := Subgroup.card_mul_index Z
  rw [hcard] at hidx
  unfold Nat.ModEq at h3
  by_cases hj17 : j < 17
  · exfalso
    have hZY : Z = j1Y j := by
      rw [hZ]
      exact list_member (L := #[1, 15, 15, 15, 15, 15, 15, 7, 3, 15, 3, 3, 3, 3, 3, 3, 21]) hj17
    have hc := j1_Y_card hj17
    rw [← hZY] at hc
    rw [hc] at hidx h5
    interval_cases j <;> simp at hidx h5 <;> omega
  · have h17 : j = 17 := by
      have : j ≤ 17 := hj
      omega
    rw [hZ, h17]
    unfold memberOrTop
    rw [ite_eq_right (by simp)]


private theorem eight_le_of_mul_eq_120 (m i : ℕ) (h : m * i = 120) (hi : ¬ 2 ∣ i) : 8 ≤ m := by
  by_contra hlt
  have hm : m < 8 := by omega
  interval_cases m <;> omega

private theorem pow_two_le_eight_of_dvd {n : ℕ} (h : 2 ^ n ∣ 175560) : 2 ^ n ≤ 8 := by
  have hn3 : n ≤ 3 := by
    by_contra hn
    have h16 : 2 ^ 4 ∣ 2 ^ n := pow_dvd_pow 2 (by omega)
    have h' := dvd_trans h16 h
    norm_num at h'
  calc 2 ^ n ≤ 2 ^ 3 := Nat.pow_le_pow_right (by norm_num) hn3
    _ = 8 := by norm_num

theorem exists_sylow_two_le_of_card {G : Type} [Group G] [Finite G]
    (hG : Nat.card G = 175560) (C : Subgroup G) (hC : Nat.card C = 120) :
    ∃ T : Sylow 2 G, (T : Subgroup G) ≤ C := by
  obtain ⟨Q⟩ : Nonempty (Sylow 2 C) := inferInstance
  have hQi : ¬ 2 ∣ (Q : Subgroup C).index := Sylow.not_dvd_index Q
  have hQm : Nat.card (Q : Subgroup C) * (Q : Subgroup C).index = 120 := by
    rw [Subgroup.card_mul_index, hC]
  have hQ8 : 8 ≤ Nat.card (Q : Subgroup C) :=
    eight_le_of_mul_eq_120 _ _ hQm hQi
  obtain ⟨H, hH⟩ : ∃ H : Subgroup G, H = (Q : Subgroup C).map C.subtype := ⟨_, rfl⟩
  have hHp : IsPGroup 2 H := by
    rw [hH]
    exact (Sylow.isPGroup' Q).map C.subtype
  have hHcard : Nat.card H = Nat.card (Q : Subgroup C) := by
    rw [hH]
    exact Subgroup.card_map_of_injective C.subtype_injective
  obtain ⟨T, hHT⟩ := IsPGroup.exists_le_sylow hHp
  have hTcard : Nat.card (T : Subgroup G) ≤ 8 := by
    obtain ⟨n, hn⟩ := IsPGroup.iff_card.mp T.isPGroup'
    have hdvd : Nat.card (T : Subgroup G) ∣ 175560 := by
      have h := Subgroup.card_subgroup_dvd_card (T : Subgroup G)
      rwa [hG] at h
    rw [hn] at hdvd ⊢
    exact pow_two_le_eight_of_dvd hdvd
  have hHT' : H = (T : Subgroup G) :=
    Subgroup.eq_of_le_of_card_ge hHT (by rw [hHcard]; omega)
  refine ⟨T, ?_⟩
  rw [← hHT', hH]
  exact Subgroup.map_subtype_le _


open CFSG.LocalAnalysis.RankFourTheoremC.PEmpty (index_modEq_one_of_normalizer_le) in
theorem kFactJ1ClosureThree_holds :
    KFactJ1ClosureThree := by
  intro A _ _ L J z hL hzL hz3 hN hU
  obtain ⟨e⟩ := hL
  obtain ⟨f⟩ := CFSG.Sporadic.Bridge.J1.nonempty_mulEquiv
  let ψ₀ : ↥L ≃* CFSG.Blueprint.NativeSporadic.J1 := e.trans f.symm
  let φ : ↥L ≃* ↥CFSG.Sporadic.J1.J := ψ₀.trans CFSG.Sporadic.J1.nativeEquiv
  have hLc : Nat.card ↥L = 175560 := by
    rw [Nat.card_congr φ.toEquiv]
    exact CFSG.Sporadic.J1.card_J
  haveI : Fact (Nat.Prime 2) := ⟨Nat.prime_two⟩
  haveI : Fact (Nat.Prime 3) := ⟨Nat.prime_three⟩
  let zL : ↥L := ⟨z, hzL⟩
  have hzL3 : orderOf zL = 3 := by rw [Subgroup.orderOf_mk]; exact hz3
  have hcent : ∀ t : ↥L, orderOf t = 2 →
      Nat.card (Subgroup.centralizer ({t} : Set ↥L)) = 120 := fun t ht =>
    (CFSG.Sporadic.Schreier.ctugs_j1_involution_centralizer_odd_core_free ⟨ψ₀⟩ t ht).1
  obtain ⟨t, ht2, hzt⟩ := j1_exists_involution_commuting hLc hcent zL hzL3
  have hztA : z * (t : A) = (t : A) * z := congrArg Subtype.val hzt
  have ht2A : orderOf (t : A) = 2 := by rw [Subgroup.orderOf_coe]; exact ht2
  have hPzL : zpowers z ≤ L := Subgroup.zpowers_le.mpr hzL
  have hnorm_of_comm : ∀ u : A, z * u = u * z → u ∈ normalizer (zpowers z : Set A) := by
    intro u hu
    apply Subgroup.centralizer_le_normalizer
    rw [Subgroup.mem_centralizer_iff]
    rintro h ⟨k, rfl⟩
    exact (Commute.zpow_left (show Commute z u from hu) k).eq
  have htJ : (t : A) ∈ J := hN ⟨hnorm_of_comm _ hztA, t.2⟩
  let H : Subgroup ↥L := J.subgroupOf L
  have htH : t ∈ H := htJ
  have hCH : Subgroup.centralizer ({t} : Set ↥L) ≤ H := by
    have hU2 : IsPGroup 2 (zpowers (t : A)) :=
      IsPGroup.of_card (n := 1) (by simp [Nat.card_zpowers, ht2A])
    have hUne : zpowers (t : A) ≠ ⊥ := by
      rw [Ne, Subgroup.zpowers_eq_bot]
      intro h1
      rw [h1, orderOf_one] at ht2A
      omega
    have hUz : z ∈ normalizer ((zpowers (t : A) : Subgroup A) : Set A) := by
      apply Subgroup.centralizer_le_normalizer
      rw [Subgroup.mem_centralizer_iff]
      rintro h ⟨k, rfl⟩
      exact (Commute.zpow_left (show Commute (t : A) z from hztA.symm) k).eq
    have hUJ : zpowers (t : A) ≤ J := Subgroup.zpowers_le.mpr htJ
    have hUL : zpowers (t : A) ≤ L := Subgroup.zpowers_le.mpr t.2
    have key := hU _ hUJ hUL hUne hU2 hUz
    intro g hg
    have hgA : (g : A) * (t : A) = (t : A) * g := congrArg Subtype.val
      (Subgroup.mem_centralizer_singleton_iff.mp hg)
    have hgn : (g : A) ∈ normalizer ((zpowers (t : A) : Subgroup A) : Set A) := by
      apply Subgroup.centralizer_le_normalizer
      rw [Subgroup.mem_centralizer_iff]
      rintro h ⟨k, rfl⟩
      exact (Commute.zpow_left (show Commute (t : A) (g : A) from hgA.symm) k).eq
    exact key ⟨hgn, g.2⟩
  have hC120 : Nat.card (Subgroup.centralizer ({t} : Set ↥L)) = 120 := hcent t ht2
  have h5 : 5 ∣ Nat.card H := (by norm_num : 5 ∣ 120).trans (hC120 ▸ Subgroup.card_dvd_of_le hCH)
  obtain ⟨T, hTC⟩ := exists_sylow_two_le_of_card hLc _ hC120
  have hTH : (T : Subgroup ↥L) ≤ H := hTC.trans hCH
  let P0 : Subgroup ↥L := (zpowers z).subgroupOf L
  have hP0card : Nat.card P0 = 3 := by
    rw [Nat.card_congr (Subgroup.subgroupOfEquivOfLe hPzL).toEquiv, Nat.card_zpowers, hz3]
  have hP0p : IsPGroup 3 P0 := IsPGroup.of_card (n := 1) (by rw [hP0card]; norm_num)
  have hP0idx : ¬ 3 ∣ P0.index := by
    have h := Subgroup.card_mul_index P0
    rw [hP0card, hLc] at h
    have : P0.index = 58520 := by omega
    rw [this]
    norm_num
  let P : Sylow 3 ↥L := hP0p.toSylow hP0idx
  have hH : normalizer ((P : Subgroup ↥L) : Set ↥L) ≤ H := by
    have hNP : normalizer ((P : Subgroup ↥L) : Set ↥L) =
        (normalizer ((zpowers z : Subgroup A) : Set A)).subgroupOf L :=
      (Subgroup.subgroupOf_normalizer_eq hPzL).symm
    rw [hNP]
    intro g hg
    exact hN ⟨hg, g.2⟩
  have hmod : H.index ≡ 1 [MOD 3] := index_modEq_one_of_normalizer_le P hH
  have hT' : CFSG.QuasithinUnique.IsSylowTwoOf (T : Subgroup ↥L) ⊤ :=
    ⟨le_top, T.isPGroup', by
      have h : (((T : Subgroup ↥L).subgroupOf ⊤)).index = (T : Subgroup ↥L).index :=
        Subgroup.relIndex_top_right _
      rw [h]
      exact T.not_dvd_index⟩
  obtain ⟨ψ, hψ⟩ := CFSG.Quasithin.H13.NQCat.A314D.exists_mulEquiv_map_eq φ
    CFSG.Quasithin.E2P.SporB.j1_sylow hT'
  have hSH : CFSG.Quasithin.E2P.SporB.j1S ≤ H.map ψ.toMonoidHom :=
    hψ ▸ Subgroup.map_mono hTH
  have hcardH : Nat.card (H.map ψ.toMonoidHom) = Nat.card H :=
    Subgroup.card_map_of_injective ψ.injective
  have hidxH : (H.map ψ.toMonoidHom).index = H.index := Subgroup.index_map_equiv H ψ
  have htop := j1_overgroup_eq_top _ hSH (hcardH ▸ h5) (hidxH ▸ hmod)
  have hHtop : H = ⊤ := by
    apply Subgroup.index_eq_one.mp
    rw [← hidxH, htop]
    exact Subgroup.index_top
  intro l hl
  have : (⟨l, hl⟩ : ↥L) ∈ H := hHtop ▸ Subgroup.mem_top _
  exact this

end CFSG.LocalAnalysis.RankThreeTheoremC.SmallRankE3
