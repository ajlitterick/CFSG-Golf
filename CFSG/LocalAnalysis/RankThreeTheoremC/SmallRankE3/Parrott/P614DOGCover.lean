theorem mem_normalizer_zpowers_of_conj_eq_inv {A : Type*} [Group A] {g a : A}
    (h : g * a * g⁻¹ = a⁻¹) : g ∈ normalizer ((zpowers a : Subgroup A) : Set A) := by
  have h2 : g * a⁻¹ * g⁻¹ = a := by
    rw [show g * a⁻¹ * g⁻¹ = (g * a * g⁻¹)⁻¹ by group, h, inv_inv]
  have h' : g⁻¹ * a * g = a⁻¹ := by
    calc g⁻¹ * a * g = g⁻¹ * (g * a⁻¹ * g⁻¹) * g := by rw [h2]
      _ = a⁻¹ := by group
  rw [mem_normalizer_iff]
  intro y
  constructor
  · rintro ⟨k, rfl⟩
    refine ⟨-k, ?_⟩
    simp only
    rw [← conj_zpow, h, inv_zpow']
  · rintro ⟨k, hk⟩
    refine ⟨-k, ?_⟩
    simp only at hk ⊢
    calc a ^ (-k) = (g⁻¹ * a * g) ^ k := by rw [h', inv_zpow']
      _ = g⁻¹ * a ^ k * g := by
          have := conj_zpow (i := k) (a := g⁻¹) (b := a)
          rwa [inv_inv] at this
      _ = g⁻¹ * (g * y * g⁻¹) * g := by rw [hk]
      _ = y := by group

variable {G : Type} [Group G] [Finite G]

theorem orderOf_barMk {H : Subgroup G} {T : Subgroup ↥H} (hT : IsPGroup 3 T) {g : ↥H}
    (hg : g ∈ T) : orderOf (barMk ↥H g) = orderOf g := by
  have hinj : Function.Injective ((barMk ↥H).comp T.subtype) := by
    rw [injective_iff_map_eq_one]
    intro t ht
    have h1 : (t : ↥H) ∈ T ⊓ (barMk ↥H).ker := ⟨t.2, ht⟩
    rw [K2.qs_inf_ker hT le_rfl, mem_bot] at h1
    exact Subtype.ext h1
  have h := orderOf_injective _ hinj ⟨g, hg⟩
  rw [Subgroup.orderOf_mk] at h
  exact h

theorem normalizer_zpowers_z_le {P : Sylow 3 G} {M : Subgroup G} {x z : G}
    (hsit : Sit P M x z) : normalizer ((zpowers z : Subgroup G) : Set G) ≤ M := by
  obtain ⟨hPM, hP3⟩ := sylow_le_of_isCoreMaxLocal hsit.setting hsit.situation.mem_sigmaA
    hsit.situation.isCoreMaxLocal
  have hPC : (P : Subgroup G) ≤ M ⊓ centralizer ({z} : Set G) := fun g hg =>
    mem_inf.mpr ⟨hPM hg, mem_centralizer_singleton_iff.mpr
      (mem_centralizer_iff.mp hsit.central.centralizes g hg)⟩
  refine P614CE.sit_normalizer_zpowers_le hsit (hPM hsit.central.mem) hsit.central.ne_one
    hsit.central.pow_eq_one ?_
  have h := pRank_mono 3 Nat.prime_three.one_lt hPC
  rwa [hP3] at h

theorem false_of_data278 (kL : KFactL34DiagGen) (hT : T29.GL83I291Three)
    (hNC : T29.NoncyclicCentreRank) (hQ : KFactThreeComponentsQRank) {P : Sylow 3 G}
    {M : Subgroup G} {x z : G} {H S : Subgroup G} (hyp : Hyp P M x z H S)
    (hnα : ¬ HasPrimeConstraint (G := M) 3) {Q K : Subgroup G} (hD : Data278 M H x z Q K) :
    False := by
  haveI : Fact (Nat.Prime 3) := ⟨Nat.prime_three⟩
  have hsit : Sit P M x z :=
    ⟨hyp.setting, hyp.u0, hyp.d1, hyp.situation, hyp.point, hyp.central⟩
  have hQH : Q ≤ H := hD.syl.le
  have hQp : IsPGroup 3 Q := hD.syl.isPGroup
  have hQ'p : IsPGroup 3 (Q.subgroupOf H) := hQp.comap_subtype
  have hzQ : z ∈ Q := hD.plane_le (mem_sup_right (mem_zpowers z))
  have hzH : z ∈ H := hQH hzQ
  have hz3 : z ^ 3 = 1 := hyp.central.pow_eq_one
  have hz1 : z ≠ 1 := hyp.central.ne_one
  have hzo : orderOf z = 3 := orderOf_eq_prime hz3 hz1
  have hO : ¬ 3 ∣ Nat.card (primeComplementCore (G := ↥H) 3) := K2.qs_not_dvd_core
  haveI hKbn := kb_normal hD.K_le hD.K_normal
  obtain ⟨e⟩ := nonempty_kb_equiv hD
  obtain ⟨S₀, hS₀⟩ := hD.syl.exists_sylow_eq_subgroupOf
  set Qb : Sylow 3 (Bar ↥H) := S₀.mapSurjective (QuotientGroup.mk'_surjective _) with hQbdef
  have hQb : (Qb : Subgroup (Bar ↥H)) = qb H Q := by
    rw [hQbdef, Sylow.coe_mapSurjective, hS₀]
  set z' : ↥H := ⟨z, hzH⟩ with hz'def
  have hz'Q : z' ∈ Q.subgroupOf H := mem_subgroupOf.mpr hzQ
  have hz'o : orderOf z' = 3 := by rw [hz'def, Subgroup.orderOf_mk, hzo]
  have hzbo : orderOf (barMk ↥H z') = 3 := by rw [orderOf_barMk hQ'p hz'Q, hz'o]
  have hzbQ : barMk ↥H z' ∈ (Qb : Subgroup (Bar ↥H)) := by
    rw [hQb]
    exact mem_map_of_mem _ hz'Q
  have hzbc : ∀ q ∈ (Qb : Subgroup (Bar ↥H)), q * barMk ↥H z' = barMk ↥H z' * q := by
    rw [hQb]
    rintro _ ⟨q', hq', rfl⟩
    rw [← map_mul, ← map_mul]
    exact congrArg _ (Subtype.ext (hD.z_central _ (mem_subgroupOf.mp hq')))
  obtain ⟨db, hdbQ, hdbo, hdbz, tb, -, htbd, htbz, hgen⟩ :=
    kL (Bar ↥H) (kb H K) Qb hKbn ⟨e⟩ (centralizer_kb_eq_bot hD)
      (by rw [hQb]; exact card_qb hD) (barMk ↥H z') hzbQ hzbo hzbc
  rw [hQb] at hdbQ
  obtain ⟨d', hd'Q, rfl⟩ := hdbQ
  have hd'o : orderOf d' = 3 := by rw [← orderOf_barMk hQ'p hd'Q, hdbo]
  set d : G := (d' : G) with hddef
  have hdQ : d ∈ Q := mem_subgroupOf.mp hd'Q
  have hdo : orderOf d = 3 := by rw [hddef, Subgroup.orderOf_coe, hd'o]
  have hd3 : d ^ 3 = 1 := by
    have h := pow_orderOf_eq_one d
    rwa [hdo] at h
  have hdz : d ∉ zpowers z := by
    rintro ⟨k, hk⟩
    apply hdbz
    refine ⟨k, ?_⟩
    have hk' : z' ^ k = d' := Subtype.ext (by simpa using hk)
    simp only
    rw [← map_zpow, hk']
  have hdM : d ∈ M := hD.le_M hdQ
  have hzM : z ∈ M := hD.le_M hzQ
  have hdz' : d' * z' = z' * d' := Subtype.ext (hD.z_central d hdQ)
  have hz'p : IsPGroup 3 (zpowers z') :=
    IsPGroup.of_card (n := 1) (by rw [Nat.card_zpowers, hz'o, pow_one])
  have htbN : tb ∈ normalizer (((zpowers z').map (barMk ↥H) : Subgroup (Bar ↥H)) :
      Set (Bar ↥H)) := by
    rw [MonoidHom.map_zpowers]
    exact mem_normalizer_zpowers_of_conj_eq_inv htbz
  obtain ⟨t₁, ht₁N, ht₁⟩ := K2.normalizer_map_le_map_normalizer _ hO hz'p htbN
  have hd'N : d' ∈ normalizer ((zpowers z' : Subgroup ↥H) : Set ↥H) := by
    refine centralizer_le_normalizer _ (mem_centralizer_iff.mpr ?_)
    rintro _ ⟨k, rfl⟩
    exact ((Commute.zpow_left (show Commute z' d' from hdz'.symm) k))
  have hWker : ¬ 3 ∣ Nat.card ↥(normalizer ((zpowers z' : Subgroup ↥H) : Set ↥H) ⊓
      (barMk ↥H).ker) := fun h3 =>
    hO (h3.trans (Subgroup.card_dvd_of_le (inf_le_right.trans K2.qs_ker.le)))
  obtain ⟨c, hcN, hcd, hct⟩ := exists_lift_commute (barMk ↥H) hWker hd'N hd'o ht₁N
    (by rw [ht₁]; exact htbd)
  rw [ht₁] at hct
  have hcz : c * z' * c⁻¹ = z'⁻¹ := by
    refine K2.qs_injOn hz'p ((mem_normalizer_iff.mp hcN z').mp (mem_zpowers z'))
      (inv_mem (mem_zpowers z')) ?_
    rw [map_mul, map_mul, map_inv, hct, htbz, map_inv]
  set t : G := (c : G) with htdef
  have htz : t * z * t⁻¹ = z⁻¹ := by simpa using congrArg Subtype.val hcz
  have htd : t * d = d * t := congrArg Subtype.val hcd
  have htM : t ∈ M := normalizer_zpowers_z_le hsit (mem_normalizer_zpowers_of_conj_eq_inv htz)
  have h2 : 2 ≤ CFSG.Open.pRank 3 (M ⊓ centralizer ({d} : Set G)) := by
    have hcomm : ∀ y ∈ zpowers z, y * d = d * y := by
      rintro _ ⟨k, rfl⟩
      exact Commute.zpow_left (hD.z_central d hdQ).symm k
    have hcard := CFSG.RankThree.PartOne.Planes.card_sup_zpowers Nat.prime_three (zpowers z)
      hd3 hdz hcomm
    have : CFSG.IsElementaryAbelian 3 (zpowers z) :=
      CFSG.IsElementaryAbelian.zpowers_of_pow_eq_one hz3
    have : CFSG.IsElementaryAbelian 3 (zpowers d) :=
      CFSG.IsElementaryAbelian.zpowers_of_pow_eq_one hd3
    have hF : CFSG.IsElementaryAbelian 3 ↥(zpowers z ⊔ zpowers d) :=
      CFSG.IsElementaryAbelian.sup_of_le_centralizer
        (zpowers_le.mpr (mem_centralizer_iff.mpr hcomm))
    have hle : zpowers z ⊔ zpowers d ≤ M ⊓ centralizer ({d} : Set G) := by
      refine sup_le (zpowers_le.mpr (mem_inf.mpr ⟨hzM, ?_⟩))
        (zpowers_le.mpr (mem_inf.mpr ⟨hdM, mem_centralizer_singleton_iff.mpr rfl⟩))
      exact mem_centralizer_singleton_iff.mpr (hD.z_central d hdQ).symm
    exact le_pRank_of_isElemAbelian Nat.prime_three hle
      ((CFSG.SectionRank.isElementaryAbelian_iff_isElemAbelian 3 _).1 hF)
      (by rw [hcard, Nat.card_zpowers, hzo]; norm_num)
  have hCd : centralizer ({d} : Set G) ≤ M :=
    centralizer_le_of_inverted hT hNC hQ hsit hnα hdM hdo h2 htM htd hzM
      (hD.z_central d hdQ).symm hz3 hz1 htz
  set Yb : Subgroup (Bar ↥H) := (M.subgroupOf H).map (barMk ↥H) with hYb
  have hCY : centralizer ({barMk ↥H d'} : Set (Bar ↥H)) ≤ Yb := by
    rw [K2.centralizer_map_quotient _ hO hd'o]
    refine map_mono fun h hh => mem_subgroupOf.mpr (hCd (mem_centralizer_singleton_iff.mpr ?_))
    exact congrArg Subtype.val (mem_centralizer_singleton_iff.mp hh)
  set U₁ : Subgroup ↥H := Q.subgroupOf H ⊓ (kb H K).comap (barMk ↥H) with hU₁def
  have hU₁p : IsPGroup 3 U₁ := hQ'p.to_le inf_le_left
  have hU₁map : U₁.map (barMk ↥H) = qb H Q ⊓ kb H K := by
    apply le_antisymm
    · rintro _ ⟨u, hu, rfl⟩
      exact ⟨mem_map_of_mem _ hu.1, hu.2⟩
    · rintro _ ⟨⟨q', hq', rfl⟩, hy⟩
      exact ⟨q', ⟨hq', hy⟩, rfl⟩
  have hU₁rank : 2 ≤ CFSG.Open.pRank 3 (U₁.map H.subtype) := by
    rw [CFSG.LocalAnalysis.RankFourTheoremC.PEmpty.pRank_map_subtype (by norm_num),
      ← K2.qs_pRank hQ'p inf_le_left, hU₁map]
    have hsylQ : CFSG.ABGLocalTools.IsSylowOf 3 (qb H Q) ⊤ := by
      refine CFSG.ABGLocalTools.isSylowOf_iff.mpr ⟨le_top, hQb ▸ Qb.isPGroup', ?_⟩
      rw [relIndex_top_right, ← hQb]
      exact Qb.not_dvd_index
    obtain ⟨hle, hp, hidx⟩ := CFSG.ABGLocalTools.isSylowOf_iff.mp
      (hsylQ.inf_of_le_normalizer le_top (le_normalizer_of_normal (H := kb H K)))
    rw [pRank_eq_of_sylow Nat.prime_three hle hp hidx, pRank_of_equiv e]
  have hNY : normalizer (((Qb : Subgroup (Bar ↥H)) ⊓ kb H K : Subgroup (Bar ↥H)) :
      Set (Bar ↥H)) ≤ Yb := by
    rw [hQb, ← hU₁map]
    refine (K2.normalizer_map_le_map_normalizer _ hO hU₁p).trans (map_mono fun h hh => ?_)
    have hh' : (h : G) ∈ H ⊓ normalizer ((U₁.map H.subtype : Subgroup G) : Set G) := by
      rw [← CFSG.RankThree.Coprime.map_subtype_normalizer]
      exact mem_map_of_mem _ hh
    have hR : U₁.map H.subtype ≤ Q := by
      rintro _ ⟨u, hu, rfl⟩
      exact mem_subgroupOf.mp hu.1
    exact mem_subgroupOf.mpr (hD.gamma _ hR hU₁rank ⟨hh'.2, hh'.1⟩).2
  have hKY : kb H K ≤ Yb :=
    hgen.trans (sup_le (inf_le_right.trans hNY) (inf_le_right.trans hCY))
  have hKM : K ≤ M := by
    intro k hk
    obtain ⟨m', hm', hmk⟩ := hKY (mem_map_of_mem (barMk ↥H)
      (mem_subgroupOf.mpr hk : (⟨k, hD.K_le hk⟩ : ↥H) ∈ K.subgroupOf H))
    have h1 : barMk ↥H (m'⁻¹ * ⟨k, hD.K_le hk⟩) = 1 := by
      rw [map_mul, map_inv, hmk, inv_mul_cancel]
    have h2 := hyp.core_le ((barMk_eq_one_iff _).mp h1)
    have hk' : k = (m' : G) * ((m'⁻¹ * ⟨k, hD.K_le hk⟩ : ↥H) : G) := by simp
    rw [hk']
    exact M.mul_mem (mem_subgroupOf.mp hm') h2
  exact hyp.optimal.ext.pair.not_le
    (hD.cover.trans (sup_le (sup_le inf_le_right hKM) hyp.core_le))

end CFSG.LocalAnalysis.RankThreeTheoremC.SmallRankE3.Parrott.P614.P614DOG
