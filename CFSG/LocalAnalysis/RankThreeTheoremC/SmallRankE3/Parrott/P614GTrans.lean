variable {G : Type} [Group G] [Finite G]

theorem card_mul_card_le_elem {S A V : Subgroup G} (hAS : A ≤ S) (hA : IsElemAbelian 2 A)
    (hmax : ∀ E : Subgroup G, E ≤ S → IsElemAbelian 2 E → Nat.card E ≤ Nat.card A)
    (hVS : V ≤ S) (hV : IsElemAbelian 2 V) {a : G} (ha : a ∈ A) :
    Nat.card ↥(A ⊓ centralizer (V : Set G)) * Nat.card V ≤
      Nat.card A * Nat.card ↥(centralizer ({a} : Set G) ⊓ V) := by
  set C : Subgroup G := A ⊓ centralizer (V : Set G) with hCdef
  have hCA : C ≤ A := inf_le_left
  have hCVc : C ≤ centralizer (V : Set G) := inf_le_right
  have hVC : V ≤ centralizer (C : Set G) := fun v hv =>
    Subgroup.mem_centralizer_iff.2 fun c hc => (Subgroup.mem_centralizer_iff.1 (hCVc hc) v hv).symm
  have hAc : ∀ x ∈ A, ∀ y ∈ A, x * y = y * x := fun x hx y hy => by
    have := hA.1
    exact setLike_mul_comm hx hy
  have hXc : IsMulCommutative ↥(C ⊔ V) := by
    have hCC : C ≤ centralizer (C : Set G) :=
      Subgroup.le_centralizer_iff_isMulCommutative.2 (by
        have := hA.1
        exact isMulCommutative_anti hCA)
    have hVV : V ≤ centralizer (V : Set G) := Subgroup.le_centralizer_iff_isMulCommutative.2 hV.1
    refine Subgroup.le_centralizer_iff_isMulCommutative.1 (sup_le ?_ ?_)
    · exact Subgroup.le_centralizer_iff.2 (sup_le hCC hVC)
    · exact Subgroup.le_centralizer_iff.2 (sup_le hCVc hVV)
  have hXe : IsElemAbelian 2 (C ⊔ V) := by
    have hcoe : ((C ⊔ V : Subgroup G) : Set G) = (C : Set G) * (V : Set G) :=
      coe_mul_of_left_le_normalizer_right C V (hCVc.trans (centralizer_le_normalizer _))
    refine ⟨hXc, fun x hx => ?_⟩
    rw [← SetLike.mem_coe, hcoe] at hx
    obtain ⟨c₁, hc₁, v₁, hv₁, rfl⟩ := Set.mem_mul.1 hx
    have hcv : c₁ * v₁ = v₁ * c₁ := (Subgroup.mem_centralizer_iff.1 (hCVc hc₁) v₁ hv₁).symm
    have h1 : c₁ ^ 2 = 1 := hA.2 c₁ (hCA hc₁)
    have h2 : v₁ ^ 2 = 1 := hV.2 v₁ hv₁
    rw [(show Commute c₁ v₁ from hcv).mul_pow, h1, h2, mul_one]
  have hXA : Nat.card ↥(C ⊔ V) ≤ Nat.card ↥A := hmax _ (sup_le (hCA.trans hAS) hVS) hXe
  have hprod := card_sup_mul_card_inf_of_le_normalizer (A := C) (N := V)
    (hCVc.trans (centralizer_le_normalizer _))
  have hCVle : C ⊓ V ≤ centralizer ({a} : Set G) ⊓ V := fun g hg =>
    Subgroup.mem_inf.2 ⟨Subgroup.mem_centralizer_singleton_iff.2
      (hAc _ (hCA (Subgroup.mem_inf.1 hg).1) _ ha), (Subgroup.mem_inf.1 hg).2⟩
  calc Nat.card ↥C * Nat.card ↥V = Nat.card ↥(C ⊔ V) * Nat.card ↥(C ⊓ V) := hprod.symm
    _ ≤ Nat.card ↥A * Nat.card ↥(centralizer ({a} : Set G) ⊓ V) :=
      Nat.mul_le_mul hXA (Subgroup.card_le_of_le hCVle)

theorem relIndex_centralizer_le_two {S A V O : Subgroup G} (hAS : A ≤ S)
    (hA : IsElemAbelian 2 A)
    (hmax : ∀ E : Subgroup G, E ≤ S → IsElemAbelian 2 E → Nat.card E ≤ Nat.card A)
    (hVS : V ≤ S) (hV : IsElemAbelian 2 V) (hOV : O ≤ centralizer (V : Set G))
    (hidx : O.relIndex A ≤ 2) {a : G} (ha : a ∈ A) :
    (centralizer ({a} : Set G)).relIndex V ≤ 2 := by
  have hAC : Nat.card ↥A ≤ 2 * Nat.card ↥(A ⊓ centralizer (V : Set G)) := by
    have h := Subgroup.relIndex_mul_card (H := O) (K := A)
    rw [inf_comm] at h
    calc Nat.card ↥A = O.relIndex A * Nat.card ↥(A ⊓ O) := h.symm
      _ ≤ 2 * Nat.card ↥(A ⊓ O) := Nat.mul_le_mul_right _ hidx
      _ ≤ 2 * Nat.card ↥(A ⊓ centralizer (V : Set G)) :=
          Nat.mul_le_mul_left _ (Subgroup.card_le_of_le (inf_le_inf_left A hOV))
  have hCpos : 0 < Nat.card ↥(A ⊓ centralizer (V : Set G)) := Nat.card_pos
  have hV2 : Nat.card ↥V ≤ 2 * Nat.card ↥(centralizer ({a} : Set G) ⊓ V) := by
    have hle : Nat.card ↥(A ⊓ centralizer (V : Set G)) * Nat.card ↥V ≤
        Nat.card ↥(A ⊓ centralizer (V : Set G)) *
          (2 * Nat.card ↥(centralizer ({a} : Set G) ⊓ V)) :=
      calc _ ≤ Nat.card ↥A * Nat.card ↥(centralizer ({a} : Set G) ⊓ V) :=
            card_mul_card_le_elem hAS hA hmax hVS hV ha
        _ ≤ (2 * Nat.card ↥(A ⊓ centralizer (V : Set G))) *
              Nat.card ↥(centralizer ({a} : Set G) ⊓ V) := Nat.mul_le_mul_right _ hAC
        _ = _ := by ring
    exact Nat.le_of_mul_le_mul_left hle hCpos
  have h := Subgroup.relIndex_mul_card (H := centralizer ({a} : Set G)) (K := V)
  have hpos : 0 < Nat.card ↥(centralizer ({a} : Set G) ⊓ V) := Nat.card_pos
  refine Nat.le_of_mul_le_mul_right ?_ hpos
  rw [h]
  exact hV2

namespace Ctx

variable {M B H S K : Subgroup G} {z : G}

theorem H_le_normalizer_V (c : Ctx M B H S K z) :
    H ≤ normalizer ((omegaCenter (pCoreOf 2 H) : Subgroup G) : Set G) :=
  c.H_le_normalizer_core.trans (normalizer_le_normalizer_omegaCenter _)

theorem core_le_centralizer_V (c : Ctx M B H S K z) :
    pCoreOf 2 H ≤ centralizer ((omegaCenter (pCoreOf 2 H) : Subgroup G) : Set G) := by
  rw [← le_centralizer_iff]
  exact omegaCenter_le_centralizer _

theorem mem_core_of_mem_K_of_centralizer (c : Ctx M B H S K z) {k : G} (hk : k ∈ K)
    (hkV : k ∈ centralizer ((omegaCenter (pCoreOf 2 H) : Subgroup G) : Set G)) :
    k ∈ pCoreOf 2 H := by
  set V := omegaCenter (pCoreOf 2 H) with hV
  set N := K ⊓ centralizer (V : Set G) with hN
  have hNK : N ≤ K := inf_le_left
  have hNn : (N.subgroupOf K).Normal := by
    refine ⟨fun n hn g => mem_subgroupOf.mpr ?_⟩
    show (g : G) * (n : G) * (g : G)⁻¹ ∈ K ⊓ centralizer (V : Set G)
    refine mem_inf.mpr ⟨?_, ?_⟩
    · exact K.mul_mem (K.mul_mem g.2 (mem_subgroupOf.mp hn).1) (K.inv_mem g.2)
    · have hnC := (mem_subgroupOf.mp hn).2
      have hgN := c.H_le_normalizer_V (c.K_le g.2)
      rw [mem_centralizer_iff]
      intro v hv
      have hv' : (g : G)⁻¹ * v * g ∈ V := (mem_normalizer_iff''.mp hgN v).1 hv
      have := mem_centralizer_iff.mp hnC _ hv'
      calc v * ((g : G) * n * (g : G)⁻¹) = g * (((g : G)⁻¹ * v * g) * n) * (g : G)⁻¹ := by group
        _ = g * (n * ((g : G)⁻¹ * v * g)) * (g : G)⁻¹ := by rw [this]
        _ = (g : G) * n * (g : G)⁻¹ * v := by group
  have hle : K ⊓ pCoreOf 2 H ≤ N := le_inf inf_le_left (inf_le_right.trans c.core_le_centralizer_V)
  rcases c.K_maximal N hNK hNn hle with h | h
  · have : k ∈ N := ⟨hk, hkV⟩
    rw [h] at this
    exact this.2
  · exfalso
    have hCS : S ⊓ centralizer (pCoreOf 2 H : Set G) ≤ pCoreOf 2 H :=
      (inf_le_inf_right _ c.S_le).trans c.charTwo
    have hZV : omegaCenter S ≤ V := omegaCenter_le_omegaCenter c.core_le hCS
    have hKN : K ≤ normalizer ((omegaCenter S : Subgroup G) : Set G) := by
      intro g hg
      have hgC : g ∈ centralizer (V : Set G) := (h ▸ hg : g ∈ N).2
      have hgC' : g ∈ centralizer ((omegaCenter S : Subgroup G) : Set G) :=
        centralizer_le hZV hgC
      exact centralizer_le_normalizer _ hgC'
    exact c.K_not_le (hKN.trans (c.char_le _ (omegaCenter_le S) (omegaCenter_ne_bot
      c.isPGroup_S c.S_ne_bot) (omegaCenter_characteristic S)))

theorem exists_offender (c : Ctx M B H S K z) :
    ∃ A ∈ CFSG.elemThompsonFamily ↥S 2, ¬ A.map S.subtype ≤ pCoreOf 2 H := by
  have : Fact (Nat.Prime 2) := ⟨Nat.prime_two⟩
  by_contra hcon
  push Not at hcon
  set Y := (pCoreOf 2 H).subgroupOf S with hY
  have hJY : CFSG.elemThompson ↥S 2 ≤ Y := sSup_le fun A hA => fun x hx =>
    mem_subgroupOf.mpr (hcon A hA ⟨x, hx, rfl⟩)
  have h1 := CFSG.Quasithin.BlueprintB2.elemThompson_map_subtype (p := 2) hJY
  have hYmap : Y.map S.subtype = pCoreOf 2 H := map_subgroupOf_eq_of_le c.core_le
  have h2 := CFSG.RankThree.Coprime.map_map_elemThompson_subtype (f := S.subtype) (X := Y)
    (S.subtype_injective.comp Y.subtype_injective) 2
  rw [h1, hYmap] at h2
  have hNJ : H ≤ normalizer (((CFSG.elemThompson ↥S 2).map S.subtype : Subgroup G) : Set G) := by
    rw [h2]
    exact c.H_le_normalizer_core.trans
      (CFSG.RankThree.Coprime.normalizer_le_normalizer_map_elemThompson _)
  have hchar : (((CFSG.elemThompson ↥S 2).map S.subtype).subgroupOf S).Characteristic := by
    rw [show ((CFSG.elemThompson ↥S 2).map S.subtype).subgroupOf S = CFSG.elemThompson ↥S 2 from
      comap_map_eq_self_of_injective S.subtype_injective _]
    exact CFSG.Quasithin.BlueprintB2.elemThompson_characteristic ↥S 2
  have hne := CFSG.RankThree.Coprime.map_elemThompson_ne_bot c.isPGroup_S c.S_ne_bot
  exact c.K_not_le ((c.K_le.trans hNJ).trans (c.char_le _ (map_subtype_le _) hne hchar))

@[expose] noncomputable def rhoS (c : Ctx M B H S K z) : Subgroup (MulAut (Kbar K)) :=
  (S.subgroupOf H).map c.rho

theorem rho_mem_rhoS (c : Ctx M B H S K z) {s : G} (hs : s ∈ S) :
    c.rho ⟨s, c.S_le hs⟩ ∈ c.rhoS :=
  mem_map_of_mem _ (mem_subgroupOf.mpr hs)

theorem relIndex_le_two (c : Ctx M B H S K z) (hcyc : IsCyclic c.rhoS) {A : Subgroup G}
    (hAS : A ≤ S) (hA : IsElemAbelian 2 A) : (pCoreOf 2 H).relIndex A ≤ 2 := by
  let φ : ↥A →* MulAut (Kbar K) := c.rho.comp (Subgroup.inclusion (hAS.trans c.S_le))
  have hker : φ.ker = (pCoreOf 2 H).subgroupOf A := by
    ext a
    rw [MonoidHom.mem_ker, mem_subgroupOf]
    constructor
    · intro h
      exact c.mem_core_of_trivial _ h (mem_sup_right (hAS a.2))
    · intro h
      exact c.rho_eq_one_of_mem_core h
  have hrange : φ.range ≤ c.rhoS := by
    rintro _ ⟨a, rfl⟩
    exact c.rho_mem_rhoS (hAS a.2)
  have : IsCyclic φ.range := Subgroup.isCyclic_of_le hrange
  obtain ⟨g, hg⟩ := IsCyclic.exists_generator (α := φ.range)
  have hcard := orderOf_eq_card_of_forall_mem_zpowers hg
  have hg2 : g ^ 2 = 1 := by
    obtain ⟨a, ha⟩ := g.2
    apply Subtype.ext
    rw [SubgroupClass.coe_pow, ← ha, ← map_pow]
    have : a ^ 2 = 1 := Subtype.ext (hA.2 a a.2)
    rw [this, map_one]
    rfl
  rw [relIndex, ← hker, index_ker, ← hcard]
  exact Nat.le_of_dvd (by norm_num) (orderOf_dvd_of_pow_eq_one hg2)

theorem exists_transvection (c : Ctx M B H S K z) (hcyc : IsCyclic c.rhoS) :
    ∃ a ∈ S, a ∉ pCoreOf 2 H ∧
      (centralizer ({a} : Set G)).relIndex (omegaCenter (pCoreOf 2 H)) ≤ 2 := by
  have : Fact (Nat.Prime 2) := ⟨Nat.prime_two⟩
  obtain ⟨A, hA, hAO⟩ := c.exists_offender
  obtain ⟨a, ⟨a', ha', rfl⟩, haO⟩ := SetLike.not_le_iff_exists.mp hAO
  set AG := A.map S.subtype with hAG
  have hAGS : AG ≤ S := map_subtype_le _
  have hAGe : IsElemAbelian 2 AG :=
    (CFSG.SectionRank.isElementaryAbelian_iff_isElemAbelian 2 AG).1
