theorem odd_exponent_of_card_mod_three (q : TauCeti.PrimePower) (hq : q.p = 2)
    (h : q.card % 3 = 2) : Odd q.exponent := by
  rw [TauCeti.PrimePower.card_def, hq] at h
  rcases Nat.even_or_odd q.exponent with ⟨k, hk⟩ | ho
  · exfalso
    rw [hk, ← two_mul, pow_mul, Nat.pow_mod] at h
    norm_num at h
  · exact ho

theorem two_le_exponent (q : TauCeti.PrimePower) (hq : q.p = 2) (h : 3 ≤ q.card) :
    2 ≤ q.exponent := by
  rw [TauCeti.PrimePower.card_def, hq] at h
  by_contra hlt
  have h1 : q.exponent = 1 := by have := q.exponent_pos; omega
  rw [h1] at h
  norm_num at h

theorem nonempty_lieA_equiv_psl (r : ℕ) (q : TauCeti.PrimePower) (hq : q.p = 2)
    (hv : (TauCeti.LieTypeIndex.A r q).Valid) :
    Nonempty (TauCeti.ValidLieTypeIndex.Group ⟨.A r q, hv⟩ ≃*
      Matrix.ProjectiveSpecialLinearGroup (Fin (r + 1)) (GaloisField 2 q.exponent)) := by
  have : Fact q.p.Prime := ⟨q.prime_p⟩
  have hK : Nat.card (GaloisField q.p q.exponent) = 2 ^ q.exponent := by
    rw [GaloisField.card _ _ q.exponent_pos.ne', hq]
  exact ⟨(CFSG.ClassicalModels.linearCatalogCandidateEquivPSL r q hv).trans
    (CFSG.ClassicalModels.projectiveSpecialLinearFieldEquiv
      (CFSG.ClassicalModels.finiteFieldEquivGaloisField _ 2 q.exponent q.exponent_pos hK)
      (Fin (r + 1)))⟩

theorem fusionIsBenderGroup_of_lieA_one {K : Type} [Group K] (q : TauCeti.PrimePower)
    (hq : q.p = 2) (hv : (TauCeti.LieTypeIndex.A 1 q).Valid)
    (e : K ≃* TauCeti.ValidLieTypeIndex.Group ⟨.A 1 q, hv⟩) : fusionIsBenderGroup K := by
  have hr := (TauCeti.LieTypeIndex.inStandardRange_iff _).mp
    ((TauCeti.LieTypeIndex.valid_iff _).mp hv).1
  have hm : 2 ≤ q.exponent := two_le_exponent q hq (le_trans (by norm_num) (hr.2 rfl))
  obtain ⟨e'⟩ := nonempty_lieA_equiv_psl 1 q hq hv
  exact Or.inl ⟨q.exponent, hm, ⟨e.trans e'⟩⟩

theorem fusionIsBenderGroup_of_lieTwistedA_two {K : Type} [Group K] (q : TauCeti.PrimePower)
    (hq : q.p = 2) (hv : (TauCeti.LieTypeIndex.twistedA 2 q).Valid)
    (e : K ≃* TauCeti.ValidLieTypeIndex.Group ⟨.twistedA 2 q, hv⟩) : fusionIsBenderGroup K := by
  have hr := (TauCeti.LieTypeIndex.inStandardRange_iff _).mp
    ((TauCeti.LieTypeIndex.valid_iff _).mp hv).1
  have hm : 2 ≤ q.exponent := two_le_exponent q hq (hr.2 rfl)
  have hc : TauCeti.ValidLieTypeIndex.characteristic ⟨.twistedA 2 q, hv⟩ = q.p :=
    TauCeti.LieTypeIndex.characteristic_twistedA 2 q
  have hf : TauCeti.ValidLieTypeIndex.fieldExponent ⟨.twistedA 2 q, hv⟩ = q.exponent :=
    TauCeti.LieTypeIndex.fieldExponent_twistedA 2 q
  have hmodel : StatedClassicalModel K .PSU 3 q.p q.exponent := by
    have := CFSG.Models.LieModel.statedClassicalModel_of_ne_zero (by norm_num)
      (CFSG.Models.lieModel_twistedA 2 q hv e)
    rwa [hc, hf] at this
  rw [hq] at hmodel
  obtain ⟨e'⟩ := CFSG.ComponentClassification.GMS78.nonempty_mulEquiv_psu3_of_stated hm hmodel
  exact Or.inr (Or.inl ⟨q.exponent, hm, ⟨e'⟩⟩)

theorem fusionIsBenderGroup_of_lieSuzuki {K : Type} [Group K] (m : ℕ)
    (hv : (TauCeti.LieTypeIndex.suzuki m).Valid)
    (e : K ≃* TauCeti.ValidLieTypeIndex.Group ⟨.suzuki m, hv⟩) : fusionIsBenderGroup K := by
  have hm : 1 ≤ m :=
    (TauCeti.LieTypeIndex.inStandardRange_iff _).mp ((TauCeti.LieTypeIndex.valid_iff _).mp hv).1
  exact Or.inr (Or.inr ⟨m, hm, ⟨(e.trans (CFSG.BenderSuzuki.Catalog.groupEquivSuzukiMatrixGroup
    hv)).trans (MulEquiv.subgroupCongr ((CFSG.Models.benderSzModel_eq_sz m).symm.trans
      (CFSG.BenderSuzuki.szModel_eq_suzukiMatrixGroup m))).symm⟩⟩)

theorem fusionIsBenderGroup_of_alt5 {K : Type} [Group K] (e : K ≃* alternatingGroup (Fin 5)) :
    fusionIsBenderGroup K := by
  have hK : Nat.card (GaloisField 2 2) = 4 := by
    rw [GaloisField.card 2 2 (by norm_num)]
    norm_num
  have hcard : Nat.card SL(2, GaloisField 2 2) = 60 := by
    rw [CFSG.SL2MinimalFaithful.card_specialLinearGroup_fin_two, hK]
    norm_num
  obtain ⟨e5⟩ := CFSG.Quasithin.A5Model.sl2_four_equiv_alt5 (GaloisField 2 2) hK hcard
  have hc := CFSG.CGT.PushingUpLit.CGT6.sl2_center_eq_bot (GaloisField 2 2)
  exact Or.inl ⟨2, le_rfl, ⟨(e.trans e5.symm).trans
    (QuotientGroup.quotientBot.symm.trans (QuotientGroup.quotientMulEquivOfEq hc.symm))⟩⟩

theorem nonempty_lieA_seven_equiv_psl_three {K : Type} [Group K] (q : TauCeti.PrimePower)
    (hq : q.card = 7) (hv : (TauCeti.LieTypeIndex.A 1 q).Valid)
    (e : K ≃* TauCeti.ValidLieTypeIndex.Group ⟨.A 1 q, hv⟩) :
    Nonempty (K ≃* PSL(3, GaloisField 2 1)) := by
  have hpq : q.p = 7 ∧ q.exponent = 1 :=
    Nat.prime_seven.pow_eq_iff.1 (by rw [← TauCeti.PrimePower.card_def]; exact hq)
  have hS := CFSG.Models.LieModel.statedClassicalModel_of_ne_zero (by norm_num)
    (CFSG.Models.lieModel_A 1 q hv e)
  rw [hpq.1, hpq.2] at hS
  obtain ⟨-, F, _, _, hF, ⟨e'⟩⟩ :=
    CFSG.Open.StatedAPI.statedClassicalModel_psl_three_two_of_psl_two_seven hS
  exact ⟨e'.trans
    ((CFSG.Assembly.LowTwoRank.projectiveSpecialLinearGroupEquivStatedProj 3 F).symm.trans
      (CFSG.ClassicalModels.projectiveSpecialLinearFieldEquiv
        (CFSG.ClassicalModels.finiteFieldEquivGaloisField F 2 1 one_pos hF) (Fin 3)))⟩

theorem false_of_alt {K : Type} [Group K] [Finite K] {n : ℕ} (hn : 6 ≤ n)
    (e : K ≃* alternatingGroup (Fin n)) (hr : CFSG.Open.pRank 3 (⊤ : Subgroup K) = 1) : False := by
  have h1 := CFSG.LocalAnalysis.RankThreeTheoremC.KFactProofs.K3.l62_two_le_pRank_alternating n hn
  have h2 := CFSG.SectionRank.pRank_top_eq_of_mulEquiv (p := 3) (by norm_num) e
  omega

end P614KCR

