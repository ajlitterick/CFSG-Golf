section Main


theorem kFactChevTwoRankOneThree_holds : KFactChevTwoRankOneThree := by
  intro K _ _ _ _ hc hr hnb
  rcases hc with ⟨⟨d, hv⟩, hd2, ⟨e⟩⟩ | ⟨n, hn, ⟨e⟩⟩ | ⟨⟨d, hv⟩, hd, ⟨e⟩⟩
  · rcases CFSG.LocalAnalysis.RankFourTheoremC.PEmpty.three_rank_le_one_lie ⟨d, hv⟩ e hr.le with
      ⟨q, -, hdq⟩ | ⟨q, hq3, hdq⟩ | ⟨q, -, hdq⟩ | ⟨m, hdq⟩ <;>
      change d = _ at hdq <;> subst hdq
    · exact (hnb (fusionIsBenderGroup_of_lieA_one q hd2 hv e)).elim
    · obtain ⟨e'⟩ := nonempty_lieA_equiv_psl 2 q hd2 hv
      exact ⟨q.exponent, odd_exponent_of_card_mod_three q hd2 hq3, ⟨e.trans e'⟩⟩
    · exact (hnb (fusionIsBenderGroup_of_lieTwistedA_two q hd2 hv e)).elim
    · exact (hnb (fusionIsBenderGroup_of_lieSuzuki m hv e)).elim
  · rcases hn with rfl | rfl | rfl
    · exact (hnb (fusionIsBenderGroup_of_alt5 e)).elim
    · exact (false_of_alt (by norm_num) e hr).elim
    · exact (false_of_alt (by norm_num) e hr).elim
  · rcases hd with ⟨q, hq7, hdq⟩ | ⟨q, hq3, hdq⟩ <;> change d = _ at hdq <;> subst hdq
    · exact ⟨1, odd_one, nonempty_lieA_seven_equiv_psl_three q hq7 hv e⟩
    · exfalso
      rcases CFSG.LocalAnalysis.RankFourTheoremC.PEmpty.three_rank_le_one_lie ⟨_, hv⟩ e hr.le with
        ⟨q', -, h⟩ | ⟨q', -, h⟩ | ⟨q', hq', h⟩ | ⟨m, h⟩ <;> change _ = _ at h
      · cases h
      · cases h
      · cases h
        omega
      · cases h

end Main

