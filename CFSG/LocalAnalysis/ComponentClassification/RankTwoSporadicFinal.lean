namespace CFSG.ComponentClassification.RankTwoSporadic

open CFSG.ComponentClassification.AS76b

theorem rankTwoSporadicStandard_of_open
    (h2C : B.B2CFact) (h2D : B.B2DFact) :
    RankTwoStandard.RankTwoSporadicStandard := by
  have h32 := RankTwoFoundation.lemma32
  have h33 := RankTwoFoundation.lemma33Three
  have h3L := RankTwoFoundation.asc76Theorem3Large
  have h22 := Asc76.asc76Lemma22 AschbacherTheorem3.theorem_3_holds
  have h4' := Asc76X.asc76Theorem4_of_lemma28 Asc76.asc76Lemma28
  refine rankTwoSporadicStandard_of_odd fun s => ?_
  cases s with
  | M11 => exact M11.sporadicCaseOdd_M11 h32 h33
  | M12 => exact M12.sporadicCaseOdd_M12 h3L h22 h4'
  | M22 => exact M22.sporadicCaseOdd_M22 h32 h33
  | M23 => exact M23.sporadicCaseOdd_M23 h32 h33
  | M24 => exact M24.sporadicCaseOdd_M24 h32 h33
  | J1 => exact J1.sporadicCaseOdd_J1 h32 h33
  | J2 => exact J2End.sporadicCaseOdd_J2 h32 h33
  | J3 => exact J3.sporadicCaseOdd_J3 h32 h33
  | J4 => exact J4Fink.sporadicCaseOdd_J4_of_noDoubleCover h32 h33 J4.j4NoDoubleCover_checked
  | HS => exact HS.sporadicCaseOdd_HS h32 h33
  | McL => exact McL.sporadicCaseOdd_McL h32 h33
  | He => exact He.sporadicCaseOdd_He_of_lemmas h32 h33
  | Ru => exact Ru.sporadicCaseOdd_Ru h32 h33
  | Suz => exact Suz.sporadicCaseOdd_Suz h32 h33
  | ONan => exact ONan.sporadicCaseOdd_ONan h32 h33
  | Co1 => exact Co1.sporadicCaseOdd_Co1 h32 h33
  | Co2 => exact Co2.sporadicCaseOdd_Co2 h32 h33
  | Co3 => exact Co3.sporadicCaseOdd_Co3 h32 h33
  | Fi22 => exact Fi22.sporadicCaseOdd_Fi22 h32 h33
  | Fi23 => exact Fi23.sporadicCaseOdd_Fi23 h32 h33
  | Fi24Prime =>
    exact CFSG.ComponentClassification.RankTwoSporadic.Fi24Prime.sporadicCaseOdd_Fi24Prime h32 h33
  | HN => exact HN.sporadicCaseOdd_HN h32 h33
  | Ly => exact Ly.sporadicCaseOdd_Ly h32 h33
  | Th => exact Th.sporadicCaseOdd_Th h32 h33
  | B => exact B.sporadicCaseOdd_B_of_classFacts h32 h33 h2C h2D
  | M => exact Monster.sporadicCaseOdd_M h32 h33

end CFSG.ComponentClassification.RankTwoSporadic
