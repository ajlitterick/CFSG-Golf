namespace CFSG.ComponentClassification.StandardRecognition.CatalogRoute

open CFSG.Blueprint CFSG.Blueprint.NativeSporadic CFSG.Blueprint.Recognition

@[expose] def CTUStatement : Prop :=
  ∀ (G : Type) [Group G] [Finite G] [IsSimpleGroup G], (∃ a b : G, a * b ≠ b * a) →
    CFSG.Assembly.KProper CFSG.Blueprint.Catalog G → ∀ z : G, orderOf z = 2 →
    CFSG.oddCore (Subgroup.centralizer ({z} : Set G)) ≠ ⊥ →
    CFSG.Blueprint.OddLieType G ∨
      ∃ n : ℕ, 7 ≤ n ∧ n % 4 = 3 ∧ Nonempty (G ≃* alternatingGroup (Fin n))

theorem catalog_of_alternating {X : Type} [Group X] {n : ℕ} (hn : 5 ≤ n)
    (h : Nonempty (X ≃* alternatingGroup (Fin n))) : Catalog X :=
  .inr (.inl ⟨n, hn, h⟩)

theorem catalog_of_oddLieType {X : Type} [Group X] (h : OddLieType X) : Catalog X :=
  Milestones.ct_catalog_nonabelian_type_partition_converse X (.inr (.inl h))

theorem catalog_of_isSporadic {X : Type} [Group X] {s : TauCeti.SporadicName}
    (h : IsSporadic X s) : Catalog X :=
  .inr (.inr (.inr (.inr ⟨s, h⟩)))

theorem catalog_of_evenSporadicOutcome {X : Type} [Group X] (h : EvenSporadicOutcome X) :
    Catalog X := by
  rcases h with h | h | h | h | h | h | h <;> exact catalog_of_isSporadic h

theorem exactTypePartition
    (hbridge : ∀ (X : Type) [Group X] [Finite X] [IsSimpleGroup X], (∃ a b : X, a * b ≠ b * a) →
      Assembly.InCatalog X → Catalog X)
    {G : Type} [Group G] [Finite G] [IsSimpleGroup G] (hnonab : ∃ a b : G, a * b ≠ b * a)
    (hK : Assembly.KProper Assembly.InCatalog G) {L : Subgroup G}
    (hL : Assembly.ComponentType.IsStandardSubgroup L) :
    Exact.OddStandardType (L ⧸ Subgroup.center L) ∨
      (Exact.EvenStandardType (L ⧸ Subgroup.center L) ∧
        ¬ Exact.EvenStandardException (L ⧸ Subgroup.center L)) := by
  obtain ⟨-, hcat⟩ :=
    ComponentClassification.StandardRecognition.standard_quotient_inCatalog G hnonab hK L hL
  have : IsSimpleGroup (L ⧸ Subgroup.center L) := hL.1.2
  have hQ := ComponentClassification.StandardRecognition.exists_mul_ne_mul_of_isQuasisimple hL.1
  have hsplit (h : Exact.EvenStandardType (L ⧸ Subgroup.center L)) :
      Exact.OddStandardType (L ⧸ Subgroup.center L) ∨
        (Exact.EvenStandardType (L ⧸ Subgroup.center L) ∧
          ¬ Exact.EvenStandardException (L ⧸ Subgroup.center L)) := by
    by_cases hexc : Exact.EvenStandardException (L ⧸ Subgroup.center L)
    · exact .inl (Exact.evenStandardException_oddStandardType _ hexc)
    · exact .inr ⟨h, hexc⟩
  rcases (Milestones.ct_catalog_nonabelian_type_partition _ hQ).1 (hbridge _ hQ hcat) with
    h | h | h | h
  · exact .inl (.inl h)
  · exact .inl (.inr (.inl h))
  · exact hsplit (.inl h)
  · exact hsplit (.inr h)

section Assembly

theorem standard_recognition_of_catalog_milestones
    (hCTU : CTUStatement)
    (hOdd : CFSG.EvenSporadicStandard.Induction.CTOddStandardStatement)
    (hEvenRes : CFSG.EvenSporadicStandard.Induction.CTEvenResidualStatement)
    (hCTSS : CFSG.EvenSporadicStandard.ModelsStatement)
    (hCIT : ClassicalInvolutionTheoremModels) :
    StandardRecognitionStatement := by
  intro G _ _ _ hnonab hK L hL
  have hKB : Assembly.KProper Catalog G :=
    Open.CTInitialFrontierTauCeti.kProper_catalog_of_bridge
      RankThree.PartOne.TCB.tauCetiCatalogBridge hK
  refine Open.QTFaithfulEmptyTauCeti.inCatalog_of_catalog G ?_
  by_cases hub : ∃ z : G, orderOf z = 2 ∧ CFSG.oddCore (Subgroup.centralizer ({z} : Set G)) ≠ ⊥
  · obtain ⟨z, hz, hne⟩ := hub
    rcases hCTU G hnonab hKB z hz hne with h | ⟨n, hn, -, he⟩
    · exact catalog_of_oddLieType h
    · exact catalog_of_alternating (by omega) he
  have hcore : ∀ t : G, orderOf t = 2 → CFSG.oddCore (Subgroup.centralizer ({t} : Set G)) = ⊥ :=
    fun t ht => not_not.1 fun hne => hub ⟨t, ht, hne⟩
  obtain ⟨S⟩ : Nonempty (Sylow 2 (Subgroup.centralizer (L : Set G))) := Sylow.nonempty
  rcases ComponentClassification.StandardRecognition.standard_centralizer_rank_split hL S with
    hrank | ⟨hcyc, -⟩ | ⟨r, hr, hiso, -⟩
  ·
    rcases Milestones.ct_rank_two_standard_recognition_frontier_models G hnonab hKB L hL hrank with
      ⟨n, hn, he⟩ | h | h | h | h | h
    · exact catalog_of_alternating (by omega) he
    all_goals exact catalog_of_isSporadic h
  ·
    rcases exactTypePartition RankThree.PartOne.TCB.tauCetiCatalogBridge hnonab hK hL with
      hodd | ⟨heven, hexc⟩
    · rcases hOdd G hnonab hKB L hL hodd with ⟨n, hn, he⟩ | h | h | h | h | h | h | h | h | h | h
      · exact catalog_of_alternating (by omega) he
      · exact catalog_of_oddLieType h
      all_goals exact catalog_of_isSporadic h
    · have hres := hEvenRes G hnonab hKB L hL hcore S hcyc heven hexc
      obtain ⟨h2, hA | hB | hC | hD⟩ := id hres
      · exact catalog_of_evenSporadicOutcome (hCTSS G hnonab hKB L hL hcore S hcyc heven hexc hres
          hA.1 (center_eq_bot_of_m12_or_j2 m12J2DoubleCoverExclusion
            m12J2CentralTwoGroupOrderBound hnonab hK hL hcore S hcyc h2))
      · exact catalog_of_evenSporadicOutcome (Milestones.ct_even_small_lie_standard_frontier_models
          G hnonab hKB L hL hcore S hcyc heven hexc hres (.inl hB))
      · exact catalog_of_evenSporadicOutcome (Milestones.ct_even_small_lie_standard_frontier_models
          G hnonab hKB L hL hcore S hcyc heven hexc hres (.inr (.inl hC)))
      · exact catalog_of_evenSporadicOutcome (Milestones.ct_even_small_lie_standard_frontier_models
          G hnonab hKB L hL hcore S hcyc heven hexc hres (.inr (.inr hD)))
  ·
    rcases ComponentClassification.StandardRecognition.quaternion_standard_recognition hCIT hnonab
        hL S hr hiso with h | h | h
    · exact catalog_of_oddLieType h
    all_goals exact catalog_of_isSporadic h

end Assembly

end CFSG.ComponentClassification.StandardRecognition.CatalogRoute
