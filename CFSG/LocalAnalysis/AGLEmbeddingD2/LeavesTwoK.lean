theorem aschbacherTwoK_solomonK_of_remaining
    (hA8 : CFSG.CGT.T75P.A8SylowInput)
    (hNA : CFSG.CGT.PushingUpLit.SolKAb.SolomonTimmesfeldMainNonAbelian) :
    CFSG.CGT.PushingUpLit.AschbacherTheoremTwoK ∧
      CFSG.CGT.PushingUpLit.SolomonAlternatingBlockK := by
  have hSolIn : CFSG.RankThree.PartOne.SolIn.Inputs :=
    (⟨hNA, CFSG.CGT.PushingUpLit.SolKR2.solomonTimmesfeldMainRankTwo_holds⟩ :
      CFSG.CGT.PushingUpLit.SolKAb.SolomonTimmesfeldMainResidue)
  have hGriess : CFSG.Open.GriessAllModelsStatement := fun _ _ t n p f hmodel =>
    CFSG.LieType.Steinberg.CentralExt.GriessTwistedE6Two.griess_all_models_of_twistedE6_two
      CFSG.LieType.Steinberg.CentralExt.TwistedE6TwoCover.twistedE6TwoMultiplier t n p f hmodel
  have hEmb : CFSG.CGT.PushingUpLit.CGT6.AschbacherEmbeddingK :=
    CFSG.CGT.PushingUpLit.CGT6K1.aschbacherEmbeddingK_of_inputs'
      CFSG.ComponentClassification.GSThmB.aschbacherTheorem5Input_holds
      CFSG.ComponentClassification.AschbacherKnownGroup.knownGroupFacts_holds
      CFSG.RankThree.PartOne.TCB.schreierFor_inCatalog_holds
      (CFSG.ComponentClassification.Asc75T4.asc75Theorem4_of_steps
        CFSG.ComponentClassification.AschbacherTheorem3.theorem_3_holds
        CFSG.ComponentClassification.AschbacherTheorem5.conclusion_holds
        CFSG.ComponentClassification.Asc75T4.stepConjNormalizer
        CFSG.ComponentClassification.Asc75T4.stepEndgame
        (CFSG.ComponentClassification.Asc75T4.stepRankOne
          CFSG.ComponentClassification.AschbacherTheorem3.theorem_3_holds))
      CFSG.CGT.PushingUpLit.K1R.stdKernelTwo_holds hGriess
      CFSG.HardMathSupport.Foote.Coordinator.endFoote_holds
      (ComponentClassification.RankTwoAlt.rankTwoAlternatingStandard_of_open
          (ComponentClassification.RankTwoAltFive.altFiveCaseI_of
              (ComponentClassification.RankTwoAlt.altGenerationFive_of
                  ComponentClassification.AS76b.asc08Lemma34
                  ComponentClassification.Asc76X.goldschmidtTheoremA))
          (ComponentClassification.RankTwoAltFive.asc310EpsOne_of
              ComponentClassification.Asc76X.goldschmidtTheoremA)
          ComponentClassification.RankTwoAltFive.asc310IIb
          ComponentClassification.RankTwoAlt.altFiveM12NotTop_of
          ComponentClassification.RankTwoAlt.altEvenCenterSmall
          ComponentClassification.RankTwoAlt.altThreeCover
          (ComponentClassification.RankTwoAlt.altGenerationSmall_of
              ComponentClassification.AS76b.asc08Lemma34
              ComponentClassification.Asc76X.goldschmidtTheoremA)
          ComponentClassification.RankTwoAlt.altRootFusion
          (ComponentClassification.RankTwoAlt.altTypeTwoFusion_of_rootFusion
              ComponentClassification.RankTwoAlt.altRootFusion)
          (ComponentClassification.RankTwoAlt.altTypeTwoCentralizer
              ComponentClassification.Asc76X.goldschmidtTheoremA))
      CFSG.HardMathSupport.RichardWeiss.ExceptionalClosure.stellmacherSixOneThree_holds
  have hSCL : CFSG.CGT.Timmesfeld75.SimpleCaseListStmt :=
    CFSG.CGT.Timmesfeld75.simpleCaseListStmt_final_rest ⟨hA8, CFSG.CGT.M24S.m24SylowInput⟩
  have hL25 : CFSG.EvenSporadicStandard.Finkelstein77.Asc76Lemma25 :=
    CFSG.EvenSporadicStandard.Finkelstein77.Lemma25HProof.asc76Lemma25_of_hallQ8Residual
      CFSG.ComponentClassification.Foote5.HallGen.hallQ8Residual
  have hSolK : CFSG.CGT.PushingUpLit.SolomonAlternatingBlockK :=
    CFSG.RankThree.PartOne.SolIn.solomonAlternatingBlockK_of_inputs hL25 hSCL hSolIn
  have hP55 : CFSG.CGT.PushingUpLit.T2K.Print55 :=
    CFSG.CGT.PushingUpLit.C2L.print55_of_sylowSp4
      CFSG.CGT.PushingUpLit.LIT.Foote.footeNonsolvableSimple_holds
      (CFSG.CGT.PushingUpLit.T2K.solomonTimmesfeldTight_of_solK
        (CFSG.RankThree.PartOne.SolIn.solomonTimmesfeldTight_of_inputs hL25 hSolIn)
        CFSG.CGT.PushingUpLit.SolK.tightSmallGroupOrders)
      hL25 hSCL CFSG.CGT.Timmesfeld75.listWCIdentification_of_cert
      (CFSG.CGT.PushingUpLit.T2K.aschbacher78OneGen_of_threeSNonSylow
        CFSG.CGT.PushingUpLit.A78.threeSNonSylow)
      CFSG.CGT.PushingUpLit.A78G0.a78SylowSp4_holds
  have hT2K : CFSG.CGT.PushingUpLit.T2K.OpenInputsHall := ⟨hL25, hP55⟩
  have hbhs := CFSG.CGT.PushingUpLit.SYMB.bhsLocalCStar_of_restIH
    ⟨CFSG.RankThree.PartOne.KEXC.sl2EvenMultiplierTrivial_holds,
      CFSG.CGT.PushingUpLit.BHS7.pushUpPerfectTwo_holds,
      CFSG.CGT.PushingUpLit.SYMB.threeEightSymmIH_proved⟩
  have hSix4Core := CFSG.CGT.PushingUpLit.CGT6.aschbacherSixFourCore_of_hyps hSCL
    CFSG.CGT.Timmesfeld75.lemma215 CFSG.CGT.Timmesfeld75.listWCIdentification_of_cert
  have hL214 : CFSG.CGT.Timmesfeld75.Lemma214 :=
    CFSG.CGT.Timmesfeld75.lemma214_of_remaining
      { aschbacherTheoremOne := CFSG.Timmesfeld.Bridge.Asc72.theoremOne
        benderCenter := CFSG.CGT.T75N.benderCenterInput
        unitaryTwoGeneration := CFSG.CGT.T75N.unitaryTwoGenerationInput }
  refine ⟨?_, hSolK⟩
  exact CFSG.CGT.PushingUpLit.T2K.aschbacherTheoremTwoK_of_bundle hT2K.toNonSylow.toOpenInputs
    CFSG.CGT.PushingUpLit.LIT.Foote.footeNonsolvableSimple_holds hSolK
    (CFSG.RankThree.PartOne.SolIn.solomonTimmesfeldTight_of_inputs hL25 hSolIn)
    CFSG.CGT.PushingUpLit.SolK.tightSmallGroupOrders
    CFSG.CGT.Timmesfeld75.goldschmidt1974_of_milestone hbhs
    (CFSG.CGT.PushingUpLit.CGT6.aschbacherSixSixteenNormal_of_sixFourNormal
      (CFSG.CGT.PushingUpLit.CGT6.aschbacherSixFourNormal_of_core hSix4Core))
    (CFSG.CGT.PushingUpLit.CGT6.aschbacherSixThreeCoreNat_of_embeddingK hEmb)
    CFSG.CGT.PushingUpLit.T2KR.P53.benderSuzukiStatement_holds hL214
    CFSG.CGT.PushingUpLit.T2KR.szTwoPointTorus hSCL
    CFSG.CGT.Timmesfeld75.listWCIdentification_of_cert

