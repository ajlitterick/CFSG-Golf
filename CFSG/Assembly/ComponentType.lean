theorem kProper_local_B
    (G : Type) [Group G] [Finite G] [IsSimpleGroup G]
    (hnonab : ∃ a b : G, a * b ≠ b * a) (hK : KProper InCatalog G)
    (hcomp : IsComponentType G) : oddCore G = ⊥ ∧ LocalBProperty G :=
  CFSG.Open.CTBKProperLocalBTauCeti.kProper_component_local_B G hnonab hK hcomp

theorem initial_standard_component
    (G : Type) [Group G] [Finite G] [IsSimpleGroup G]
    (hnonab : ∃ a b : G, a * b ≠ b * a) (hK : KProper InCatalog G) (hrank : 3 ≤ twoRank G)
    (hcomp : IsComponentType G) (hB : LocalBProperty G) :
    (∃ t : G, orderOf t = 2 ∧ ∃ L : Subgroup G,
        IsComponentOf L (Subgroup.centralizer ({t} : Set G)) ∧ IsStandardSubgroup L) ∨
      (∃ z : G, orderOf z = 2 ∧ ∃ J : Subgroup G,
        IsComponentOf J (Subgroup.centralizer ({z} : Set G)) ∧ z ∈ J ∧
          ∃ r : ℕ, 3 ≤ r ∧ ∃ S : Sylow 2 J,
            Nonempty ((S : Subgroup J) ≃* QuaternionGroup (2 ^ (r - 2)))) := by
  have hfrontier :=
    CFSG.Open.CTInitialFrontierTauCeti.initial_standard_component_frontier G hnonab hK hrank hcomp
      hB
  simpa only [CFSG.ComponentClassification.AssemblyBPredicates.isComponentOf_iff_open]
    using hfrontier

theorem quaternion_component_recognition
    (G : Type) [Group G] [Finite G] [IsSimpleGroup G]
    (hnonab : ∃ a b : G, a * b ≠ b * a) (hK : KProper InCatalog G)
    (z : G) (hz : orderOf z = 2)
    (J : Subgroup G) (hJ : IsComponentOf J (Subgroup.centralizer ({z} : Set G)))
    (hzJ : z ∈ J) (S : Sylow 2 J)
    (hS : ∃ r : ℕ, 3 ≤ r ∧ Nonempty ((S : Subgroup J) ≃* QuaternionGroup (2 ^ (r - 2)))) :
    OddLieType G ∨ Nonempty (G ≃* M11) :=
  _root_.CFSG.Milestones.ct_quaternion_component_recognition_frontier G hnonab hK z hz J hJ hzJ S hS

theorem standard_recognition
    (G : Type) [Group G] [Finite G] [IsSimpleGroup G]
    (hnonab : ∃ a b : G, a * b ≠ b * a) (hK : KProper InCatalog G)
    (L : Subgroup G) (hL : IsStandardSubgroup L) : InCatalog G :=
  _root_.CFSG.Milestones.ct_standard_recognition_assembly G hnonab hK L hL

theorem classicalModel_inCatalog (X : Type) [Group X]
    (t : ClassicalTag) (n p f : ℕ) [Fact p.Prime] (_hp : p ≠ 2) (h : ClassicalModel X t n p f) :
    InCatalog X :=
  CFSG.ClassicalModels.inCatalog_of_statedClassicalModel X _ n p f
    (CFSG.ComponentClassification.ClassicalModelStatedBridge.statedClassicalModel_of_classicalModel
      t n p f h)

theorem m11_inCatalog (X : Type) [Group X] (h : Nonempty (X ≃* M11)) : InCatalog X := by
  obtain ⟨e⟩ := h
  obtain ⟨b⟩ := CFSG.Sporadic.Bridge.M11.nonempty_mulEquiv
  exact ⟨.sporadic .M11, ⟨e.trans b⟩⟩

theorem oddLieType_inCatalog
    (X : Type) [Group X] (h : OddLieType X) : InCatalog X := by
  rcases h with ⟨t, n, p, f, _, hp, h⟩ | ⟨d, -, -, he⟩
  · exact classicalModel_inCatalog X t n p f hp h
  · exact ⟨.lie d, he⟩

theorem inCatalog_of_models_lieModel {G : Type} [Group G] {t : LowTwoRank.StatedLieTag}
    {n p f : ℕ} (h : Models.LieModel G t n p f) : InCatalog G := by
  obtain ⟨-, hc | ⟨-, d, -, ⟨e⟩⟩⟩ := h
  · exact CFSG.ClassicalModels.inCatalog_of_statedClassicalModel G t n p f hc
  · exact ⟨.lie d, ⟨e⟩⟩

theorem catalog_nonabelian_type_partition_tauCeti (G : Type) [Group G]
    (hnonab : ∃ a b : G, a * b ≠ b * a) :
    InCatalog G ↔
      (∃ n : ℕ, 5 ≤ n ∧ Nonempty (G ≃* alternatingGroup (Fin n))) ∨
        Models.OddLieType G ∨ Models.EvenLieType G ∨ Models.SporadicRep G := by
  constructor
  · rintro ⟨i, ⟨e⟩⟩
    cases i with
    | cyclic p hp =>
      obtain ⟨a, b, hab⟩ := hnonab
      refine absurd (e.injective ?_) hab
      rw [map_mul, map_mul]
      exact mul_comm (G := Multiplicative (ZMod p)) _ _
    | alternating n hn => exact .inl ⟨n, hn, ⟨e⟩⟩
    | lie d =>
      rcases Models.oddLieType_or_evenLieType_of_valid d ⟨e⟩ with h | h
      · exact .inr (.inl h)
      · exact .inr (.inr (.inl h))
    | sporadic s => exact .inr (.inr (.inr ⟨s, ⟨e⟩⟩))
  · rintro (⟨n, hn, ⟨e⟩⟩ | ⟨t, n, p, f, -, hL⟩ | ⟨t, n, f, hL⟩ | ⟨s, ⟨e⟩⟩)
    · exact ⟨.alternating n hn, ⟨e⟩⟩
    · exact inCatalog_of_models_lieModel hL
    · exact inCatalog_of_models_lieModel hL
    · exact ⟨.sporadic s, ⟨e⟩⟩

theorem catalog_nonabelian_type_partition_tauCeti_nativeSporadic
    (G : Type) [Group G] (hnonab : ∃ a b : G, a * b ≠ b * a) :
    InCatalog G ↔
      (∃ n : ℕ, 5 ≤ n ∧ Nonempty (G ≃* alternatingGroup (Fin n))) ∨
        Models.OddLieType G ∨ Models.EvenLieType G ∨ Blueprint.NativeSporadic.SporadicRep G := by
  have hs : Models.SporadicRep G ↔ Blueprint.NativeSporadic.SporadicRep G := by
    constructor
    · rintro ⟨s, ⟨e⟩⟩
      obtain ⟨b⟩ := CFSG.RankThree.PartOne.TCB.nonempty_carrier_mulEquiv_group s
      exact ⟨s, ⟨e.trans b.symm⟩⟩
    · rintro ⟨s, ⟨e⟩⟩
      obtain ⟨b⟩ := CFSG.RankThree.PartOne.TCB.nonempty_carrier_mulEquiv_group s
      exact ⟨s, ⟨e.trans b⟩⟩
  rw [catalog_nonabelian_type_partition_tauCeti G hnonab, hs]

end ComponentType

open ComponentType in
theorem component_type
    (G : Type) [Group G] [Finite G] [IsSimpleGroup G]
    (hnonab : ∃ a b : G, a * b ≠ b * a) (hK : KProper InCatalog G) (hrank : 3 ≤ twoRank G)
    (hcomp : IsComponentType G) : InCatalog G := by
  obtain ⟨-, hB⟩ := kProper_local_B G hnonab hK hcomp
  rcases initial_standard_component G hnonab hK hrank hcomp hB with
    ⟨-, -, L, -, hL⟩ | ⟨z, hz, J, hJ, hzJ, r, hr, S, hS⟩
  · exact standard_recognition G hnonab hK L hL
  · rcases quaternion_component_recognition G hnonab hK z hz J hJ hzJ S ⟨r, hr, hS⟩ with h | h
    · exact oddLieType_inCatalog G h
    · exact m11_inCatalog G h

end CFSG.Assembly
