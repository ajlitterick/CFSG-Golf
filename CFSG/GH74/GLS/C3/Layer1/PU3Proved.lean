variable {G : Type} [Group G] [Finite G]

theorem good_of_localRank {M L K Q : Subgroup G}
    (hLcomp : IsPCompIn 2 M L) (hKL : K ≤ L)
    (hLeq : L = pPrimeCoreOf 2 L ⊔ K)
    (hQ : IsSylowOf 2 Q (CMbar M K)) (hgam : gammaK 2 Q 1 ≤ M)
    {m : G} (hm : m ∈ M) (hne : cj m L ≠ L)
    (hsimple : IsSimpleGroup (kBar L))
    (hnonab : ∃ a b : kBar L, a * b ≠ b * a) :
    Good M L := by
  have hKM : K ≤ M := hKL.trans hLcomp.1
  have hrank : 2 ≤ pRank 2 ↥L := Rows.two_le_pRank_of_kBar hsimple hnonab
  refine ⟨hLcomp, ?_, ?_, hsimple, hnonab, hrank⟩
  · intro R hRL hR2 hR1
    exact Th2.PU3Q.normalizer_le_of_le_L hLcomp (isSubnormalIn_of_comp hLcomp) hLeq hQ hgam
      hm hne hRL hR2 hR1
  · intro s hsM hs2 hsc
    have hsC : s ∈ CMbar M K := Th2.HY.mem_CMbar_of_comm hKM hsM (fun k hk => hsc k (hKL hk))
    have hzC : zpowers s ≤ CMbar M K := Subgroup.zpowers_le.2 hsC
    have hzp : IsPGroup 2 ↥(zpowers s) :=
      IsPGroup.of_card (n := 1) (by rw [Nat.card_zpowers, hs2]; simp)
    have hs1 : s ≠ 1 := by
      intro h
      rw [h, orderOf_one] at hs2
      omega
    have hz1 : zpowers s ≠ ⊥ := fun h => hs1 (Subgroup.zpowers_eq_bot.1 h)
    exact (centralizer_singleton_le_normalizer_zpowers s).trans
      (Th2.PU3Q.normalizer_le_of_le_cmbar hQ hgam hzC hzp hz1)

theorem good_of_hyp
    (hG : C3Hyp G) {x y : G} {K T S M : Subgroup G} {ρ : Th2Row} {B : Subgroup G}
    (h2 : Th2M2 x y K T S M ρ B) (hKM : K ≤ M)
    (hQ : IsSylowOf 2 (T ⊓ CxK x K) (CMbar M K)) {L : Subgroup G}
    (hL : IsMinSubnormalIn K M L) (hLcomp : IsPCompIn 2 M L) (hLeq : L = pPrimeCoreOf 2 L ⊔ K)
    (hgam : gammaK 2 (T ⊓ CxK x K) 1 ≤ M) {m : G} (hm : m ∈ M) (hne : cj m L ≠ L) :
    Good M L := by
  obtain ⟨hsimple, hnonab, -, -⟩ := rows_data hG h2 hKM hL hLcomp hLeq
  exact good_of_localRank hLcomp hL.1 hLeq hQ hgam hm hne hsimple hnonab

theorem cfg_of_hyp
    (hG : C3Hyp G) {x y : G} {K T S M : Subgroup G} {ρ : Th2Row} {B : Subgroup G}
    (h2 : Th2M2 x y K T S M ρ B) (hKM : K ≤ M)
    (hQ : IsSylowOf 2 (T ⊓ CxK x K) (CMbar M K)) {L : Subgroup G}
    (hL : IsMinSubnormalIn K M L) (hLcomp : IsPCompIn 2 M L) (hLeq : L = pPrimeCoreOf 2 L ⊔ K)
    (hgam : gammaK 2 (T ⊓ CxK x K) 1 ≤ M) {m : G} (hm : m ∈ M) (hne : cj m L ≠ L) :
    Cfg M L (cj m L) := by
  obtain ⟨-, -, -, hOut⟩ := rows_data hG h2 hKM hL hLcomp hLeq
  have hg1 : Good M L := good_of_hyp hG h2 hKM hQ hL hLcomp hLeq hgam hm hne
  have hcjM : cj m M = M := C3.Layer1.Thm1.map_conj_eq_self_of_mem hm
  have hg2 : Good M (cj m L) := by
    have := hg1.conj m
    rwa [hcjM] at this
  have hne' : L ≠ cj m L := fun h => hne h.symm
  have hOut₂ : Group.IsSolvable (Outer (kBar (cj m L))) := by
    have := hOut
    exact CFSG.ComponentClassification.OuterAutomorphisms.solvable_of_equiv
      (Th2.Obs.kBarConjEquiv m L)
  exact ⟨h2.maximal, hg1, hg2, hne', fun L' hL' => only_of_good hG.gen4 hg1 hg2 hne' hL',
    ⟨m, hm, rfl⟩, perf_of_good hG.gen4 hg1 hg2 hne' ⟨m, hm, rfl⟩ hOut hOut₂⟩

theorem b_thm2_PU3_II_proved :
    B_thm2_PU3_II := by
  intro G _ _ hG x y K T S M ρ B h2 hKM hQ L hL hLcomp hLeq hgam _ m hm l hl
  by_cases hcen : ∀ u ∈ pPrimeCoreOf 2 L, ∀ v ∈ L, u * v = v * u
  · haveI : IsSimpleGroup G := hG.kproper.1
    exact False.elim (h2.nonterminal
      (Th2.PU3Q.terminal_of_central_core h2.maximal hL hLcomp hLeq hcen hQ hgam
        ⟨h2.std.orderOf_x, h2.std.comp⟩))
  by_contra hml
  have hne : cj m L ≠ L := by
    intro heq
    have : m * l * m⁻¹ ∈ cj m L := ⟨l, hl, by simp [MulAut.conj_apply]⟩
    rw [heq] at this
    exact hml this
  have hcfg := cfg_of_hyp hG h2 hKM hQ hL hLcomp hLeq hgam hm hne
  exact cfg_false hG.kproper.1 hG.kproper.2.1 hcfg
    (fun _ _ hX hcov => covering hcfg hX hcov) (fun _ _ hX hcov => covering hcfg.symm hX hcov)

