theorem prime_ne_three_of_modThree {π : Bool} {p f : ℕ} (hf : 1 ≤ f) (hq : ModThree π (p ^ f)) :
    p ≠ 3 := by
  rintro rfl
  have h0 : 3 ^ f % 3 = 0 := by
    obtain ⟨k, rfl⟩ : ∃ k, f = k + 1 := ⟨f - 1, by omega⟩
    rw [pow_succ, Nat.mul_mod_left]
  cases π
  · change 3 ^ f % 3 = 2 at hq
    omega
  · change 3 ^ f % 3 = 1 at hq
    omega

theorem subHeis148_of_subL3 (h : SubL3Ident148) : SubHeis148 := by
  intro X _ _ P K₀ Q D π p f _ F _ hF hqF φ y₁ y₂ ζ hy₁ hy₂ hy₁3 hy₂3 hζ1 hζ hact hZ hPe hP9 hQ
    hh hK hKs f₁ hf₁ hpf h3
  have hinv := Ronan148B.inv_of_hyp hZ hh
  have hfaith : ∀ σ ∈ P, (∀ k ∈ K₀, σ k = k) → σ = 1 := fun σ hσ h =>
    Ronan148B.eq_one_of_trivial hh hσ h
  have hfix : ∀ σ ∈ P, σ ≠ 1 → ∀ k ∈ K₀, σ k = k → k ^ p = 1 → k = 1 := by
    intro σ hσ hσ1 k _ hk hkp
    obtain ⟨i, j, hij⟩ := hact σ hσ
    have hyZ : y₁ ^ i * y₂ ^ j ∉ zPi π 3 (p ^ f) F := by
      intro hz
      obtain ⟨τ, hτ, hτ1⟩ := Sec4.exists_tau hF hqF
      have hs := Sec4.mem_statedScalars_of_mem_zPi hF hqF hτ hτ1 hz
      have h1 := Sec4.mk_eq_one_iff_mem_statedScalars.mpr hs
      apply hσ1
      ext z
      apply φ.injective
      apply Subtype.ext
      rw [hij z, h1, one_mul, inv_one, mul_one]
      rfl
    have hty := type13_of_heisAct hF hqF hy₁ hy₂ hy₁3 hy₂3 hζ1 hζ hyZ
    exact (fix_solvable_of_type13 hF hqF φ hty hij).2 k (Sec4.mem_autFix.mpr hk) hkp
  exact h X P K₀ p f₁ hf₁ (prime_ne_three_of_modThree hF.one_le hqF) hpf h3 hKs hPe hP9 hinv
    hfaith hfix

