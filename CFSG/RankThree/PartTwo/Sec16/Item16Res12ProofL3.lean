theorem normalizer_le_of_isZ3LThreeTwo (h133 : Item133) {A M : Subgroup G} {a : G}
    (h : Ctx169 G A a M) {n : ℕ} (hn : IsZ3LThreeTwo A a M n)
    (h13 : ∀ D : Subgroup G, D ≤ A ⊓ M → Nat.card D = 3 →
      Subgroup.normalizer ((D ⊔ Subgroup.zpowers a : Subgroup G) : Set G) ⊓
          Subgroup.normalizer (D : Set G) ≤
        Subgroup.normalizer (Subgroup.zpowers a : Set G)) :
    Subgroup.normalizer (A : Set G) ≤ Subgroup.normalizer (Subgroup.zpowers a : Set G) := by
  obtain ⟨-, hiso, ⟨ψ⟩⟩ := hn
  by_contra hWa
  have : Fact (Nat.Prime 2) := ⟨Nat.prime_two⟩
  have haM : a ∉ M := h.toSec15R.hypS.2.2 a h.zpowers_mem_omegaA M h.mem_lA
  obtain ⟨-, ⟨hM12p, hM12z⟩, ⟨hJ2p, hJ2z⟩⟩ := sporadicModels131
  rcases h133 G A a M h.toSec13Data h.hypS_or_hypT with h1 | ⟨-, ⟨e7⟩, -⟩ |
      ⟨hirr, hWB, -⟩ | hP | ⟨⟨e12⟩⟩ | ⟨⟨eJ⟩⟩
  · exact hWa h1
  · obtain ⟨-, -, -, ⟨χ⟩⟩ := facts_of_prod h.toSec13Data isPerfect_center_alt7.1
      isPerfect_center_alt7.2 e7
    exact not_isoLThreePi_a7 2 n (isoLThreePi_of_mulEquiv χ hiso)
  · exfalso
    have h9 : Nat.card (A ⊓ M : Subgroup G) = 9 :=
      card_inf_eq_nine h.toSec13Data (isPerfect_lBar h.toSec13Data) ψ
    have hBh : IsHyperplane A (A ⊓ M) := ⟨inf_le_left, by rw [h.card_eq, h9]⟩
    have haB : a ∉ A ⊓ M := fun h' => haM h'.2
    have hAa : A = Subgroup.zpowers a ⊔ (A ⊓ M) :=
      le_antisymm (le_zpowers_sup_of_not_mem hBh h.mem_A haB)
        (sup_le (Subgroup.zpowers_le.mpr h.mem_A) inf_le_left)
    have hne : A ⊓ M ≠ ⊥ := by
      intro hbot
      rw [hbot, Subgroup.card_bot] at h9
      norm_num at h9
    obtain ⟨⟨b, hb⟩, hb1⟩ := Subgroup.ne_bot_iff_exists_ne_one.mp hne
    have hb1' : b ≠ 1 := fun h1 => hb1 (Subtype.ext h1)
    have hKa : ∀ k ∈ M ⊓ Subgroup.normalizer (A : Set G), k * a = a * k := fun k hk =>
      Subgroup.mem_centralizer_singleton_iff.mp (h.le_centralizer (Subgroup.mem_inf.mp hk).1)
    obtain ⟨w, hwA, hwT, hwa⟩ := exists_transv_of_irreducible h.isElemAbelian h.mem_A hAa h9
      hKa hirr inf_le_right (inf_normalizer_le_normalizer_inf A M) hWB hWa hb
    have hwb : w * b * w⁻¹ = b := congrArg Subtype.val (hwT.1 ⟨b, hb.1⟩ hb)
    have hD3 : Nat.card (Subgroup.zpowers b) = 3 :=
      card_zpowers_eq_three (h.isElemAbelian.2 b hb.1) hb1'
    have hDw : (Subgroup.zpowers b).map (MulAut.conj w).toMonoidHom = Subgroup.zpowers b := by
      rw [MonoidHom.map_zpowers]
      change Subgroup.zpowers (w * b * w⁻¹) = _
      rw [hwb]
    have haw : (Subgroup.zpowers a).map (MulAut.conj w).toMonoidHom =
        Subgroup.zpowers (a * b) := by
      rw [MonoidHom.map_zpowers]
      change Subgroup.zpowers (w * a * w⁻¹) = _
      rw [hwa]
    have hab : Subgroup.zpowers b ⊔ Subgroup.zpowers (a * b) =
        Subgroup.zpowers b ⊔ Subgroup.zpowers a := by
      apply le_antisymm
      · refine sup_le le_sup_left (Subgroup.zpowers_le.mpr (Subgroup.mul_mem _
          ((le_sup_right : Subgroup.zpowers a ≤ _) (Subgroup.mem_zpowers a))
          ((le_sup_left : Subgroup.zpowers b ≤ _) (Subgroup.mem_zpowers b))))
      · refine sup_le le_sup_left (Subgroup.zpowers_le.mpr ?_)
        have hmem : (a * b) * b⁻¹ ∈ Subgroup.zpowers b ⊔ Subgroup.zpowers (a * b) :=
          Subgroup.mul_mem _
            ((le_sup_right : Subgroup.zpowers (a * b) ≤ _) (Subgroup.mem_zpowers _))
            (Subgroup.inv_mem _ ((le_sup_left : Subgroup.zpowers b ≤ _) (Subgroup.mem_zpowers b)))
        rwa [mul_inv_cancel_right] at hmem
    have hwU : w ∈ Subgroup.normalizer
        ((Subgroup.zpowers b ⊔ Subgroup.zpowers a : Subgroup G) : Set G) ⊓
        Subgroup.normalizer (Subgroup.zpowers b : Set G) := by
      refine Subgroup.mem_inf.mpr ⟨Subgroup.mem_normalizer_iff_map_conj_eq.mpr ?_,
        Subgroup.mem_normalizer_iff_map_conj_eq.mpr hDw⟩
      have h := congrArg₂ (· ⊔ ·) hDw haw
      rw [← Subgroup.map_sup] at h
      exact h.trans hab
    have hwH := h13 (Subgroup.zpowers b) (Subgroup.zpowers_le.mpr hb) hD3 hwU
    have habm : a * b ∈ Subgroup.zpowers a := by
      rw [← hwa]
      exact (Subgroup.mem_normalizer_iff.mp hwH a).mp (Subgroup.mem_zpowers a)
    have hba : b ∈ Subgroup.zpowers a := by
      have : b = a⁻¹ * (a * b) := by group
      rw [this]
      exact Subgroup.mul_mem _ (Subgroup.inv_mem _ (Subgroup.mem_zpowers a)) habm
    have hzb := zpowers_eq_of_mem_of_ne_one h.card_zpowers hba hb1'
    exact haM ((Subgroup.zpowers_le.mpr hb.2) (hzb ▸ Subgroup.mem_zpowers a))
  · exact false_of_pgl_of_prod kSPGLProper h.toSec13Data hP ψ
  · exfalso
    obtain ⟨-, -, -, ⟨χ⟩⟩ := facts_of_prod h.toSec13Data hM12p hM12z e12
    exact KFacts.KS14.not_isoLThreePi_M12 2 n (isoLThreePi_of_mulEquiv χ hiso)
  · exfalso
    obtain ⟨-, -, -, ⟨χ⟩⟩ := facts_of_prod h.toSec13Data hJ2p hJ2z eJ
    exact KFacts.KS14.ks17J2NotList.1 2 n (isoLThreePi_of_mulEquiv χ hiso)

end EvenAt

