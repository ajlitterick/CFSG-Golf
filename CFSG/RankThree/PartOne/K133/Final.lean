theorem kf133ResMaxAt_leaf2_all (hTypes : ∀ r, 9 ≤ r → r ≤ 12 → KF132Types r) :
    ∀ i, KF133ResMaxAt (leaf2 i) := by
  intro i
  fin_cases i
  · exact kf133ResMaxAt_leaf2_zero hTypes
  · exact kf133ResMaxAt_leaf2_one hTypes

section Leaf4

theorem kf133ResMaxAt_leaf4_all (hTypes : ∀ r, 9 ≤ r → r ≤ 12 → KF132Types r) :
