section Main

theorem kf133ResMax_holds (hThm3 : KF133Thm3) (hTypes : ∀ r, 9 ≤ r → r ≤ 12 → KF132Types r) :
    KF133ResMax :=
  kf133ResMax_of_leaves hThm3 (kf133ResMaxItem_zero hTypes) (kf133ResMaxAt_leaf2_all hTypes)
    kf133ResMaxItem_two (kf133ResMaxAt_leaf4_all hTypes) kf133ResMaxItem_four
    (kf133ResMaxAt_leaf6_all hTypes) (kf133ResMaxAt_leaf7_all hTypes) (kf133ResMaxAt_leaf8_all hTypes)
    kf133ResMaxAt_leaf9

theorem kf133Two_holds (hS : SchreierFor InCatalog) (hThm3 : KF133Thm3)
    (hTypes : ∀ r, 1 ≤ r → r ≤ 12 → r ≠ 8 → KF132Types r) (hLift : KFLiftAll) : KF133Two :=
  kf133Two_of_parts hS (fun r h1 h7 => hTypes r h1 (by omega) (by omega))
    (kf133TwoNe_of_resMax hS (fun r h9 h12 => hTypes r (by omega) h12 (by omega)) hLift
      (kf133ResMax_holds hThm3 (fun r h9 h12 => hTypes r (by omega) h12 (by omega))))

end Main

