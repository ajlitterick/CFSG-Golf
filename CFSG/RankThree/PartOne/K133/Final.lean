section Leaf6

theorem kf133ResMaxAt_leaf6_all (hTypes : ∀ r, 9 ≤ r → r ≤ 12 → KF132Types r) :
    ∀ s ∈ Census3.sporadicsThm3, KF133ResMaxAt (leaf6 s) := by
  intro s hs
  by_cases hLy : s = .Ly
  · subst hLy
    exact kf133ResMaxAt_leaf6_ly hTypes
  by_cases hHN : s = .HN
  · subst hHN
    exact K133Spor.kf133ResMaxAt_leaf6_hn_proved hTypes
  exact kf133ResMaxAt_leaf6_ne (CTP.sporadicOuterNoLargePrime_of_leTwo
      SPOR.sporadicOuterOrderLeTwoSimple_holds) hs hLy hHN

end Leaf6

