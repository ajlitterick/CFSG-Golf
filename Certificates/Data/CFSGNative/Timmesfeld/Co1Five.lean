@[expose] def orbMat (b1 b2 : Rows) (t : Nat) : Rows := mul (pow b1 (t / 5)) (pow b2 (t % 5))

@[expose] def orbMatsT (b1 b2 : Rows) : Array Rows :=
  Array.ofFn (n := 25) fun t => transposeRows 24 (orbMat b1 b2 t.val)

@[expose] def orbImg (omT : Array Rows) (w : Nat) : Array Nat := omT.map fun m => vecMulN 24 m w

@[expose] def slotVal (imgs : Nat → Array Nat) (s : Nat × Nat) : Nat := (imgs s.1)[s.2]!

@[expose, inline] def xorMaskV (v : Nat × Nat → Nat) (slots : List (Nat × Nat)) (mask : List Nat) :
    Nat :=
  mask.foldl (fun acc m => acc ^^^ v (slots.getD m (0, 0))) 0

structure Plan where
  slots : List (Nat × Nat)
  rels : List (Nat × Nat × List Nat)
  mems : List (List Nat)
deriving Inhabited

@[expose, inline] def planOKv (xs : Std.HashSet Nat) (v : Nat × Nat → Nat) (P : Plan) : Bool :=
  P.rels.all (fun r => v (r.1, r.2.1) == xorMaskV v P.slots r.2.2) &&
    P.mems.all (fun m => xs.contains (xorMaskV v P.slots m))

@[expose, inline] def planOK (xs : Std.HashSet Nat) (imgs : Nat → Array Nat) (P : Plan) : Bool :=
  planOKv xs (slotVal imgs) P

@[expose] def tupImgs (tup : List (Array Nat)) (i : Nat) : Array Nat := tup.getD i #[]

@[expose] def candList (xs : Std.HashSet Nat) (oi : List (Array Nat)) (P : Plan) :
    List (Array Nat) :=
  oi.filter fun a => planOK xs (fun _ => a) P

@[expose] def stageStep (xs : Std.HashSet Nat) (P : Plan) (cands : List (Array Nat))
    (pres : List (List (Array Nat))) : List (List (Array Nat)) :=
  pres.flatMap fun pre => cands.filterMap fun a =>
    if planOK xs (tupImgs (pre ++ [a])) P then some (pre ++ [a]) else none

@[expose] def stagesAux (xs : Std.HashSet Nat) :
    List Plan → List (List (Array Nat)) → List (List (Array Nat)) → List (List (Array Nat))
  | P :: Ps, c :: cs, pres => stagesAux xs Ps cs (stageStep xs P c pres)
  | _, _, pres => pres

@[expose] def stages (xs : Std.HashSet Nat) (oi : List (Array Nat)) (owns joint : List Plan) :
    List (List (Array Nat)) :=
  stagesAux xs joint (owns.map (candList xs oi)) [[]]

@[expose] def colsToRows (cols : List Nat) : Rows :=
  Array.ofFn (n := 24) fun r => ofBits 24 fun m => (cols.getD m 0).testBit r.val

@[expose] def slotCols (slots : List (Nat × Nat)) (tup : List (Array Nat)) : List Nat :=
  slots.map (slotVal (tupImgs tup))

@[expose] def phiRows (slots : List (Nat × Nat)) (uinv : Rows) (tup : List (Array Nat)) : Rows :=
  mul (colsToRows (slotCols slots tup)) uinv

structure Leaf where
  us : List Nat
  own : List Plan
  joint : List Plan
  slots : List (Nat × Nat)
  uinv : Rows
  N : Nat
deriving Inhabited

@[expose] def commCount (S : List Rows) (w : Rows) : Nat := S.countP fun y => mul y w == mul w y

@[expose] def divisors2 (r : Nat) : List Nat :=
  (List.range (r + 1)).filter fun q => 2 ≤ q && r % q == 0

@[expose] def classOK (S : List Rows) (r : Nat) : Bool :=
  S.all fun w => w == one () || !((divisors2 r).any fun q => pow w q == one ()) ||
    commCount S w * r < S.length

@[expose] def xsOf (X : Array Nat) : Std.HashSet Nat := Std.HashSet.ofList X.toList

@[expose] def finalsOf (X : Array Nat) (b1 b2 : Rows) (L : Leaf) : List (List (Array Nat)) :=
  stages (xsOf X) (X.toList.map (orbImg (orbMatsT b1 b2))) L.own L.joint

@[expose] def solsOf (X : Array Nat) (b1 b2 : Rows) (L : Leaf) : List Rows :=
  (finalsOf X b1 b2 L).map (phiRows L.slots L.uinv)

@[expose] def uIOf (b1 b2 : Rows) (L : Leaf) : List (Array Nat) :=
  L.us.map (orbImg (orbMatsT b1 b2))

@[expose] def gensOK (b1 b2 : Rows) (gens : List Rows) (N : Nat) : Bool :=
  gens.all (fun g => validRows g && mul g b1 == mul b1 g && mul g b2 == mul b2 g) &&
    gtOK gens.toArray (gtBFS gens.toArray 100000) &&
    (gtBFS gens.toArray 100000).pts.size == N

@[expose] def leafOK (X : Array Nat) (b1 b2 : Rows) (gens : List Rows) (L : Leaf) (r : Nat) :
    Bool :=
  validRows b1 && validRows b2 && validRows L.uinv && L.us.all (fun u => (xsOf X).contains u) &&
    decide (L.own.length = L.us.length) && decide (L.joint.length = L.us.length) &&
    (List.range L.us.length).all
      (fun j => planOK (xsOf X) (fun _ => orbImg (orbMatsT b1 b2) (L.us.getD j 0))
        (L.own.getD j default)) &&
    (List.range L.us.length).all
      (fun j => planOK (xsOf X) (tupImgs ((uIOf b1 b2 L).take (j + 1)))
        (L.joint.getD j default)) &&
    mul (colsToRows (slotCols L.slots (uIOf b1 b2 L))) L.uinv == one () &&
    decide ((finalsOf X b1 b2 L).length = L.N) && decide (L.N = 125 * r) &&
    classOK (solsOf X b1 b2 L) r && gensOK b1 b2 gens L.N


