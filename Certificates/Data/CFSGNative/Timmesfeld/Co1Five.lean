@[expose] def rowAt (rs : List Rows) (k : Nat) : Rows := rs.getD k (one ())

@[expose] def digitsOf (k : Nat) : Nat × Nat × Nat := (k % 5, (k / 5) % 5, k / 25)

@[expose] def a0Row (rs : List Rows) (k : Nat) : Rows :=
  mul (pow (rowAt rs (idxD.getD 0 0)) (k % 5))
    (mul (pow (rowAt rs (idxD.getD 1 0)) ((k / 5) % 5)) (pow (rowAt rs (idxD.getD 2 0)) (k / 25)))

@[expose] def qGens (rs : List Rows) : List Rows := idxQ.map (rowAt rs)

@[expose] def qTree (rs : List Rows) : GTree := gtBFS (qGens rs).toArray 100000

@[expose] def qOK (rs : List Rows) : Bool :=
  gtOK (qGens rs).toArray (qTree rs) && (qTree rs).pts.size == 625 &&
    (qTree rs).pts.all fun x => pow x 5 == one ()

@[expose] def a0OK (rs : List Rows) : Bool :=
  (List.range 3).all (fun i => validRows (rowAt rs (idxD.getD i 0)) &&
      pow (rowAt rs (idxD.getD i 0)) 5 == one () &&
      (List.range 3).all fun j => mul (rowAt rs (idxD.getD i 0)) (rowAt rs (idxD.getD j 0)) ==
        mul (rowAt rs (idxD.getD j 0)) (rowAt rs (idxD.getD i 0))) &&
    distinctKeys ((List.range 125).map fun k => rowsKey (a0Row rs k))

@[expose] def conjList (rs : List Rows) (j : Nat) : List Rows :=
  (qTree rs).pts.toList.map fun y => mul (mul y (rowAt rs (idxR.getD j 0))) (pow y 4)

@[expose] def fusOK (rs : List Rows) : Bool :=
  let a0set : Std.HashSet Rows := Std.HashSet.ofList ((List.range 125).map (a0Row rs))
  let cset : Std.HashSet Rows :=
    Std.HashSet.ofList ((List.range 20).flatMap (conjList rs))
  (qTree rs).pts.all (fun q => a0set.contains q || cset.contains q) &&
    (List.range 20).all fun j =>
      mul (rowAt rs (idxC.getD j 0)) (inv (rowAt rs (idxC.getD j 0))) == one () &&
        a0set.contains (mul (mul (rowAt rs (idxC.getD j 0)) (rowAt rs (idxR.getD j 0)))
          (inv (rowAt rs (idxC.getD j 0))))

@[expose] def dot5 (f : List Nat) (a : Nat × Nat × Nat) : Nat :=
  (f.getD 0 0 * a.1 + f.getD 1 0 * a.2.1 + f.getD 2 0 * a.2.2) % 5

@[expose] def scale5 (k : Nat) (a : Nat × Nat × Nat) : Nat × Nat × Nat :=
  (k * a.1 % 5, k * a.2.1 % 5, k * a.2.2 % 5)

@[expose] def planeOK (rs : List Rows) : Bool :=
  (List.range 31).all (fun p =>
    let f := planeF.getD p []
    let τ := planeT.getD p 0
    let c := rowAt rs (idxPC.getD p 0)
    let ci := inv c
    let α := planeA.getD p 0
    let β := planeB.getD p 0
    decide (τ < 3) && decide (α < 125) && decide (β < 125) &&
      dot5 f (digitsOf α) == 0 && dot5 f (digitsOf β) == 0 &&
      (List.range 5).all (fun k => digitsOf β != scale5 k (digitsOf α)) &&
      mul c ci == one () &&
      mul (mul c (a0Row rs (repA.getD τ 0))) ci == a0Row rs α &&
      mul (mul c (a0Row rs (repB.getD τ 0))) ci == a0Row rs β) &&
  ((List.range 125).all fun k => k == 0 ||
    (List.range 31).any fun p => (List.range 5).any fun c =>
      decide (1 ≤ c) && (digitsOf k == scale5 c (planeF.getD p [] |>.getD 0 0,
        planeF.getD p [] |>.getD 1 0, planeF.getD p [] |>.getD 2 0))) &&
  (List.range 3).all fun τ =>
    decide (repA.getD τ 0 < 125) && decide (repB.getD τ 0 < 125) &&
      (let G := [a0Row rs (repA.getD τ 0), a0Row rs (repB.getD τ 0)].toArray
       gtOK G (gtBFS G 100000) && (gtBFS G 100000).pts.size == 25)

@[expose] def leafR : List Nat := [1, 12, 2]


@[expose] def globalOK (aR bR : Rows) : Bool :=
  let dg := gDag aR bR
  dg.2.2 && qOK dg.1 && a0OK dg.1 && fusOK dg.1 && planeOK dg.1


end Timmesfeld.Co1Five
