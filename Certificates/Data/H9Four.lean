open scoped Matrix

abbrev Mat : Type := Vector (Vector (ZMod 2) 4) 4

@[expose] def Mat.toMatrix (v : Mat) : Matrix (Fin 4) (Fin 4) (ZMod 2) :=
  Matrix.of fun i j => v[i][j]

@[expose] def Mat.ofMatrix (M : Matrix (Fin 4) (Fin 4) (ZMod 2)) : Mat :=
  Vector.ofFn fun i => Vector.ofFn fun j => M i j

@[expose] def Mat.ofCode (k : Nat) : Mat :=
  Vector.ofFn fun i => Vector.ofFn fun j => if k.testBit (4 * i.val + j.val) then 1 else 0

@[expose] def Mat.mul (v w : Mat) : Mat := Mat.ofMatrix (v.toMatrix * w.toMatrix)

@[expose] def Mat.tr (v : Mat) : Mat := Mat.ofMatrix v.toMatrixᵀ

@[expose] def Mat.one : Mat := Mat.ofMatrix 1

@[expose] def Mat.app (v : Mat) (x : Multiplicative (Fin 4 → ZMod 2)) :
    Multiplicative (Fin 4 → ZMod 2) :=
  Multiplicative.ofAdd (v.toMatrix *ᵥ Multiplicative.toAdd x)

@[expose] def Pt : Type := Multiplicative (Fin 4 → ZMod 2) × Multiplicative (Fin 4 → ZMod 2)

instance : CommGroup Pt :=
  inferInstanceAs (CommGroup (Multiplicative (Fin 4 → ZMod 2) × Multiplicative (Fin 4 → ZMod 2)))

instance : Fintype Pt :=
  inferInstanceAs (Fintype (Multiplicative (Fin 4 → ZMod 2) × Multiplicative (Fin 4 → ZMod 2)))

instance : DecidableEq Pt :=
  inferInstanceAs (DecidableEq (Multiplicative (Fin 4 → ZMod 2) × Multiplicative (Fin 4 → ZMod 2)))

structure Elt where
  a : Mat
  ai : Mat
  b : Bool
  deriving DecidableEq

@[expose] def Elt.ofCodes (p : Nat × Nat × Bool) : Elt := ⟨Mat.ofCode p.1, Mat.ofCode p.2.1, p.2.2⟩

@[expose] def Elt.one : Elt := ⟨Mat.one, Mat.one, false⟩

@[expose] def Elt.mul (e f : Elt) : Elt :=
  ⟨Mat.mul e.a (if e.b then Mat.tr f.ai else f.a),
    Mat.mul (if e.b then Mat.tr f.a else f.ai) e.ai, xor e.b f.b⟩

@[expose] def Elt.inv (e : Elt) : Elt :=
  if e.b then ⟨Mat.tr e.a, Mat.tr e.ai, true⟩ else ⟨e.ai, e.a, false⟩

@[expose] def Elt.act (e : Elt) (w : Pt) : Pt :=
  if e.b then (e.a.app w.2, (Mat.tr e.ai).app w.1) else (e.a.app w.1, (Mat.tr e.ai).app w.2)

@[expose] def Elt.valid (e : Elt) : Bool :=
  decide (e.a.toMatrix * e.ai.toMatrix = 1) && decide (e.ai.toMatrix * e.a.toMatrix = 1)

@[expose] def ptOfCode (k : Nat) : Pt :=
  (Multiplicative.ofAdd fun i => if k.testBit i.val then 1 else 0,
    Multiplicative.ofAdd fun i => if k.testBit (4 + i.val) then 1 else 0)

@[expose] def allPts : List Pt := (List.range 256).map ptOfCode

@[expose] def elems : List Elt → List Elt
  | [] => [Elt.one]
  | g :: gs => let E := elems gs; E ++ E.map (Elt.mul g)

@[expose] def spanList : List Pt → List Pt
  | [] => [1]
  | s :: ss => let T := spanList ss; if T.contains s then T else T ++ T.map (· * s)

@[expose] def fixPts (gs : List Elt) : List Pt :=
  allPts.filter fun w => gs.all fun g => g.act w == w

@[expose] def fixPts₁ (gs : List Elt) : List Pt := (fixPts gs).filter fun w => w.2 == 1

@[expose] def fixPts₂ (gs : List Elt) : List Pt := (fixPts gs).filter fun w => w.1 == 1

@[expose] def commPts (E : List Elt) : List Pt :=
  E.flatMap fun e => allPts.map fun w => e.act w * w⁻¹

@[expose] def gam2Pts (E : List Elt) : List Pt :=
  E.flatMap fun a => E.flatMap fun b =>
    if a != Elt.one && b != Elt.one && a != b then fixPts [a, b] else []

@[expose] def gam3Pts (E : List Elt) : List Pt :=
  E.flatMap fun a => if a != Elt.one then fixPts [a] else []


@[expose] def commutes (x g : Elt) : Bool := x.mul g == g.mul x

