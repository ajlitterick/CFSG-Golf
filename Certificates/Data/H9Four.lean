@[expose] def invAll : List Elt :=
  invLCodes.map (fun k => ⟨Mat.ofCode k, Mat.ofCode k, false⟩) ++
    invSCodes.map fun p => ⟨Mat.ofCode p.1, Mat.ofCode p.2, true⟩

@[expose] def reps : List (List Elt) := repCodes.map (·.map Elt.ofCodes)

@[expose] def checkInv : Bool :=
  invAll.all fun x => x.valid && x.mul x == Elt.one && x != Elt.one

@[expose] def repCheck : Bool :=
  reps.all fun gs => gs.all (fun g => g.valid && g.mul g == Elt.one && g != Elt.one) &&
    gs.all (fun g => gs.all (commutes g)) && decide (elems gs).Nodup


@[expose] def inL (gs : List Elt) : Bool := gs.all fun g => !g.b

@[expose] def rankCheck : Bool := reps.all fun gs => (elems gs).length ≤ 16


@[expose] def commCheck : Bool :=
  reps.all fun gs => decide ((elems gs).length < 4) ||
    decide (8 ≤ (spanList (commPts (elems gs))).length)

@[expose] def centCheck : Bool :=
  reps.all fun gs => decide ((elems gs).length < 4) || decide (4 * (fixPts gs).length < 256)

@[expose] def constFix (E : List Elt) : Bool :=
  E.all fun e => E.all fun f => e == Elt.one || f == Elt.one ||
    (fixPts₁ [e] == fixPts₁ [f] && fixPts₂ [e] == fixPts₂ [f])

@[expose] def axesCheck : Bool :=
  reps.all fun gs => !inL gs || decide ((elems gs).length < 4) || !constFix (elems gs) ||
    ((elems gs).length == 4 && (elems gs).all fun e => e == Elt.one ||
      ((fixPts₁ [e]).length == 4 && (fixPts₂ [e]).length == 4))

@[expose] def e16Check : Bool :=
  let E0 := elems (reps.getD 28 [])
  let E1 := elems (reps.getD 26 [])
  let E2 := elems (reps.getD 27 [])
  let S2 := spanList (gam2Pts E2)
  (fixPts (reps.getD 28 [])).length == 16 && (spanList (gam2Pts E0)).length == 256 &&
    (fixPts (reps.getD 26 [])).length == 2 && (spanList (gam2Pts E1)).length == 64 &&
    (fixPts (reps.getD 27 [])).length == 4 && S2.length == 64 &&
    E2.all (fun e => e == Elt.one || S2.any fun w => e.act w != w) &&
    [E1, E2].all fun E => E.any (fun e => !e.b && (fixPts₁ [e]).length == 8) &&
      E.any (fun e => !e.b && e != Elt.one && (fixPts₁ [e]).length != 8) &&
      decide (128 ≤ (spanList (gam3Pts E)).length)

